{
  "watch": [
    "routes",
    "middleware",
    "db",
    "services",
    "utils",
    "config",
    "app.js",
    "views"
  ],
  "ext": "js,json,ejs",
  "ignore": [
    "node_modules",
    "data/*",
    "*.sqlite3",
    "*.db",
    "logs/*",
    "public/uploads/*",
    "*.log",
    ".git",
    "coverage",
    "dist",
    "build"
  ],
  "delay": 500,
  "verbose": true,
  "env": {
    "NODE_ENV": "development"
  }
}
