<%- include('partials/header') %>

<section class="business-page">
    <div class="page-header">
        <div class="page-header-content">
            <div class="breadcrumb">
                <a href="/business">Dashboard</a>
                <span class="separator">→</span>
                <span class="current">Team Management</span>
            </div>
            <div class="header-row">
                <div>
                    <h1 class="page-title">
                        <span class="title-icon">👥</span>
                        Business Admin Team
                    </h1>
                    <p class="page-subtitle">Manage business admin team members and their permissions.</p>
                </div>
                <% if (hasPermission('business_team_manage')) { %>
                <button onclick="openAddMemberModal()" class="add-btn">
                    <span class="btn-icon">➕</span> Add Team Member
                </button>
                <% } %>
            </div>
        </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="team-container">
        <% if (parentAdmin) { %>
        <div class="parent-notice">
            <span class="notice-icon">ℹ️</span>
            <span>You are a subordinate business admin under <strong><%= parentAdmin.parent_name %></strong> (<%= parentAdmin.parent_email %>)</span>
        </div>
        <% } %>

        <!-- Team Members List -->
        <div class="team-section">
            <h2 class="section-title">Your Team Members</h2>
            
            <% if (teamMembers && teamMembers.length > 0) { %>
            <div class="team-grid">
                <% teamMembers.forEach(function(member) { %>
                <div class="team-card">
                    <div class="member-header">
                        <div class="member-avatar">
                            <% if (member.profile_picture) { %>
                            <img src="/uploads/<%= member.profile_picture %>" alt="<%= member.full_name %>">
                            <% } else { %>
                            <span class="avatar-initial"><%= member.full_name.charAt(0) %></span>
                            <% } %>
                        </div>
                        <div class="member-info">
                            <div class="member-name"><%= member.full_name %></div>
                            <div class="member-email"><%= member.email %></div>
                        </div>
                        <span class="member-badge status-<%= member.status %>"><%= member.status %></span>
                    </div>
                    
                    <div class="member-permissions">
                        <h4>Permissions</h4>
                        <div class="permissions-list">
                            <% 
                            const memberPerms = member.permissions ? JSON.parse(member.permissions) : [];
                            BUSINESS_ADMIN_PERMISSION_DEFINITIONS.forEach(function(perm) { 
                                const hasThisPerm = memberPerms.includes(perm.key);
                            %>
                            <span class="perm-chip <%= hasThisPerm ? 'granted' : 'denied' %>">
                                <%= hasThisPerm ? '✓' : '✗' %> <%= perm.label %>
                            </span>
                            <% }); %>
                        </div>
                    </div>
                    
                    <div class="member-meta">
                        <span>Added: <%= new Date(member.created_at).toLocaleDateString() %></span>
                    </div>
                    
                    <% if (hasPermission('business_team_manage')) { %>
                    <div class="member-actions">
                        <button onclick="openEditPermissionsModal(<%= member.id %>, '<%= member.full_name %>', <%= JSON.stringify(memberPerms) %>)" class="action-btn edit">
                            Edit Permissions
                        </button>
                        <button onclick="revokeMember(<%= member.id %>, '<%= member.full_name %>')" class="action-btn revoke">
                            Revoke Access
                        </button>
                    </div>
                    <% } %>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <div class="empty-state">
                <div class="empty-icon">👥</div>
                <h3>No team members yet</h3>
                <p>Add business admin team members to help manage enterprise sales inquiries.</p>
                <% if (hasPermission('business_team_manage')) { %>
                <button onclick="openAddMemberModal()" class="add-first-btn">+ Add First Team Member</button>
                <% } %>
            </div>
            <% } %>
        </div>

        <!-- All Business Admins Overview -->
        <div class="team-section">
            <h2 class="section-title">All Business Admins</h2>
            <div class="admins-table-container">
                <table class="admins-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Subordinates</th>
                            <th>Joined</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% allBusinessAdmins.forEach(function(admin) { %>
                        <tr>
                            <td>
                                <div class="admin-cell">
                                    <div class="admin-avatar">
                                        <% if (admin.profile_picture) { %>
                                        <img src="/uploads/<%= admin.profile_picture %>" alt="<%= admin.full_name %>">
                                        <% } else { %>
                                        <span><%= admin.full_name.charAt(0) %></span>
                                        <% } %>
                                    </div>
                                    <span><%= admin.full_name %></span>
                                </div>
                            </td>
                            <td><%= admin.email %></td>
                            <td><span class="subordinate-count"><%= admin.subordinate_count || 0 %></span></td>
                            <td><%= new Date(admin.created_at).toLocaleDateString() %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- Add Member Modal -->
<div id="addMemberModal" class="modal">
    <div class="modal-overlay" onclick="closeAddMemberModal()"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h2>Add Team Member</h2>
            <button onclick="closeAddMemberModal()" class="modal-close">&times;</button>
        </div>
        <form id="addMemberForm" class="modal-form">
            <div class="form-group">
                <label>Search User</label>
                <input type="text" id="userSearch" placeholder="Search by name or email..." oninput="searchUsers(this.value)">
                <div id="userSearchResults" class="search-results"></div>
                <input type="hidden" id="selectedUserId" name="userId">
            </div>
            
            <div class="form-group" id="selectedUserDisplay" style="display: none;">
                <label>Selected User</label>
                <div class="selected-user">
                    <span id="selectedUserName"></span>
                    <button type="button" onclick="clearSelectedUser()" class="clear-btn">&times;</button>
                </div>
            </div>
            
            <div class="form-group">
                <label>Permissions</label>
                <p class="form-help">Select the permissions to grant to this team member.</p>
                <div class="permissions-selector">
                    <% BUSINESS_ADMIN_PERMISSION_DEFINITIONS.forEach(function(perm) { %>
                    <label class="permission-checkbox">
                        <input type="checkbox" name="permissions" value="<%= perm.key %>">
                        <span class="checkbox-custom"></span>
                        <span class="permission-info">
                            <span class="permission-name"><%= perm.label %></span>
                            <span class="permission-desc"><%= perm.desc %></span>
                        </span>
                    </label>
                    <% }); %>
                </div>
            </div>
            
            <div class="form-group">
                <label>Notes (Optional)</label>
                <textarea name="notes" rows="2" placeholder="Any notes about this team member..."></textarea>
            </div>
            
            <div class="modal-actions">
                <button type="button" onclick="closeAddMemberModal()" class="cancel-btn">Cancel</button>
                <button type="submit" class="submit-btn" id="addMemberSubmit" disabled>Add Team Member</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Permissions Modal -->
<div id="editPermissionsModal" class="modal">
    <div class="modal-overlay" onclick="closeEditPermissionsModal()"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h2>Edit Permissions</h2>
            <button onclick="closeEditPermissionsModal()" class="modal-close">&times;</button>
        </div>
        <form id="editPermissionsForm" class="modal-form">
            <input type="hidden" id="editAssignmentId" name="assignmentId">
            
            <div class="form-group">
                <label>Team Member</label>
                <div class="static-field" id="editMemberName"></div>
            </div>
            
            <div class="form-group">
                <label>Permissions</label>
                <div class="permissions-selector" id="editPermissionsSelector">
                    <% BUSINESS_ADMIN_PERMISSION_DEFINITIONS.forEach(function(perm) { %>
                    <label class="permission-checkbox">
                        <input type="checkbox" name="permissions" value="<%= perm.key %>" id="edit_perm_<%= perm.key %>">
                        <span class="checkbox-custom"></span>
                        <span class="permission-info">
                            <span class="permission-name"><%= perm.label %></span>
                            <span class="permission-desc"><%= perm.desc %></span>
                        </span>
                    </label>
                    <% }); %>
                </div>
            </div>
            
            <div class="modal-actions">
                <button type="button" onclick="closeEditPermissionsModal()" class="cancel-btn">Cancel</button>
                <button type="submit" class="submit-btn">Save Changes</button>
            </div>
        </form>
    </div>
</div>

