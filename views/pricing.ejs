<%- include('partials/header') %>

<!-- Pricing Hero Section -->
<section class="pricing-hero">
    <div class="container">
        <h1 class="pricing-title">Choose Your Dream X Plan</h1>
        <p class="pricing-subtitle">From creators to communities — we've got a tier for every ambition.</p>
    </div>
</section>

<!-- Pricing Cards Section -->
<section class="pricing-section">
    <div class="container">
        <div class="pricing-grid">
            <% tiers.forEach(function(tier) { %>
                <div class="pricing-card <%= tier.highlight ? 'pricing-card-highlight' : '' %>">
                    <% if (tier.highlight) { %>
                        <div class="pricing-badge">Most Popular</div>
                    <% } %>
                    <div class="pricing-card-header">
                        <h3 class="pricing-card-name"><%= tier.name %></h3>
                        <p class="pricing-card-tagline"><%= tier.tagline %></p>
                        <div class="pricing-card-price"><%= tier.price %></div>
                    </div>
                    <div class="pricing-card-body">
                        <ul class="pricing-features">
                            <% tier.features.forEach(function(feature) { %>
                                <li><span class="feature-icon">✓</span> <%= feature %></li>
                            <% }); %>
                        </ul>
                    </div>
                    <div class="pricing-card-footer">
                        <% if (tier.id === 'enterprise') { %>
                            <button onclick="openContactSalesModal()" class="pricing-btn pricing-btn-enterprise">
                                <span class="btn-icon">🏢</span> Contact Sales
                            </button>
                        <% } else if (typeof userTier !== 'undefined' && userTier === tier.id) { %>
                            <button class="pricing-btn pricing-btn-current" disabled>Current Plan</button>
                        <% } else if (tier.id === 'free') { %>
                            <% if (typeof authUser !== 'undefined' && authUser) { %>
                                <button onclick="openCheckout('<%= tier.id %>', '<%= tier.name %>', '<%= tier.price %>', <%= JSON.stringify(tier.features) %>, '<%= tier.tagline %>')" class="pricing-btn">Switch to Free</button>
                            <% } else { %>
                                <a href="/register" class="pricing-btn">Get Started</a>
                            <% } %>
                        <% } else { %>
                            <button onclick="openCheckout('<%= tier.id %>', '<%= tier.name %>', '<%= tier.price %>', <%= JSON.stringify(tier.features) %>, '<%= tier.tagline %>')" class="pricing-btn <%= tier.highlight ? 'pricing-btn-primary' : '' %>">Choose Plan</button>
                        <% } %>
                    </div>
                    <% if (tier.note) { %>
                        <p class="tier-note"><%= tier.note %></p>
                    <% } %>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- Contact Sales Modal - Wizard Style -->
<div id="contactSalesModal" class="sales-modal">
    <div class="sales-modal-overlay" onclick="closeContactSalesModal()"></div>
    <div class="sales-modal-content">
        <button class="sales-modal-close" onclick="closeContactSalesModal()" aria-label="Close">&times;</button>
        
        <!-- Progress Bar -->
        <div class="sales-wizard-progress">
            <div class="progress-bar">
                <div class="progress-fill" id="progressFill"></div>
            </div>
            <div class="progress-steps">
                <div class="progress-step active" data-step="1">
                    <div class="step-icon">🏢</div>
                    <span>Company</span>
                </div>
                <div class="progress-step" data-step="2">
                    <div class="step-icon">👤</div>
                    <span>Contact</span>
                </div>
                <div class="progress-step" data-step="3">
                    <div class="step-icon">📋</div>
                    <span>Requirements</span>
                </div>
                <div class="progress-step" data-step="4">
                    <div class="step-icon">✅</div>
                    <span>Confirm</span>
                </div>
            </div>
        </div>

        <!-- Step 1: Company Information -->
        <div class="sales-step" id="salesStep1">
            <div class="step-header">
                <h2>Tell us about your organization</h2>
                <p>We'd love to learn more about your company to provide a tailored solution.</p>
            </div>
            
            <form class="sales-form" id="companyForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="companyName">Company Name <span class="required">*</span></label>
                        <input type="text" id="companyName" name="companyName" required placeholder="Acme Corporation">
                    </div>
                    <div class="form-group">
                        <label for="industry">Industry <span class="required">*</span></label>
                        <select id="industry" name="industry" required>
                            <option value="">Select industry...</option>
                            <option value="education">Education & E-Learning</option>
                            <option value="technology">Technology & Software</option>
                            <option value="creative">Creative & Media</option>
                            <option value="consulting">Consulting & Professional Services</option>
                            <option value="healthcare">Healthcare & Wellness</option>
                            <option value="finance">Finance & Insurance</option>
                            <option value="retail">Retail & E-Commerce</option>
                            <option value="manufacturing">Manufacturing</option>
                            <option value="nonprofit">Non-Profit & NGO</option>
                            <option value="government">Government</option>
                            <option value="entertainment">Entertainment & Sports</option>
                            <option value="real_estate">Real Estate</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="companySize">Company Size <span class="required">*</span></label>
                        <select id="companySize" name="companySize" required>
                            <option value="">Select size...</option>
                            <option value="1-10">1-10 employees</option>
                            <option value="11-50">11-50 employees</option>
                            <option value="51-200">51-200 employees</option>
                            <option value="201-500">201-500 employees</option>
                            <option value="501-1000">501-1000 employees</option>
                            <option value="1001-5000">1001-5000 employees</option>
                            <option value="5000+">5000+ employees</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="companyWebsite">Company Website</label>
                        <input type="url" id="companyWebsite" name="companyWebsite" placeholder="https://www.example.com">
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="companyCity">City</label>
                        <input type="text" id="companyCity" name="companyCity" placeholder="San Francisco">
                    </div>
                    <div class="form-group">
                        <label for="companyCountry">Country</label>
                        <select id="companyCountry" name="companyCountry">
                            <option value="">Select country...</option>
                            <option value="US">United States</option>
                            <option value="CA">Canada</option>
                            <option value="UK">United Kingdom</option>
                            <option value="DE">Germany</option>
                            <option value="FR">France</option>
                            <option value="AU">Australia</option>
                            <option value="JP">Japan</option>
                            <option value="IN">India</option>
                            <option value="BR">Brazil</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                </div>
            </form>
            
            <div class="step-actions">
                <button type="button" class="sales-btn secondary" onclick="closeContactSalesModal()">Cancel</button>
                <button type="button" class="sales-btn primary" onclick="nextSalesStep(1)">
                    Continue <span class="btn-arrow">→</span>
                </button>
            </div>
        </div>

        <!-- Step 2: Contact Information -->
        <div class="sales-step" id="salesStep2" style="display: none;">
            <div class="step-header">
                <h2>Your contact information</h2>
                <p>Let us know who we should reach out to for a personalized demo.</p>
            </div>
            
            <form class="sales-form" id="contactForm">
                <div class="form-row">
                    <div class="form-group">
                        <label for="contactName">Full Name <span class="required">*</span></label>
                        <input type="text" id="contactName" name="contactName" required placeholder="John Smith">
                    </div>
                    <div class="form-group">
                        <label for="contactEmail">Work Email <span class="required">*</span></label>
                        <input type="email" id="contactEmail" name="contactEmail" required placeholder="john@company.com">
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="contactPhone">Phone Number</label>
                        <input type="tel" id="contactPhone" name="contactPhone" placeholder="+1 (555) 123-4567">
                    </div>
                    <div class="form-group">
                        <label for="contactJobTitle">Job Title <span class="required">*</span></label>
                        <input type="text" id="contactJobTitle" name="contactJobTitle" required placeholder="Head of Learning & Development">
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="contactDepartment">Department</label>
                        <select id="contactDepartment" name="contactDepartment">
                            <option value="">Select department...</option>
                            <option value="executive">Executive / C-Suite</option>
                            <option value="hr">Human Resources</option>
                            <option value="learning">Learning & Development</option>
                            <option value="marketing">Marketing</option>
                            <option value="sales">Sales</option>
                            <option value="it">IT / Technology</option>
                            <option value="operations">Operations</option>
                            <option value="product">Product</option>
                            <option value="finance">Finance</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="preferredContactMethod">Preferred Contact Method</label>
                        <select id="preferredContactMethod" name="preferredContactMethod">
                            <option value="email">Email</option>
                            <option value="phone">Phone</option>
                            <option value="video_call">Video Call</option>
                        </select>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="preferredContactTime">Best Time to Reach You</label>
                    <select id="preferredContactTime" name="preferredContactTime">
                        <option value="">Select time...</option>
                        <option value="morning_et">Morning (9am-12pm ET)</option>
                        <option value="afternoon_et">Afternoon (12pm-5pm ET)</option>
                        <option value="evening_et">Evening (5pm-8pm ET)</option>
                        <option value="flexible">Flexible / Any time</option>
                    </select>
                </div>
            </form>
            
            <div class="step-actions">
                <button type="button" class="sales-btn secondary" onclick="prevSalesStep(2)">
                    <span class="btn-arrow">←</span> Back
                </button>
                <button type="button" class="sales-btn primary" onclick="nextSalesStep(2)">
                    Continue <span class="btn-arrow">→</span>
                </button>
            </div>
        </div>

        <!-- Step 3: Requirements -->
        <div class="sales-step" id="salesStep3" style="display: none;">
            <div class="step-header">
                <h2>Your requirements</h2>
                <p>Help us understand your needs so we can prepare the best solution for you.</p>
            </div>
            
            <form class="sales-form" id="requirementsForm">
                <div class="form-group">
                    <label for="useCase">Primary Use Case <span class="required">*</span></label>
                    <select id="useCase" name="useCase" required>
                        <option value="">Select use case...</option>
                        <option value="employee_training">Employee Training & Development</option>
                        <option value="customer_education">Customer Education</option>
                        <option value="creator_platform">Creator/Instructor Platform</option>
                        <option value="community_building">Community Building</option>
                        <option value="mentorship_program">Mentorship Program</option>
                        <option value="content_marketplace">Content Marketplace</option>
                        <option value="coaching_services">Coaching Services</option>
                        <option value="events_webinars">Events & Webinars</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="expectedUsers">Expected Users</label>
                        <select id="expectedUsers" name="expectedUsers">
                            <option value="">Select range...</option>
                            <option value="1-50">1-50 users</option>
                            <option value="51-100">51-100 users</option>
                            <option value="101-500">101-500 users</option>
                            <option value="501-1000">501-1,000 users</option>
                            <option value="1001-5000">1,001-5,000 users</option>
                            <option value="5000+">5,000+ users</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="timeline">Implementation Timeline</label>
                        <select id="timeline" name="timeline">
                            <option value="">Select timeline...</option>
                            <option value="immediate">Immediate (ASAP)</option>
                            <option value="1-3_months">1-3 months</option>
                            <option value="3-6_months">3-6 months</option>
                            <option value="6-12_months">6-12 months</option>
                            <option value="exploring">Just exploring</option>
                        </select>
                    </div>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="budgetRange">Budget Range</label>
                        <select id="budgetRange" name="budgetRange">
                            <option value="">Select range...</option>
                            <option value="under_500">Under $500/month</option>
                            <option value="500-1000">$500-$1,000/month</option>
                            <option value="1000-2500">$1,000-$2,500/month</option>
                            <option value="2500-5000">$2,500-$5,000/month</option>
                            <option value="5000-10000">$5,000-$10,000/month</option>
                            <option value="10000+">$10,000+/month</option>
                            <option value="not_sure">Not sure yet</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="currentSolution">Current Solution</label>
                        <input type="text" id="currentSolution" name="currentSolution" placeholder="e.g., Teachable, Kajabi, None">
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="integrationNeeds">Integration Requirements</label>
                    <textarea id="integrationNeeds" name="integrationNeeds" rows="2" placeholder="e.g., SSO with Okta, Salesforce CRM, Stripe payments, Slack notifications..."></textarea>
                </div>
                
                <div class="form-group">
                    <label for="howHeardAboutUs">How did you hear about Dream X?</label>
                    <select id="howHeardAboutUs" name="howHeardAboutUs">
                        <option value="">Select option...</option>
                        <option value="google_search">Google Search</option>
                        <option value="social_media">Social Media</option>
                        <option value="referral">Referral / Word of Mouth</option>
                        <option value="event">Conference / Event</option>
                        <option value="blog_article">Blog / Article</option>
                        <option value="podcast">Podcast</option>
                        <option value="advertisement">Advertisement</option>
                        <option value="other">Other</option>
                    </select>
                </div>
            </form>
            
            <div class="step-actions">
                <button type="button" class="sales-btn secondary" onclick="prevSalesStep(3)">
                    <span class="btn-arrow">←</span> Back
                </button>
                <button type="button" class="sales-btn primary" onclick="nextSalesStep(3)">
                    Continue <span class="btn-arrow">→</span>
                </button>
            </div>
        </div>

        <!-- Step 4: Additional Info & Confirmation -->
        <div class="sales-step" id="salesStep4" style="display: none;">
            <div class="step-header">
                <h2>Almost there!</h2>
                <p>Any additional information you'd like to share with our team?</p>
            </div>
            
            <form class="sales-form" id="additionalForm">
                <div class="form-group">
                    <label for="additionalInfo">Additional Information</label>
                    <textarea id="additionalInfo" name="additionalInfo" rows="4" placeholder="Tell us more about your specific needs, challenges, or questions..."></textarea>
                </div>
                
                <div class="summary-card">
                    <h3>📋 Request Summary</h3>
                    <div class="summary-grid" id="summaryContent">
                        <!-- Populated by JavaScript -->
                    </div>
                </div>
                
                <div class="form-group checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="agreeToContact" required>
                        <span class="checkmark"></span>
                        <span>I agree to be contacted by Dream X's sales team regarding Enterprise solutions.</span>
                    </label>
                </div>
                
                <div class="form-group checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="subscribeNewsletter">
                        <span class="checkmark"></span>
                        <span>Keep me updated on new features and product updates.</span>
                    </label>
                </div>
            </form>
            
            <div class="step-actions">
                <button type="button" class="sales-btn secondary" onclick="prevSalesStep(4)">
                    <span class="btn-arrow">←</span> Back
                </button>
                <button type="button" class="sales-btn primary submit-btn" onclick="submitSalesInquiry()" id="submitSalesBtn">
                    <span class="btn-text">Submit Request</span>
                    <span class="btn-loader" style="display: none;">
                        <span class="spinner"></span> Submitting...
                    </span>
                </button>
            </div>
        </div>

        <!-- Success State -->
        <div class="sales-step" id="salesStepSuccess" style="display: none;">
            <div class="success-state">
                <div class="success-icon-large">🎉</div>
                <h2>Thank you for your interest!</h2>
                <p>Your Enterprise inquiry has been submitted successfully. Our sales team will review your request and reach out within 1-2 business days.</p>
                
                <div class="success-details">
                    <div class="detail-item">
                        <span class="detail-icon">📧</span>
                        <span>Confirmation email sent to <strong id="confirmEmail"></strong></span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-icon">📞</span>
                        <span>Expect a call from our team soon</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-icon">📅</span>
                        <span>Reference: <strong id="inquiryRef"></strong></span>
                    </div>
                </div>
                
                <button type="button" class="sales-btn primary" onclick="closeContactSalesModal()">
                    Done
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Checkout Modal -->
<div id="checkoutModal" class="checkout-modal">
    <div class="checkout-modal-overlay" onclick="closeCheckout()"></div>
    <div class="checkout-modal-content">
        <button class="checkout-close" onclick="closeCheckout()" aria-label="Close">&times;</button>
        
        <!-- Progress Steps -->
        <div class="checkout-steps">
            <div class="checkout-step active">
                <div class="step-number">1</div>
                <span class="step-label">Review</span>
            </div>
            <div class="checkout-step">
                <div class="step-number">2</div>
                <span class="step-label">Payment</span>
            </div>
            <div class="checkout-step">
                <div class="step-number">3</div>
                <span class="step-label">Confirm</span>
            </div>
        </div>

        <!-- Step 1: Plan Review -->
        <div class="checkout-step-content" id="step1">
            <h2>Review Your Plan</h2>
            <div class="plan-summary">
                <h3 id="selectedPlanName"></h3>
                <p id="selectedPlanTagline"></p>
                <div class="plan-price" id="selectedPlanPrice"></div>
                <ul class="plan-features" id="selectedPlanFeatures"></ul>
            </div>
            <div class="checkout-actions">
                <button onclick="closeCheckout()" class="checkout-btn outline">Cancel</button>
                <button onclick="nextStep()" class="checkout-btn primary">Continue to Payment</button>
            </div>
        </div>

        <!-- Step 2: Payment Information -->
        <div class="checkout-step-content" id="step2" style="display: none;">
            <h2>Payment Information</h2>
            <form id="paymentForm">
                <div class="form-group">
                    <label for="cardType">Card Type</label>
                    <select id="cardType" class="form-control" required>
                        <option value="">Select card type</option>
                        <option value="visa">Visa</option>
                        <option value="mastercard">Mastercard</option>
                        <option value="amex">American Express</option>
                        <option value="discover">Discover</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="cardNumber">Card Number</label>
                    <input type="text" id="cardNumber" class="form-control" placeholder="1234 5678 9012 3456" maxlength="19" required>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="expiryMonth">Expiry Month</label>
                        <select id="expiryMonth" class="form-control" required>
                            <option value="">MM</option>
                            <% for(let i = 1; i <= 12; i++) { %>
                                <option value="<%= i.toString().padStart(2, '0') %>"><%= i.toString().padStart(2, '0') %></option>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="expiryYear">Expiry Year</label>
                        <select id="expiryYear" class="form-control" required>
                            <option value="">YYYY</option>
                            <% const currentYear = new Date().getFullYear(); %>
                            <% for(let i = 0; i < 10; i++) { %>
                                <option value="<%= currentYear + i %>"><%= currentYear + i %></option>
                            <% } %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="cvv">CVV</label>
                        <input type="text" id="cvv" class="form-control" placeholder="123" maxlength="4" required>
                    </div>
                </div>
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="saveCard">
                        Save card for future purchases
                    </label>
                </div>
            </form>
            <div class="checkout-actions">
                <button onclick="prevStep()" class="checkout-btn outline">Back</button>
                <button onclick="nextStep()" class="checkout-btn primary">Review Order</button>
            </div>
        </div>

        <!-- Step 3: Confirmation -->
        <div class="checkout-step-content" id="step3" style="display: none;">
            <h2>Confirm Your Purchase</h2>
            <div class="order-summary">
                <h3>Order Summary</h3>
                <div class="summary-item">
                    <span>Plan:</span>
                    <span id="confirmPlanName"></span>
                </div>
                <div class="summary-item">
                    <span>Payment Method:</span>
                    <span id="confirmCardInfo"></span>
                </div>
                <div class="summary-item total">
                    <span>Total:</span>
                    <span id="confirmPlanPrice"></span>
                </div>
            </div>
            <div class="checkout-actions">
                <button onclick="prevStep()" class="checkout-btn outline">Back</button>
                <button onclick="processPayment()" class="checkout-btn primary" id="confirmBtn">
                    <span class="btn-text">Complete Purchase</span>
                    <span class="btn-loader" style="display: none;">Processing...</span>
                </button>
            </div>
        </div>

        <!-- Step 4: Success -->
        <div class="checkout-step-content" id="step4" style="display: none;">
            <div class="success-message">
                <div class="success-icon">✓</div>
                <h3>Welcome to <span id="successPlanName"></span>!</h3>
                <p>Your subscription is now active. Enjoy your new features!</p>
                <button onclick="window.location.href='/settings'" class="checkout-btn primary">Go to Settings</button>
            </div>
        </div>
    </div>
</div>

<style>
/* Pricing Hero */
.pricing-hero {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 80px 20px;
    text-align: center;
}

.pricing-title {
    font-size: 3rem;
    font-weight: 900;
    margin-bottom: 16px;
}

.pricing-subtitle {
    font-size: 1.25rem;
    opacity: 0.95;
}

/* Pricing Section */
.pricing-section {
    padding: 80px 20px;
    background: var(--bg-light);
}

.pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    max-width: 1400px;
    margin: 0 auto;
}

.pricing-card {
    background: white;
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s, box-shadow 0.3s;
    position: relative;
    display: flex;
    flex-direction: column;
}

.pricing-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
}

.pricing-card-highlight {
    border: 3px solid var(--primary-color);
}

.pricing-badge {
    position: absolute;
    top: -12px;
    right: 32px;
    background: var(--primary-color);
    color: white;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 700;
}

.pricing-card-header {
    text-align: center;
    margin-bottom: 24px;
}

.pricing-card-name {
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 8px;
    color: var(--text-dark);
}

.pricing-card-tagline {
    font-size: 0.95rem;
    color: var(--text-light);
    margin-bottom: 16px;
}

.pricing-card-price {
