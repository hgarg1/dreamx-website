<script>
var isLoggedIn = "<%= (typeof authUser !== 'undefined' && authUser) ? 'true' : 'false' %>";
let currentStep = 1;
let selectedTier = '';
let selectedName = '';
let selectedPrice = '';
let selectedFeatures = [];
let selectedTagline = '';

function openCheckout(tierId, tierName, tierPrice, features, tagline) {
    if (isLoggedIn !== 'true') {
        window.location.href = '/login';
        return;
    }
    
    selectedTier = tierId;
    selectedName = tierName;
    selectedPrice = tierPrice;
    selectedFeatures = features || [];
    selectedTagline = tagline || '';
    
    // If selecting enterprise tier, redirect to contact
    if (tierId === 'enterprise') {
        window.location.href = '/contact';
        return;
    }
    
    // If selecting free tier, just redirect to settings
    if (tierId === 'free') {
        if (confirm('Switch to free tier?')) {
            fetch('/api/checkout/subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tier: 'free' })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    window.location.href = '/settings?success=Switched+to+free+tier';
                }
            });
        }
        return;
    }
    
    // Update modal content
    document.getElementById('selectedPlanName').textContent = tierName;
    document.getElementById('selectedPlanTagline').textContent = tagline;
    document.getElementById('selectedPlanPrice').textContent = tierPrice;
    
    // Update features list
    const featuresList = document.getElementById('selectedPlanFeatures');
    featuresList.innerHTML = '';
    selectedFeatures.forEach(feature => {
        const li = document.createElement('li');
        li.textContent = feature;
        featuresList.appendChild(li);
    });
    
    document.getElementById('checkoutModal').classList.add('active');
    currentStep = 1;
    updateStepDisplay();
}

function closeCheckout() {
    document.getElementById('checkoutModal').classList.remove('active');
    setTimeout(() => {
        currentStep = 1;
        updateStepDisplay();
        document.getElementById('paymentForm').reset();
    }, 300);
}

function nextStep() {
    if (currentStep === 2) {
        // Validate payment form
        const form = document.getElementById('paymentForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }
        
        // Update confirmation
        const cardType = document.getElementById('cardType').value;
        const cardNumber = document.getElementById('cardNumber').value;
        const lastFour = cardNumber.replace(/\s/g, '').slice(-4);
        
        document.getElementById('confirmPlanName').textContent = selectedName;
        document.getElementById('confirmPlanPrice').textContent = selectedPrice;
        document.getElementById('confirmCardInfo').textContent = 
            cardType.charAt(0).toUpperCase() + cardType.slice(1) + ' •••• ' + lastFour;
    }
    
    if (currentStep < 3) {
        currentStep++;
        updateStepDisplay();
    }
}

function prevStep() {
    if (currentStep > 1) {
        currentStep--;
        updateStepDisplay();
    }
}

function updateStepDisplay() {
    // Update step indicators
    document.querySelectorAll('.checkout-step').forEach((step, index) => {
        step.classList.remove('active', 'completed');
        if (index + 1 === currentStep) {
            step.classList.add('active');
        } else if (index + 1 < currentStep) {
            step.classList.add('completed');
        }
    });
    
    // Update content visibility
    document.querySelectorAll('.checkout-step-content').forEach((content, index) => {
        content.style.display = (index + 1 === currentStep) ? 'block' : 'none';
    });
}

function processPayment() {
    const confirmBtn = document.getElementById('confirmBtn');
    const btnText = confirmBtn.querySelector('.btn-text');
    const btnLoader = confirmBtn.querySelector('.btn-loader');
    
    // Show loading state
    confirmBtn.disabled = true;
    btnText.style.display = 'none';
    btnLoader.style.display = 'inline';
    
    // Gather form data
    const cardNumber = document.getElementById('cardNumber').value.replace(/\s/g, '');
    const paymentData = {
        tier: selectedTier,
        cardType: document.getElementById('cardType').value,
        cardNumber: cardNumber,
        expiryMonth: document.getElementById('expiryMonth').value,
        expiryYear: document.getElementById('expiryYear').value,
        cvv: document.getElementById('cvv').value,
        saveCard: document.getElementById('saveCard').checked
    };
    
    // Process payment
    fetch('/api/checkout/subscribe', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(paymentData)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Show success message
            document.getElementById('successPlanName').textContent = selectedName;
            currentStep = 4;
            updateStepDisplay();
        } else {
            alert(data.error || 'Payment failed. Please try again.');
            confirmBtn.disabled = false;
            btnText.style.display = 'inline';
            btnLoader.style.display = 'none';
        }
    })
    .catch(error => {
        console.error('Payment error:', error);
        alert('An error occurred. Please try again.');
        confirmBtn.disabled = false;
        btnText.style.display = 'inline';
        btnLoader.style.display = 'none';
    });
}

// Format card number with spaces
document.addEventListener('DOMContentLoaded', function() {
    const cardNumberInput = document.getElementById('cardNumber');
    if (cardNumberInput) {
        cardNumberInput.addEventListener('input', function(e) {
            let value = e.target.value.replace(/\s/g, '');
            let formattedValue = value.match(/.{1,4}/g)?.join(' ') || value;
            e.target.value = formattedValue;
        });
    }
});

// ==========================================
// CONTACT SALES MODAL FUNCTIONALITY
// ==========================================

let currentSalesStep = 1;
const totalSalesSteps = 4;
let salesFormData = {};

function openContactSalesModal() {
    const modal = document.getElementById('contactSalesModal');
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
    currentSalesStep = 1;
    updateSalesProgress();
    showSalesStep(1);
}

function closeContactSalesModal() {
    const modal = document.getElementById('contactSalesModal');
    modal.classList.remove('active');
    document.body.style.overflow = '';
    
    // Reset form after close animation
    setTimeout(() => {
        currentSalesStep = 1;
        updateSalesProgress();
        resetSalesForms();
        showSalesStep(1);
    }, 300);
}

function resetSalesForms() {
    document.getElementById('companyForm')?.reset();
    document.getElementById('contactForm')?.reset();
    document.getElementById('requirementsForm')?.reset();
    document.getElementById('additionalForm')?.reset();
    salesFormData = {};
}

function showSalesStep(step) {
    // Hide all steps
    for (let i = 1; i <= totalSalesSteps; i++) {
        const stepEl = document.getElementById(`salesStep${i}`);
        if (stepEl) stepEl.style.display = 'none';
    }
    const successEl = document.getElementById('salesStepSuccess');
    if (successEl) successEl.style.display = 'none';
    
    // Show current step
    const currentStepEl = document.getElementById(`salesStep${step}`);
    if (currentStepEl) {
        currentStepEl.style.display = 'block';
    }
    
    // Update progress indicators
    document.querySelectorAll('.progress-step').forEach((el, idx) => {
        el.classList.remove('active', 'completed');
        if (idx + 1 < step) {
            el.classList.add('completed');
        } else if (idx + 1 === step) {
            el.classList.add('active');
        }
    });
}

function updateSalesProgress() {
    const progressFill = document.getElementById('progressFill');
    if (progressFill) {
        const percentage = (currentSalesStep / totalSalesSteps) * 100;
        progressFill.style.width = percentage + '%';
    }
}

function collectFormData(formId) {
    const form = document.getElementById(formId);
    if (!form) return {};
    
    const formData = new FormData(form);
    const data = {};
    formData.forEach((value, key) => {
        data[key] = value;
    });
    return data;
}

function validateStep(step) {
    let formId;
    switch(step) {
        case 1: formId = 'companyForm'; break;
        case 2: formId = 'contactForm'; break;
        case 3: formId = 'requirementsForm'; break;
        case 4: formId = 'additionalForm'; break;
        default: return true;
    }
    
    const form = document.getElementById(formId);
    if (!form) return true;
    
    // Check HTML5 validation
    if (!form.checkValidity()) {
        form.reportValidity();
        return false;
    }
    
    return true;
}

function nextSalesStep(fromStep) {
    if (!validateStep(fromStep)) return;
    
    // Collect data from current step
    switch(fromStep) {
        case 1:
            Object.assign(salesFormData, collectFormData('companyForm'));
            break;
        case 2:
            Object.assign(salesFormData, collectFormData('contactForm'));
            break;
        case 3:
            Object.assign(salesFormData, collectFormData('requirementsForm'));
            break;
    }
    
    // Update summary if going to step 4
    if (fromStep === 3) {
        updateSalesSummary();
    }
    
    currentSalesStep = fromStep + 1;
    updateSalesProgress();
    showSalesStep(currentSalesStep);
}

function prevSalesStep(fromStep) {
    currentSalesStep = fromStep - 1;
    updateSalesProgress();
    showSalesStep(currentSalesStep);
}

function updateSalesSummary() {
    const summaryContent = document.getElementById('summaryContent');
    if (!summaryContent) return;
    
    const items = [
        { label: 'Company', value: salesFormData.companyName || '-' },
        { label: 'Industry', value: salesFormData.industry || '-' },
        { label: 'Company Size', value: salesFormData.companySize || '-' },
        { label: 'Contact', value: salesFormData.contactName || '-' },
        { label: 'Email', value: salesFormData.contactEmail || '-' },
        { label: 'Job Title', value: salesFormData.contactJobTitle || '-' },
        { label: 'Use Case', value: salesFormData.useCase?.replace(/_/g, ' ') || '-' },
        { label: 'Expected Users', value: salesFormData.expectedUsers || '-' },
        { label: 'Timeline', value: salesFormData.timeline?.replace(/_/g, ' ') || '-' },
        { label: 'Budget', value: salesFormData.budgetRange?.replace(/_/g, ' ') || '-' }
    ];
    
    summaryContent.innerHTML = items.map(item => `
        <div class="summary-item">
            <span class="label">${item.label}</span>
            <span class="value">${item.value}</span>
        </div>
    `).join('');
}

async function submitSalesInquiry() {
    const agreeCheckbox = document.getElementById('agreeToContact');
    if (!agreeCheckbox.checked) {
        alert('Please agree to be contacted by our sales team to proceed.');
        return;
    }
    
    // Collect final data
    const additionalInfo = document.getElementById('additionalInfo')?.value || '';
    const subscribeNewsletter = document.getElementById('subscribeNewsletter')?.checked || false;
    
    const submitBtn = document.getElementById('submitSalesBtn');
    const btnText = submitBtn.querySelector('.btn-text');
    const btnLoader = submitBtn.querySelector('.btn-loader');
    
    // Show loading state
    submitBtn.disabled = true;
    btnText.style.display = 'none';
    btnLoader.style.display = 'flex';
    
    const payload = {
        ...salesFormData,
        additionalInfo,
        subscribeNewsletter
    };
    
    try {
        const response = await fetch('/api/sales/inquiry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        
        const result = await response.json();
        
        if (response.ok && result.success) {
            // Show success state
            document.getElementById('confirmEmail').textContent = salesFormData.contactEmail;
            document.getElementById('inquiryRef').textContent = result.referenceId || 'ENT-' + Date.now();
            
            // Hide all steps, show success
            for (let i = 1; i <= totalSalesSteps; i++) {
                const stepEl = document.getElementById(`salesStep${i}`);
                if (stepEl) stepEl.style.display = 'none';
            }
            
            document.getElementById('salesStepSuccess').style.display = 'block';
            
            // Update progress to 100%
            document.getElementById('progressFill').style.width = '100%';
            document.querySelectorAll('.progress-step').forEach(el => {
                el.classList.add('completed');
            });
        } else {
            alert(result.error || 'Failed to submit inquiry. Please try again.');
            submitBtn.disabled = false;
            btnText.style.display = 'inline';
            btnLoader.style.display = 'none';
        }
    } catch (error) {
        console.error('Sales inquiry error:', error);
        alert('An error occurred. Please try again.');
        submitBtn.disabled = false;
        btnText.style.display = 'inline';
        btnLoader.style.display = 'none';
    }
}

// Close modal on overlay click
document.addEventListener('click', function(e) {
    if (e.target.classList.contains('sales-modal-overlay')) {
        closeContactSalesModal();
    }
});

// Close modal on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        const salesModal = document.getElementById('contactSalesModal');
        const checkoutModal = document.getElementById('checkoutModal');
        
        if (salesModal?.classList.contains('active')) {
            closeContactSalesModal();
        } else if (checkoutModal?.classList.contains('active')) {
            closeCheckout();
        }
    }
});
