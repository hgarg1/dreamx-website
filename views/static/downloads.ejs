<%- include('partials/header') %>

<style>
    .downloads-page {
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
        background-size: 400% 400%;
        animation: gradientShift 15s ease infinite;
        position: relative;
        overflow: hidden;
    }

    @keyframes gradientShift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .downloads-page::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: 
            radial-gradient(circle at 20% 50%, rgba(255, 77, 255, 0.1) 0%, transparent 50%),
            radial-gradient(circle at 80% 80%, rgba(63, 214, 255, 0.1) 0%, transparent 50%),
            radial-gradient(circle at 40% 20%, rgba(255, 77, 255, 0.05) 0%, transparent 50%);
        pointer-events: none;
    }

    .downloads-hero {
        padding: 8rem 1.5rem 4rem;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .downloads-hero h1 {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 800;
        background: linear-gradient(135deg, #ffffff 0%, #f0f0f0 50%, #ffffff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 1.5rem;
        animation: fadeInUp 0.8s ease;
        text-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .downloads-hero p {
        font-size: clamp(1.1rem, 2.5vw, 1.5rem);
        color: rgba(255, 255, 255, 0.95);
        max-width: 700px;
        margin: 0 auto 3rem;
        line-height: 1.6;
        animation: fadeInUp 1s ease;
    }

    .downloads-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem 4rem;
        position: relative;
        z-index: 1;
    }

    .downloads-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
        margin-bottom: 4rem;
    }

    .download-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        padding: 2.5rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        position: relative;
        overflow: hidden;
        animation: fadeInUp 0.6s ease backwards;
    }

    .download-card:nth-child(1) { animation-delay: 0.1s; }
    .download-card:nth-child(2) { animation-delay: 0.2s; }
    .download-card:nth-child(3) { animation-delay: 0.3s; }
    .download-card:nth-child(4) { animation-delay: 0.4s; }

    .download-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #FF4DFF, #3FD6FF);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.4s ease;
    }

    .download-card:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
    }

    .download-card:hover::before {
        transform: scaleX(1);
    }

    .download-icon {
        width: 80px;
        height: 80px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
        background: linear-gradient(135deg, #FF4DFF, #3FD6FF);
        box-shadow: 0 10px 30px rgba(255, 77, 255, 0.3);
        animation: float 3s ease-in-out infinite;
    }

    .download-card:nth-child(2) .download-icon {
        background: linear-gradient(135deg, #3FD6FF, #FF4DFF);
        animation-delay: 0.5s;
    }

    .download-card:nth-child(3) .download-icon {
        background: linear-gradient(135deg, #FF4DFF, #764ba2);
        animation-delay: 1s;
    }

    .download-card:nth-child(4) .download-icon {
        background: linear-gradient(135deg, #667eea, #FF4DFF);
        animation-delay: 1.5s;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
    }

    .download-card h3 {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 0.5rem;
    }

    .download-card p {
        color: #6b7280;
        line-height: 1.6;
        margin-bottom: 1.5rem;
        font-size: 1rem;
    }

    .download-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 2rem;
        background: linear-gradient(135deg, #FF4DFF, #3FD6FF);
        color: white;
        text-decoration: none;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(255, 77, 255, 0.3);
        position: relative;
        overflow: hidden;
    }

    .download-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
        transition: left 0.5s ease;
    }

    .download-btn:hover::before {
        left: 100%;
    }

    .download-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 25px rgba(255, 77, 255, 0.4);
    }

    .download-btn:active {
        transform: translateY(0);
    }

    .download-btn svg {
        width: 20px;
        height: 20px;
    }

    .download-features {
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e5e7eb;
    }

    .download-features ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .download-features li {
        color: #6b7280;
        font-size: 0.9rem;
        padding: 0.5rem 0;
        padding-left: 1.5rem;
        position: relative;
    }

    .download-features li::before {
        content: '✓';
        position: absolute;
        left: 0;
        color: #FF4DFF;
        font-weight: bold;
    }

    .download-buttons-group {
        display: flex;
        gap: 1rem;
        margin-bottom: 0.75rem;
        flex-wrap: wrap;
    }

    .download-btn-secondary {
        flex: 1;
        min-width: 140px;
        justify-content: center;
    }

    .download-format-link {
        display: block;
        text-align: center;
        color: #6b7280;
        font-size: 0.85rem;
        text-decoration: none;
        margin-bottom: 1.5rem;
        transition: color 0.3s ease;
        cursor: pointer;
    }

    .download-format-link:hover {
        color: #FF4DFF;
        text-decoration: underline;
    }

    .format-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        z-index: 10000;
        align-items: center;
        justify-content: center;
        animation: fadeIn 0.3s ease;
    }

    .format-modal.active {
        display: flex;
    }

    .format-modal-content {
        background: white;
        border-radius: 24px;
        padding: 2.5rem;
        max-width: 600px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        position: relative;
        animation: slideUp 0.3s ease;
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .format-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e5e7eb;
    }

    .format-modal-header h2 {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1f2937;
        margin: 0;
    }

    .format-modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        color: #6b7280;
        cursor: pointer;
        padding: 0.5rem;
        line-height: 1;
        transition: color 0.3s ease;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
    }

    .format-modal-close:hover {
        color: #FF4DFF;
        background: rgba(255, 77, 255, 0.1);
    }

    .format-comparison {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .format-item {
        padding: 1.5rem;
        background: #f9fafb;
        border-radius: 12px;
        border: 2px solid #e5e7eb;
        transition: all 0.3s ease;
    }

    .format-item:hover {
        border-color: #FF4DFF;
        box-shadow: 0 4px 12px rgba(255, 77, 255, 0.1);
    }

    .format-item h3 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .format-item h3::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: linear-gradient(135deg, #FF4DFF, #3FD6FF);
    }

    .format-item.msi h3::before {
        background: #3FD6FF;
    }

    .format-item.exe h3::before {
        background: #FF4DFF;
    }

    .format-item p {
        color: #6b7280;
        line-height: 1.6;
        margin: 0;
        font-size: 0.95rem;
    }

    .format-features {
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e5e7eb;
    }

    .format-features h4 {
        font-size: 1rem;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 0.75rem;
    }

    .format-features ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .format-features li {
        color: #6b7280;
        font-size: 0.9rem;
        padding: 0.4rem 0;
        padding-left: 1.5rem;
        position: relative;
    }

    .format-features li::before {
        content: '•';
        position: absolute;
        left: 0;
        color: #FF4DFF;
        font-weight: bold;
    }

    .format-recommendation {
        background: linear-gradient(135deg, rgba(255, 77, 255, 0.1), rgba(63, 214, 255, 0.1));
        border-left: 4px solid #FF4DFF;
        padding: 1rem 1.5rem;
        border-radius: 8px;
        margin-top: 1.5rem;
    }

    .format-recommendation p {
        color: #1f2937;
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .format-recommendation strong {
        color: #FF4DFF;
    }

    @media (max-width: 768px) {
        .download-buttons-group {
            flex-direction: column;
        }

        .download-btn-secondary {
            width: 100%;
        }

        .format-comparison {
            grid-template-columns: 1fr;
        }

        .format-modal-content {
            padding: 1.5rem;
        }
    }

    .coming-soon {
        opacity: 0.7;
        position: relative;
    }

    .coming-soon::after {
        content: 'Coming Soon';
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: linear-gradient(135deg, #FF4DFF, #3FD6FF);
        color: white;
        padding: 0.4rem 1rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .download-info {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        padding: 3rem;
        margin-top: 3rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
        text-align: center;
        animation: fadeInUp 0.8s ease 0.5s backwards;
    }

    .download-info h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 1rem;
    }

    .download-info p {
        color: #6b7280;
        font-size: 1.1rem;
        line-height: 1.7;
        max-width: 700px;
        margin: 0 auto;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (max-width: 768px) {
        .downloads-hero {
            padding: 6rem 1rem 3rem;
        }

        .downloads-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .download-card {
            padding: 2rem;
        }

        .download-info {
            padding: 2rem;
        }
    }

    .floating-particles {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }

    .particle {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        animation: float-particle 20s infinite ease-in-out;
    }

    @keyframes float-particle {
        0%, 100% {
            transform: translate(0, 0) rotate(0deg);
            opacity: 0;
        }
        10% {
            opacity: 1;
        }
        90% {
            opacity: 1;
        }
        50% {
            transform: translate(100px, -100px) rotate(180deg);
        }
    }
</style>

