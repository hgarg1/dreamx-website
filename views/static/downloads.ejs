</main>

<!-- Format Comparison Modal -->
<div id="formatModal" class="format-modal" onclick="if(event.target === this) closeFormatModal();">
    <div class="format-modal-content">
        <div class="format-modal-header">
            <h2>MSI vs EXE: What's the Difference?</h2>
            <button class="format-modal-close" onclick="closeFormatModal();" aria-label="Close">&times;</button>
        </div>
        <div class="format-comparison">
            <div class="format-item msi">
                <h3>MSI Installer</h3>
                <p>MSI (Microsoft Installer) is the standard Windows installation format. It's designed for system administrators and enterprise deployments.</p>
                <div class="format-features">
                    <h4>Best for:</h4>
                    <ul>
                        <li>Corporate/enterprise environments</li>
                        <li>System administrators</li>
                        <li>Automated deployments</li>
                        <li>Group policy management</li>
                        <li>Silent installations</li>
                    </ul>
                </div>
            </div>
            <div class="format-item exe">
                <h3>EXE Installer</h3>
                <p>EXE (Executable) is a self-contained installer that's user-friendly and works well for individual users and home installations.</p>
                <div class="format-features">
                    <h4>Best for:</h4>
                    <ul>
                        <li>Individual users</li>
                        <li>Home installations</li>
                        <li>Simple setup process</li>
                        <li>Quick installation</li>
                        <li>User-friendly interface</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="format-recommendation">
            <p><strong>Recommendation:</strong> For most users, the <strong>EXE installer</strong> is the easiest option. Choose <strong>MSI</strong> if you're in a corporate environment or need advanced installation options.</p>
        </div>
    </div>
</div>

<script>
    function openFormatModal() {
        const modal = document.getElementById('formatModal');
        if (modal) {
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
    }

    function closeFormatModal() {
        const modal = document.getElementById('formatModal');
        if (modal) {
            modal.classList.remove('active');
            document.body.style.overflow = '';
        }
    }

    // Close modal on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeFormatModal();
        }
    });
</script>

<%- include('partials/footer') %>

