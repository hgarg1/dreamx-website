</style>

<script>
  (function(){
    const paidTiers = new Set(['pro-buyer','pro-seller','elite-seller']);
    const buttons = document.querySelectorAll('.js-switch-tier');

    // Build modal lazily
    function ensureModal(){
      if (document.getElementById('checkoutModal')) return;
      const modal = document.createElement('div');
      modal.id = 'checkoutModal';
      modal.style.cssText = 'display:none;position:fixed;z-index:1000;left:0;top:0;width:100%;height:100%;background:rgba(0,0,0,0.6);align-items:center;justify-content:center;';
      modal.innerHTML = `
        <div style="background:white;padding:24px;border-radius:12px;max-width:520px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.3);">
          <h3 style="margin:0 0 12px;font-size:1.25rem;font-weight:700;">Subscribe to <span id="cm-plan-name"></span></h3>
          <p style="color:#6b7280;margin:0 0 12px;">Enter payment details to start your subscription. This is a mock checkout.</p>
          <form id="checkoutForm">
            <input type="hidden" name="tier" id="cm-tier" />
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
              <div>
                <label style="display:block;font-weight:600;margin-bottom:4px;">Card Type</label>
                <select name="cardType" class="settings-input" required>
                  <option value="visa">Visa</option>
                  <option value="mastercard">Mastercard</option>
                  <option value="amex">American Express</option>
                </select>
              </div>
              <div>
                <label style="display:block;font-weight:600;margin-bottom:4px;">Card Number</label>
                <input name="cardNumber" class="settings-input" placeholder="4242424242424242" required />
              </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:12px;">
              <div>
                <label style="display:block;font-weight:600;margin-bottom:4px;">Expiry Month</label>
                <input name="expiryMonth" type="number" min="1" max="12" class="settings-input" placeholder="12" required />
              </div>
              <div>
                <label style="display:block;font-weight:600;margin-bottom:4px;">Expiry Year</label>
                <input name="expiryYear" type="number" min="2025" max="2050" class="settings-input" placeholder="2026" required />
              </div>
              <div>
                <label style="display:block;font-weight:600;margin-bottom:4px;">CVV</label>
                <input name="cvv" class="settings-input" placeholder="123" required />
              </div>
            </div>
            <label class="toggle-row" style="margin:12px 0;">
              <input type="checkbox" name="saveCard" checked />
              <span>Save this card as default</span>
            </label>
            <div style="display:flex;gap:8px;justify-content:flex-end;">
              <button type="button" id="cm-cancel" class="settings-btn" style="background:#eee;">Cancel</button>
              <button type="submit" class="settings-btn primary">Confirm</button>
            </div>
          </form>
        </div>`;
      document.body.appendChild(modal);
      document.getElementById('cm-cancel').addEventListener('click', () => modal.style.display = 'none');
      document.getElementById('checkoutForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const body = Object.fromEntries(fd.entries());
        body.saveCard = !!body.saveCard; // checkbox -> boolean
        try {
          const res = await fetch('/api/checkout/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          });
          const out = await res.json();
          if (res.ok && out.success) {
            alert('Subscription updated successfully');
            window.location.reload();
          } else {
            alert(out.error || 'Failed to update subscription');
          }
        } catch (err) {
          alert('Network error. Please try again.');
        }
      });
    }

    function openModalForTier(tier){
      ensureModal();
      const modal = document.getElementById('checkoutModal');
      document.getElementById('cm-tier').value = tier;
      const pretty = tier.replace('-', ' ').replace(/\b\w/g, c => c.toUpperCase());
      document.getElementById('cm-plan-name').textContent = pretty;
      modal.style.display = 'flex';
    }

    async function submitFree(){
      try {
        const res = await fetch('/api/checkout/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tier: 'free' })
        });
        const out = await res.json();
        if (res.ok && out.success) {
          alert('Switched to Free plan');
          window.location.reload();
        } else {
          alert(out.error || 'Failed to switch plan');
        }
      } catch (e) {
        alert('Network error. Please try again.');
      }
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const tier = btn.getAttribute('data-tier');
        if (!tier) return;
        if (tier === 'free') return submitFree();
        if (paidTiers.has(tier)) return openModalForTier(tier);
      });
    });
  })();

  // Cancel Subscription Modal Functions
  function openCancelModal() {
    const modal = document.getElementById('cancelSubscriptionModal');
    if (modal) {
      modal.style.display = 'flex';
    }
  }

  function closeCancelModal() {
    const modal = document.getElementById('cancelSubscriptionModal');
    if (modal) {
      modal.style.display = 'none';
    }
  }

  async function confirmCancelSubscription() {
    const reason = document.getElementById('cancelReason')?.value?.trim() || 'No reason provided';
    
    if (!confirm('Are you sure you want to cancel your subscription? You will lose access to premium features at the end of your current billing period.')) {
      return;
    }

    try {
      const res = await fetch('/api/subscription/cancel', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason })
      });
      const data = await res.json();
      
      if (res.ok && data.success) {
        alert('Your subscription has been cancelled. You will retain access until the end of your billing period.');
        closeCancelModal();
        window.location.reload();
      } else {
        alert(data.error || 'Failed to cancel subscription. Please try again.');
      }
    } catch (err) {
      console.error('Cancel subscription error:', err);
      alert('Network error. Please try again.');
    }
  }

  // Close modal when clicking outside
  window.addEventListener('click', (e) => {
    const modal = document.getElementById('cancelSubscriptionModal');
    if (modal && e.target === modal) {
      closeCancelModal();
    }
  });

  // ============================================
  // ADD PAYMENT METHOD MODAL & CARD DETECTION
  // ============================================
  
  // Card type detection patterns
  const cardPatterns = {
    visa: {
      pattern: /^4/,
      icon: '💳',
      color: 'linear-gradient(135deg, #1a1f71 0%, #0d47a1 100%)',
      name: 'Visa'
    },
    mastercard: {
      pattern: /^5[1-5]/,
      icon: '💳',
      color: 'linear-gradient(135deg, #eb001b 0%, #f79e1b 100%)',
      name: 'Mastercard'
    },
    amex: {
      pattern: /^3[47]/,
      icon: '💳',
      color: 'linear-gradient(135deg, #006fcf 0%, #00a2e2 100%)',
      name: 'American Express'
    },
    discover: {
      pattern: /^6(?:011|5)/,
      icon: '💳',
      color: 'linear-gradient(135deg, #ff6600 0%, #ff9500 100%)',
      name: 'Discover'
    },
    default: {
      icon: '💳',
      color: 'linear-gradient(135deg, #FF4DFF 0%, #A53CFF 100%)',
      name: 'Unknown'
    }
  };

  function detectCardType(number) {
    const cleanNumber = number.replace(/\s/g, '');
    
    for (const [type, data] of Object.entries(cardPatterns)) {
      if (type !== 'default' && data.pattern.test(cleanNumber)) {
        return { type, ...data };
      }
    }
    
    return { type: 'default', ...cardPatterns.default };
  }

  function formatCardNumber(value) {
    const cleaned = value.replace(/\s/g, '');
    const chunks = cleaned.match(/.{1,4}/g);
    return chunks ? chunks.join(' ') : cleaned;
  }

  function handleCardNumberInput(event) {
    const input = event.target;
    let value = input.value.replace(/\s/g, '');
    
    // Only allow numbers
    value = value.replace(/[^0-9]/g, '');
    
    // Format with spaces
    const formatted = formatCardNumber(value);
    input.value = formatted;
    
    // Detect card type
    const cardInfo = detectCardType(value);
    
    // Update card preview
    const cardPreview = document.getElementById('cardPreview');
    const cardTypeIcon = document.getElementById('cardTypeIcon');
    const cardTypeIndicator = document.getElementById('cardTypeIndicator');
    const cardTypeLabel = document.getElementById('cardTypeLabel');
    const cardNumberDisplay = document.getElementById('cardNumberDisplay');
    
    // Animate card background change
    cardPreview.style.background = cardInfo.color;
    cardTypeIcon.textContent = cardInfo.icon;
    cardTypeIndicator.textContent = cardInfo.icon;
    
    // Update card type label
    if (cardInfo.type !== 'default' && value.length >= 2) {
      cardTypeLabel.textContent = `${cardInfo.name} detected`;
      cardTypeLabel.style.color = '#059669';
    } else {
      cardTypeLabel.textContent = '';
    }
    
    // Update card number display
    if (formatted.length > 0) {
      const masked = formatted.split('').map((char, idx) => {
        if (char === ' ') return ' ';
        return formatted.length < 19 ? char : (idx < formatted.length - 4 ? '•' : char);
      }).join('');
      cardNumberDisplay.textContent = masked;
    } else {
      cardNumberDisplay.textContent = '•••• •••• •••• ••••';
    }
  }

  function handleCardHolderInput(event) {
    const input = event.target;
    const cardHolderDisplay = document.getElementById('cardHolderDisplay');
    const value = input.value.toUpperCase();
    input.value = value;
    cardHolderDisplay.textContent = value || 'YOUR NAME';
  }

  function handleExpiryInput(event) {
    const input = event.target;
    // Only allow numbers
    input.value = input.value.replace(/[^0-9]/g, '');
    
    const month = document.getElementById('expiryMonthInput').value;
    const year = document.getElementById('expiryYearInput').value;
    const cardExpiryDisplay = document.getElementById('cardExpiryDisplay');
    
    if (month || year) {
      cardExpiryDisplay.textContent = `${month.padStart(2, '0')}/${year.padStart(2, '0')}`;
    } else {
      cardExpiryDisplay.textContent = 'MM/YY';
    }
  }

  function openAddPaymentModal() {
    const modal = document.getElementById('addPaymentMethodModal');
    if (modal) {
      modal.style.display = 'flex';
      // Reset form
      document.getElementById('addPaymentForm').reset();
      document.getElementById('cardNumberDisplay').textContent = '•••• •••• •••• ••••';
      document.getElementById('cardHolderDisplay').textContent = 'YOUR NAME';
      document.getElementById('cardExpiryDisplay').textContent = 'MM/YY';
      document.getElementById('cardPreview').style.background = 'linear-gradient(135deg, #FF4DFF 0%, #A53CFF 100%)';
      document.getElementById('cardTypeIcon').textContent = '💳';
      document.getElementById('cardTypeIndicator').textContent = '💳';
      document.getElementById('cardTypeLabel').textContent = '';
    }
  }

  function closeAddPaymentModal() {
    const modal = document.getElementById('addPaymentMethodModal');
    if (modal) {
      modal.style.display = 'none';
    }
  }

  async function handleAddPayment(event) {
    event.preventDefault();
    
    const formData = new FormData(event.target);
    const data = {
      cardNumber: formData.get('cardNumber').replace(/\s/g, ''),
      cardHolder: formData.get('cardHolder'),
      expiryMonth: formData.get('expiryMonth'),
      expiryYear: formData.get('expiryYear'),
      cvv: formData.get('cvv'),
      setDefault: formData.get('setDefault') === 'on'
    };
    
    // Validate expiry
    const currentYear = new Date().getFullYear() % 100;
    const currentMonth = new Date().getMonth() + 1;
    const expYear = parseInt(data.expiryYear);
    const expMonth = parseInt(data.expiryMonth);
    
    if (expMonth < 1 || expMonth > 12) {
      alert('Invalid expiry month. Please enter a value between 01 and 12.');
      return;
    }
    
    if (expYear < currentYear || (expYear === currentYear && expMonth < currentMonth)) {
      alert('Card has expired. Please enter a valid expiry date.');
      return;
    }
    
    // Detect card type
    const cardInfo = detectCardType(data.cardNumber);
    data.cardType = cardInfo.type;
    
    try {
      const res = await fetch('/api/payment/add-method', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      
      const result = await res.json();
      
      if (res.ok && result.success) {
        alert('Payment method added successfully!');
        closeAddPaymentModal();
        window.location.reload();
      } else {
        alert(result.error || 'Failed to add payment method. Please try again.');
      }
    } catch (err) {
      console.error('Add payment error:', err);
      alert('Network error. Please try again.');
    }
  }

  // Close modal when clicking outside
  window.addEventListener('click', (e) => {
    const modal = document.getElementById('addPaymentMethodModal');
    if (modal && e.target === modal) {
      closeAddPaymentModal();
    }
  });

  // ==========================================
  // CONTACT SALES MODAL FUNCTIONALITY
  // ==========================================

  let currentSalesStep = 1;
  const totalSalesSteps = 4;
  let salesFormData = {};

  function openContactSalesModal() {
    const modal = document.getElementById('contactSalesModal');
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
    currentSalesStep = 1;
    updateSalesProgress();
    showSalesStep(1);
  }

  function closeContactSalesModal() {
    const modal = document.getElementById('contactSalesModal');
    modal.classList.remove('active');
    document.body.style.overflow = '';
    
    // Reset form after close animation
    setTimeout(() => {
      currentSalesStep = 1;
      updateSalesProgress();
      resetSalesForms();
      showSalesStep(1);
    }, 300);
  }

  function resetSalesForms() {
    document.getElementById('companyForm')?.reset();
    document.getElementById('contactForm')?.reset();
    document.getElementById('requirementsForm')?.reset();
    document.getElementById('additionalForm')?.reset();
    salesFormData = {};
  }

  function showSalesStep(step) {
    // Hide all steps
    for (let i = 1; i <= totalSalesSteps; i++) {
      const stepEl = document.getElementById(`salesStep${i}`);
      if (stepEl) stepEl.style.display = 'none';
    }
    const successEl = document.getElementById('salesStepSuccess');
    if (successEl) successEl.style.display = 'none';
    
    // Show current step
    const currentStepEl = document.getElementById(`salesStep${step}`);
    if (currentStepEl) {
      currentStepEl.style.display = 'block';
    }
    
    // Update progress indicators
    document.querySelectorAll('.progress-step').forEach((el, idx) => {
      el.classList.remove('active', 'completed');
      if (idx + 1 < step) {
        el.classList.add('completed');
      } else if (idx + 1 === step) {
        el.classList.add('active');
      }
    });
  }

  function updateSalesProgress() {
    const progressFill = document.getElementById('progressFill');
    if (progressFill) {
      const percentage = (currentSalesStep / totalSalesSteps) * 100;
      progressFill.style.width = percentage + '%';
    }
  }

  function collectFormData(formId) {
    const form = document.getElementById(formId);
    if (!form) return {};
    
    const formData = new FormData(form);
    const data = {};
    formData.forEach((value, key) => {
      data[key] = value;
    });
    return data;
  }

  function validateStep(step) {
    let formId;
    switch(step) {
      case 1: formId = 'companyForm'; break;
      case 2: formId = 'contactForm'; break;
      case 3: formId = 'requirementsForm'; break;
      case 4: formId = 'additionalForm'; break;
      default: return true;
    }
    
    const form = document.getElementById(formId);
    if (!form) return true;
    
    // Check HTML5 validation
    if (!form.checkValidity()) {
      form.reportValidity();
      return false;
    }
    
    return true;
  }

  function nextSalesStep(fromStep) {
    if (!validateStep(fromStep)) return;
    
    // Collect data from current step
    switch(fromStep) {
      case 1:
        Object.assign(salesFormData, collectFormData('companyForm'));
        break;
      case 2:
        Object.assign(salesFormData, collectFormData('contactForm'));
        break;
      case 3:
        Object.assign(salesFormData, collectFormData('requirementsForm'));
        break;
    }
    
    // Update summary if going to step 4
    if (fromStep === 3) {
      updateSalesSummary();
    }
    
    currentSalesStep = fromStep + 1;
    updateSalesProgress();
    showSalesStep(currentSalesStep);
  }

  function prevSalesStep(fromStep) {
    currentSalesStep = fromStep - 1;
    updateSalesProgress();
    showSalesStep(currentSalesStep);
  }

  function updateSalesSummary() {
    const summaryContent = document.getElementById('summaryContent');
    if (!summaryContent) return;
    
    const items = [
      { label: 'Company', value: salesFormData.companyName || '-' },
      { label: 'Industry', value: salesFormData.industry || '-' },
      { label: 'Company Size', value: salesFormData.companySize || '-' },
      { label: 'Contact', value: salesFormData.contactName || '-' },
      { label: 'Email', value: salesFormData.contactEmail || '-' },
      { label: 'Job Title', value: salesFormData.contactJobTitle || '-' },
      { label: 'Use Case', value: salesFormData.useCase?.replace(/_/g, ' ') || '-' },
      { label: 'Expected Users', value: salesFormData.expectedUsers || '-' },
      { label: 'Timeline', value: salesFormData.timeline?.replace(/_/g, ' ') || '-' },
      { label: 'Budget', value: salesFormData.budgetRange?.replace(/_/g, ' ') || '-' }
    ];
    
    summaryContent.innerHTML = items.map(item => `
      <div class="summary-item">
        <span class="label">${item.label}</span>
        <span class="value">${item.value}</span>
      </div>
    `).join('');
  }

  async function submitSalesInquiry() {
    const agreeCheckbox = document.getElementById('agreeToContact');
    if (!agreeCheckbox.checked) {
      alert('Please agree to be contacted by our sales team to proceed.');
      return;
    }
    
    // Collect final data
    const additionalInfo = document.getElementById('additionalInfo')?.value || '';
    const subscribeNewsletter = document.getElementById('subscribeNewsletter')?.checked || false;
    
    const submitBtn = document.getElementById('submitSalesBtn');
    const btnText = submitBtn.querySelector('.btn-text');
    const btnLoader = submitBtn.querySelector('.btn-loader');
    
    // Show loading state
    submitBtn.disabled = true;
    btnText.style.display = 'none';
    btnLoader.style.display = 'flex';
    
    const payload = {
      ...salesFormData,
      additionalInfo,
      subscribeNewsletter
    };
    
    try {
      const response = await fetch('/api/sales/inquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      
      const result = await response.json();
      
      if (response.ok && result.success) {
        // Show success state
        document.getElementById('confirmEmail').textContent = salesFormData.contactEmail;
        document.getElementById('inquiryRef').textContent = result.referenceId || 'ENT-' + Date.now();
        
        // Hide all steps, show success
        for (let i = 1; i <= totalSalesSteps; i++) {
          const stepEl = document.getElementById(`salesStep${i}`);
          if (stepEl) stepEl.style.display = 'none';
        }
        
        document.getElementById('salesStepSuccess').style.display = 'block';
        
        // Update progress to 100%
        document.getElementById('progressFill').style.width = '100%';
        document.querySelectorAll('.progress-step').forEach(el => {
          el.classList.add('completed');
        });
      } else {
        alert(result.error || 'Failed to submit inquiry. Please try again.');
        submitBtn.disabled = false;
        btnText.style.display = 'inline';
        btnLoader.style.display = 'none';
      }
    } catch (error) {
      console.error('Sales inquiry error:', error);
      alert('An error occurred. Please try again.');
      submitBtn.disabled = false;
      btnText.style.display = 'inline';
      btnLoader.style.display = 'none';
    }
  }

  // Close modal on overlay click
  document.addEventListener('click', function(e) {
    if (e.target.classList.contains('sales-modal-overlay')) {
      closeContactSalesModal();
    }
  });

  // Close modal on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const salesModal = document.getElementById('contactSalesModal');
      const checkoutModal = document.getElementById('checkoutModal');
      
      if (salesModal?.classList.contains('active')) {
        closeContactSalesModal();
      } else if (checkoutModal?.classList.contains('active')) {
        closeCheckout();
      }
    }
  });

  // Add card shine animation styles
  const additionalStyles = document.createElement('style');
  additionalStyles.textContent = `
    @keyframes cardShine {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100%); }
    }
  `;
  document.head.appendChild(additionalStyles);
</script>

