<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .rbac-page { max-width: 1400px; margin: 0 auto; padding: 20px; }
    .rbac-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 15px; }
    .rbac-header h1 { color: #333; margin: 0; }
    .rbac-nav { display: flex; gap: 10px; flex-wrap: wrap; }
    .rbac-nav a { padding: 8px 16px; background: #f5f5f5; border-radius: 6px; color: #333; text-decoration: none; font-size: 14px; }
    .rbac-nav a:hover, .rbac-nav a.active { background: #6366f1; color: white; }
    .tabs { display: flex; gap: 5px; margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 10px; }
    .tabs button { padding: 10px 20px; background: none; border: none; cursor: pointer; font-size: 14px; color: #666; border-radius: 6px 6px 0 0; }
    .tabs button.active { background: #6366f1; color: white; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }
    .panel { background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-bottom: 20px; }
    .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid #eee; }
    .panel-header h2 { margin: 0; font-size: 18px; color: #333; }
    .btn { padding: 8px 16px; border-radius: 6px; font-size: 14px; cursor: pointer; border: none; text-decoration: none; display: inline-block; }
    .btn-primary { background: #6366f1; color: white; }
    .btn-secondary { background: #e5e7eb; color: #333; }
    .markdown-content { font-size: 14px; line-height: 1.6; }
    .markdown-content h1 { font-size: 24px; border-bottom: 2px solid #eee; padding-bottom: 10px; margin: 30px 0 20px; }
    .markdown-content h2 { font-size: 20px; margin: 25px 0 15px; color: #333; }
    .markdown-content h3 { font-size: 16px; margin: 20px 0 10px; color: #444; }
    .markdown-content pre { background: #f5f5f5; padding: 15px; border-radius: 8px; overflow-x: auto; }
    .markdown-content code { background: #f0f0f0; padding: 2px 6px; border-radius: 4px; font-size: 13px; }
    .markdown-content table { width: 100%; border-collapse: collapse; margin: 15px 0; }
    .markdown-content th, .markdown-content td { padding: 10px; border: 1px solid #ddd; text-align: left; }
    .markdown-content th { background: #f9fafb; }
    .markdown-content ul, .markdown-content ol { padding-left: 25px; }
    .markdown-content li { margin: 5px 0; }
    .markdown-content blockquote { border-left: 4px solid #6366f1; padding-left: 15px; margin: 15px 0; color: #666; }
    .empty-state { text-align: center; padding: 40px; color: #888; }
    .copy-btn { float: right; padding: 5px 10px; font-size: 12px; }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  
  <main class="rbac-page">
    <div class="rbac-header">
      <h1>📚 RBAC Documentation</h1>
      <nav class="rbac-nav">
        <a href="/rbac/dashboard">Dashboard</a>
        <a href="/rbac/roles">Roles</a>
        <a href="/rbac/docs" class="active">Docs</a>
        <a href="/rbac/api/manifest" target="_blank">AI Manifest</a>
      </nav>
    </div>
    
    <div class="tabs">
      <button class="active" onclick="showTab('docs')">Documentation</button>
      <button onclick="showTab('changelog')">Changelog</button>
      <button onclick="showTab('manifest')">AI Manifest</button>
    </div>
    
    <!-- Documentation Tab -->
    <div id="tab-docs" class="tab-content active">
      <div class="panel">
        <div class="panel-header">
          <h2>Generated Documentation</h2>
          <button class="btn btn-secondary" onclick="downloadDocs()">Download Markdown</button>
        </div>
        
        <% if (documentation) { %>
        <div class="markdown-content" id="documentation">
          <%- documentation.replace(/</g, '&lt;').replace(/>/g, '&gt;')
              .replace(/^# (.+)$/gm, '<h1>$1</h1>')
              .replace(/^## (.+)$/gm, '<h2>$1</h2>')
              .replace(/^### (.+)$/gm, '<h3>$1</h3>')
              .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
              .replace(/`([^`]+)`/g, '<code>$1</code>')
              .replace(/^- (.+)$/gm, '<li>$1</li>')
              .replace(/^> (.+)$/gm, '<blockquote>$1</blockquote>')
              .replace(/\n\n/g, '</p><p>')
              .replace(/```([^`]+)```/gs, '<pre>$1</pre>')
              .replace(/\|(.+)\|/g, function(match) {
                const cells = match.split('|').filter(c => c.trim());
                return '<tr>' + cells.map(c => '<td>' + c.trim() + '</td>').join('') + '</tr>';
              })
          %>
        </div>
        <% } else { %>
        <div class="empty-state">
          <p>Documentation generation not available</p>
        </div>
        <% } %>
      </div>
    </div>
    
    <!-- Changelog Tab -->
    <div id="tab-changelog" class="tab-content">
      <div class="panel">
        <div class="panel-header">
          <h2>RBAC Changelog</h2>
          <button class="btn btn-secondary" onclick="downloadChangelog()">Download</button>
        </div>
        
        <% if (changelog) { %>
        <div class="markdown-content" id="changelog">
          <%- changelog.replace(/</g, '&lt;').replace(/>/g, '&gt;')
              .replace(/^# (.+)$/gm, '<h1>$1</h1>')
              .replace(/^## (.+)$/gm, '<h2>$1</h2>')
              .replace(/^- (.+)$/gm, '<li>$1</li>')
              .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
              .replace(/\n\n/g, '</p><p>')
          %>
        </div>
        <% } else { %>
        <div class="empty-state">
          <p>No changelog available</p>
        </div>
        <% } %>
      </div>
    </div>
    
    <!-- AI Manifest Tab -->
    <div id="tab-manifest" class="tab-content">
      <div class="panel">
        <div class="panel-header">
          <h2>AI Permission Manifest</h2>
          <a href="/rbac/api/manifest" target="_blank" class="btn btn-secondary">View JSON</a>
        </div>
        
        <p style="margin-bottom: 15px; color: #666;">
          This manifest provides a structured description of all permissions for AI agents and automated systems.
        </p>
        
        <div style="background: #f5f5f5; padding: 15px; border-radius: 8px; font-family: monospace; font-size: 13px;">
          <strong>Endpoint:</strong> GET /rbac/api/manifest<br><br>
          <strong>Use Cases:</strong>
          <ul>
            <li>AI agents understanding available capabilities</li>
            <li>Automated permission requests</li>
            <li>Explaining denied actions to users</li>
            <li>Integration with external systems</li>
          </ul>
        </div>
        
        <div style="margin-top: 20px;">
          <button class="btn btn-primary" onclick="loadManifestPreview()">Load Preview</button>
        </div>
        
        <pre id="manifestPreview" style="display: none; margin-top: 15px; max-height: 400px; overflow-y: auto;"></pre>
      </div>
    </div>
  </main>
  
  <%- include('partials/footer') %>
  
  <script>
    function showTab(tab) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tabs button').forEach(el => el.classList.remove('active'));
      document.getElementById('tab-' + tab).classList.add('active');
      event.target.classList.add('active');
    }
    
    function downloadDocs() {
      const content = `<%= documentation ? documentation.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/\n/g, '\\n') : '' %>`;
      const blob = new Blob([content.replace(/\\n/g, '\n').replace(/\\\\/g, '\\')], { type: 'text/markdown' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'rbac-documentation.md';
      a.click();
    }
    
    function downloadChangelog() {
      const content = `<%= changelog ? changelog.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/\n/g, '\\n') : '' %>`;
      const blob = new Blob([content.replace(/\\n/g, '\n').replace(/\\\\/g, '\\')], { type: 'text/markdown' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'rbac-changelog.md';
      a.click();
    }
    
    async function loadManifestPreview() {
      const preview = document.getElementById('manifestPreview');
      preview.style.display = 'block';
      preview.textContent = 'Loading...';
      
      try {
        const res = await fetch('/rbac/api/manifest');
        const data = await res.json();
        preview.textContent = JSON.stringify(data, null, 2);
      } catch (e) {
        preview.textContent = 'Error loading manifest: ' + e.message;
      }
    }
  </script>
</body>
</html>
