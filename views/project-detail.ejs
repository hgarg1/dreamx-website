<%- include('partials/header') %>

<style>
  .project-detail-layout {
    display: grid;
    grid-template-columns: 1fr 3fr 1fr;
    gap: 24px;
    max-width: 1600px;
    margin: 0 auto;
    padding: 24px;
  }

  .project-sidebar { flex: 1; }
  .project-content { flex: 3; }
  .project-right-sidebar { flex: 1; }

  .project-hero {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    padding: 48px 32px;
    border-radius: 20px;
    margin-bottom: 24px;
    position: relative;
    overflow: hidden;
  }

  .project-hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 300px;
    height: 300px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
  }

  .project-hero-content {
    position: relative;
    z-index: 1;
  }

  .project-hero h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0 0 12px 0;
  }

  .project-hero p {
    font-size: 1.125rem;
    opacity: 0.95;
    margin: 0;
  }

  .project-actions {
    display: flex;
    gap: 12px;
    margin-top: 20px;
  }

  .action-btn {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border: 2px solid white;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .action-btn:hover {
    background: white;
    color: #764ba2;
  }

  .project-nav-tabs {
    display: flex;
    gap: 0;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    margin-bottom: 24px;
  }

  .nav-tab {
    flex: 1;
    padding: 16px;
    background: white;
    border: none;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    font-weight: 600;
    text-align: center;
    transition: all 0.3s ease;
    color: #6b7280;
  }

  .nav-tab.active {
    color: #ff4fa3;
    border-bottom-color: #ff4fa3;
  }

  .nav-tab:hover {
    background: #f9fafb;
  }

  .tab-content { display: none; }
  .tab-content.active { display: block; }

  .milestone-item {
    background: white;
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 16px;
    border-left: 4px solid #ff4fa3;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .milestone-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .milestone-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #111827;
    margin: 0;
  }

  .milestone-date {
    color: #6b7280;
    font-size: 0.9rem;
  }

  .task-item {
    background: #f9fafb;
    padding: 16px;
    border-radius: 8px;
    margin-bottom: 12px;
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .task-checkbox {
    width: 20px;
    height: 20px;
    cursor: pointer;
    margin-top: 2px;
  }

  .task-content {
    flex: 1;
  }

  .task-title {
    font-weight: 600;
    color: #111827;
    margin-bottom: 4px;
  }

  .task-meta {
    display: flex;
    gap: 12px;
    font-size: 0.85rem;
    color: #6b7280;
  }

  .priority-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.75rem;
  }

  .priority-high { background: #fee2e2; color: #991b1b; }
  .priority-medium { background: #fef3c7; color: #b45309; }
  .priority-low { background: #dbeafe; color: #1e40af; }

  .update-card {
    background: white;
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    border: 1px solid #e5e7eb;
  }

  .update-header {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-bottom: 12px;
  }

  .update-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
  }

  .update-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex: 1;
  }

  .update-author {
    font-weight: 600;
    color: #111827;
  }

  .update-date {
    color: #6b7280;
    font-size: 0.85rem;
  }

  .update-content {
    color: #374151;
    line-height: 1.6;
    margin: 12px 0;
  }

  .update-engagement {
    display: flex;
    gap: 16px;
    padding-top: 12px;
    border-top: 1px solid #e5e7eb;
    font-size: 0.9rem;
    color: #6b7280;
  }

  .engagement-btn {
    background: none;
    border: none;
    cursor: pointer;
    color: #6b7280;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s;
  }

  .engagement-btn:hover {
    color: #ff4fa3;
  }

  .sidebar-card {
    background: white;
    padding: 20px;
    border-radius: 12px;
    margin-bottom: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .sidebar-card h3 {
    font-size: 1rem;
    font-weight: 800;
    margin: 0 0 16px 0;
    color: #111827;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid #e5e7eb;
  }

  .info-row:last-child { border-bottom: none; }

  .info-label {
    color: #6b7280;
    font-weight: 500;
  }

  .info-value {
    color: #111827;
    font-weight: 600;
  }

  .member-list {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .member-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    cursor: pointer;
  }

  .edit-btn, .delete-btn {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 8px;
  }

  .edit-btn {
    background: linear-gradient(135deg, #ff4fa3, #764ba2);
    color: white;
  }

  .edit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(255, 79, 163, 0.3);
  }

  .delete-btn {
    background: #fee2e2;
    color: #991b1b;
  }

  .delete-btn:hover {
    background: #fecaca;
  }

  @media (max-width: 1200px) {
    .project-detail-layout {
      grid-template-columns: 1fr 2fr;
    }
    .project-right-sidebar { display: none; }
  }

  @media (max-width: 768px) {
    .project-detail-layout {
      grid-template-columns: 1fr;
    }
    .project-sidebar { display: none; }
    .project-hero h1 { font-size: 1.75rem; }
  }
</style>

<div class="project-detail-layout">
  <!-- Left Sidebar -->
  <aside class="project-sidebar">
    <a href="/projects" style="color: #ff4fa3; text-decoration: none; font-weight: 600; margin-bottom: 20px; display: inline-block;">
      ← Back to projects
    </a>

    <% if (isOwner) { %>
      <button class="edit-btn" onclick="window.location.href='/projects/<%= project.id %>/edit'">
        ✏️ Edit Project
      </button>
      <button class="delete-btn" onclick="if(confirm('Are you sure?')) fetch('/api/projects/<%= project.id %>', {method: 'DELETE'}).then(() => window.location.href='/projects')">
        🗑️ Delete
      </button>
    <% } %>
  </aside>

  <!-- Main Content -->
  <main class="project-content">
    <!-- Hero Section -->
    <div class="project-hero">
      <div class="project-hero-content">
        <h1><%= project.title %></h1>
        <p><%= project.description %></p>
        
        <div class="project-actions">
          <% if (project.status) { %>
            <button class="action-btn" style="background: rgba(255, 255, 255, 0.3);">
              <%= project.status.toUpperCase() %>
            </button>
          <% } %>
          
          <% if (project.progress_percent) { %>
            <button class="action-btn" style="background: rgba(255, 255, 255, 0.3);">
              <%= project.progress_percent %>% Complete
            </button>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Tabs -->
    <div class="project-nav-tabs">
      <button class="nav-tab active" onclick="switchTab(this, 'overview')">
        📋 Overview
      </button>
      <button class="nav-tab" onclick="switchTab(this, 'milestones')">
        🎯 Milestones
      </button>
      <button class="nav-tab" onclick="switchTab(this, 'tasks')">
        ✓ Tasks
      </button>
      <button class="nav-tab" onclick="switchTab(this, 'updates')">
        📝 Updates
      </button>
    </div>

    <!-- Overview Tab -->
    <div class="tab-content active" id="overview">
      <% 
        // Tags and goals are already parsed arrays from the route handler
        const tags = project.tags || [];
        const goals = project.goals || [];
      %>

      <% if (tags.length > 0) { %>
        <div style="background: white; padding: 20px; border-radius: 12px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);">
          <h3 style="margin: 0 0 12px 0; font-weight: 700; color: #111827;">🏷️ Tags</h3>
          <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <% tags.forEach(tag => { %>
              <span style="background: linear-gradient(135deg, rgba(255, 79, 163, 0.1), rgba(118, 75, 162, 0.1)); color: #ec4899; padding: 6px 14px; border-radius: 999px; font-weight: 600; font-size: 0.9rem;">
                <%= tag %>
              </span>
            <% }); %>
          </div>
        </div>
      <% } %>

      <% if (goals.length > 0) { %>
        <div style="background: white; padding: 20px; border-radius: 12px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);">
          <h3 style="margin: 0 0 12px 0; font-weight: 700; color: #111827;">🎯 Goals</h3>
          <ul style="margin: 0; padding-left: 20px; color: #374151; line-height: 1.8;">
            <% goals.forEach(goal => { %>
              <li><%= goal %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <% if (project.progress_percent > 0) { %>
        <div style="background: white; padding: 20px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);">
          <h3 style="margin: 0 0 12px 0; font-weight: 700;">Progress</h3>
          <div style="background: #e5e7eb; height: 16px; border-radius: 8px; overflow: hidden;">
            <div style="background: linear-gradient(90deg, #ff4fa3, #764ba2); height: 100%; width: <%= project.progress_percent %>%;"></div>
          </div>
          <p style="margin: 12px 0 0 0; color: #6b7280;">
            <strong style="color: #111827;"><%= project.progress_percent %>%</strong> complete
          </p>
        </div>
      <% } %>
    </div>

    <!-- Milestones Tab -->
    <div class="tab-content" id="milestones">
      <% if (milestones && milestones.length > 0) { %>
        <% milestones.forEach(milestone => { %>
          <div class="milestone-item">
            <div class="milestone-header">
              <h3 class="milestone-title"><%= milestone.title %></h3>
              <span class="milestone-date"><%= milestone.due_date ? new Date(milestone.due_date).toLocaleDateString() : 'No date' %></span>
            </div>
            <p style="color: #6b7280; margin: 0; line-height: 1.6;">
              <%= milestone.description || 'No description' %>
            </p>
            <% if (milestone.status) { %>
              <span style="display: inline-block; margin-top: 8px; padding: 4px 12px; background: rgba(255, 79, 163, 0.1); color: #ec4899; border-radius: 4px; font-size: 0.85rem; font-weight: 600;">
                <%= milestone.status %>
              </span>
            <% } %>
          </div>
        <% }); %>
      <% } else { %>
        <div style="background: white; padding: 32px; border-radius: 12px; text-align: center; color: #6b7280;">
          <p style="margin: 0;">No milestones yet</p>
        </div>
      <% } %>
    </div>

    <!-- Tasks Tab -->
    <div class="tab-content" id="tasks">
      <% if (tasks && tasks.length > 0) { %>
        <% tasks.forEach(task => { %>
          <div class="task-item">
            <input type="checkbox" class="task-checkbox" <% if (task.status === 'completed') { %>checked<% } %>>
            <div class="task-content">
              <div class="task-title"><%= task.title %></div>
              <div class="task-meta">
                <% if (task.priority) { %>
                  <span class="priority-badge priority-<%= task.priority %>">
                    <%= task.priority.toUpperCase() %>
                  </span>
                <% } %>
                <% if (task.due_date) { %>
                  <span>📅 <%= new Date(task.due_date).toLocaleDateString() %></span>
                <% } %>
                <% if (task.assigned_to_name) { %>
                  <span>👤 <%= task.assigned_to_name %></span>
                <% } %>
              </div>
              <% if (task.description) { %>
                <p style="margin: 8px 0 0 0; color: #6b7280;">
                  <%= task.description %>
                </p>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div style="background: white; padding: 32px; border-radius: 12px; text-align: center; color: #6b7280;">
          <p style="margin: 0;">No tasks yet</p>
        </div>
      <% } %>
    </div>

    <!-- Updates Tab -->
    <div class="tab-content" id="updates">
      <% if (updates && updates.length > 0) { %>
        <% updates.forEach(update => { %>
          <div class="update-card" data-update-id="<%= update.id %>">
            <div class="update-header">
              <% if (update.profile_picture) { %>
                <img src="/uploads/<%= update.profile_picture %>" alt="<%= update.full_name %>" class="update-avatar">
              <% } else { %>
                <div class="update-avatar" style="background: linear-gradient(135deg, #667eea, #764ba2); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700;">
                  <%= update.full_name.charAt(0) %>
                </div>
              <% } %>
              
              <div class="update-meta">
                <div>
                  <div class="update-author"><%= update.full_name %></div>
                  <div class="update-date"><%= new Date(update.created_at).toLocaleDateString() %></div>
                </div>
              </div>
            </div>

            <div class="update-content">
              <%= update.content %>
            </div>

            <div class="update-engagement">
              <button class="engagement-btn" onclick="reactToUpdate(<%= update.id %>, 'like')">
                👍 <span><%= update.reaction_count || 0 %></span>
              </button>
              <button class="engagement-btn" onclick="toggleCommentSection(this, <%= update.id %>)">
                💬 <span><%= update.comment_count || 0 %></span>
              </button>
            </div>

            <!-- Comments Section -->
            <div class="update-comments-section" style="display: none; margin-top: 16px; padding-top: 16px; border-top: 1px solid #e5e7eb;">
              <!-- Comment Form -->
              <% if (project.visibility === 'public' || isOwner) { %>
              <div class="comment-form" style="margin-bottom: 16px;">
                <textarea 
                  class="comment-input" 
                  placeholder="Add a comment..." 
                  style="width: 100%; min-height: 80px; padding: 12px; border: 1px solid #d1d5db; border-radius: 8px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 0.9rem; resize: vertical;"
                ></textarea>
                <div style="display: flex; gap: 8px; margin-top: 8px;">
                  <button onclick="submitComment(this, <%= update.id %>)" style="flex: 1; padding: 8px 12px; background: #ec4899; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600;">
                    Post Comment
                  </button>
                  <label style="padding: 8px 12px; background: #f3f4f6; border: 1px solid #d1d5db; border-radius: 6px; cursor: pointer; font-weight: 500; display: flex; align-items: center; gap: 6px;">
                    📎 Attach File
                    <input type="file" style="display: none;" class="comment-file-input" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.png,.gif,.webp,.mp4,.webm,.zip">
                  </label>
                </div>
                <div class="attached-files" style="margin-top: 8px; display: flex; flex-wrap: wrap; gap: 6px;"></div>
              </div>
              <% } %>

              <!-- Comments List -->
              <div class="comments-list" style="max-height: 400px; overflow-y: auto;">
                <!-- Comments will be loaded here -->
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div style="background: white; padding: 32px; border-radius: 12px; text-align: center; color: #6b7280;">
          <p style="margin: 0;">No updates yet</p>
        </div>
      <% } %>
    </div>
  </main>

  <!-- Right Sidebar -->
  <aside class="project-right-sidebar">
    <!-- Project Info -->
    <div class="sidebar-card">
      <h3>📊 Project Info</h3>
      
      <div class="info-row">
        <span class="info-label">Owner</span>
        <span class="info-value" style="cursor: pointer;" onclick="window.location.href='/profile/<%= project.owner_id %>'">
          <%= project.owner_name %>
        </span>
      </div>

      <div class="info-row">
        <span class="info-label">Status</span>
        <span class="info-value"><%= project.status || 'Not set' %></span>
      </div>

      <div class="info-row">
        <span class="info-label">Visibility</span>
        <span class="info-value"><%= project.visibility || 'Public' %></span>
      </div>

      <div class="info-row">
        <span class="info-label">Created</span>
        <span class="info-value"><%= new Date(project.created_at).toLocaleDateString() %></span>
      </div>

      <% if (project.target_completion_date) { %>
        <div class="info-row">
          <span class="info-label">Target Date</span>
          <span class="info-value"><%= new Date(project.target_completion_date).toLocaleDateString() %></span>
        </div>
      <% } %>
    </div>

    <!-- Statistics -->
    <div class="sidebar-card">
      <h3>📈 Stats</h3>
      
      <div class="info-row">
        <span class="info-label">Views</span>
        <span class="info-value"><%= project.view_count || 0 %></span>
      </div>

      <div class="info-row">
        <span class="info-label">Updates</span>
        <span class="info-value"><%= updates ? updates.length : 0 %></span>
      </div>

      <div class="info-row">
        <span class="info-label">Milestones</span>
        <span class="info-value"><%= milestones ? milestones.length : 0 %></span>
      </div>

      <div class="info-row">
        <span class="info-label">Tasks</span>
        <span class="info-value"><%= tasks ? tasks.length : 0 %></span>
      </div>
    </div>

    <!-- Team Members -->
    <% 
      // team_members is already parsed as an array from the route handler
      const teamMembers = project.team_members || [];
      if (teamMembers.length > 0) {
    %>
      <div class="sidebar-card">
        <h3>👥 Team</h3>
        <div class="member-list">
          <% teamMembers.forEach(member => { %>
            <div title="<%= member.name %>" style="cursor: help;">
              <div style="width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #667eea, #764ba2); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem;">
                <%= member.name ? member.name.charAt(0) : '?' %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>
  </aside>
</div>

<script>
  function switchTab(button, tabId) {
    // Hide all tabs
    document.querySelectorAll('.tab-content').forEach(tab => {
      tab.classList.remove('active');
    });

    // Remove active from all buttons
    document.querySelectorAll('.nav-tab').forEach(btn => {
      btn.classList.remove('active');
    });

    // Show selected tab
    document.getElementById(tabId).classList.add('active');
    button.classList.add('active');
  }

  function reactToUpdate(updateId, reactionType) {
    fetch(`/api/projects/<%= project.id %>/updates/${updateId}/react`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ type: reactionType })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        location.reload();
      }
    })
    .catch(err => console.error('Error:', err));
  }

  // Toggle comment section visibility
  function toggleCommentSection(button, updateId) {
    const section = button.closest('.update-card').querySelector('.update-comments-section');
    if (section) {
      const isVisible = section.style.display !== 'none';
      section.style.display = isVisible ? 'none' : 'block';
      if (!isVisible) {
        loadComments(updateId);
      }
    }
  }

  // Load comments for an update
  function loadComments(updateId) {
    fetch(`/api/projects/<%= project.id %>/updates/${updateId}/comments`, {
      method: 'GET'
    })
    .then(res => res.json())
    .then(data => {
      const section = document.querySelector(`[data-update-id="${updateId}"] .comments-list`);
      if (section && data.comments) {
        section.innerHTML = data.comments.map(comment => `
          <div class="comment-item" style="padding: 12px; background: #f9fafb; border-radius: 8px; margin-bottom: 8px;">
            <div style="display: flex; gap: 8px;">
              <div style="width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #667eea, #764ba2); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem; flex-shrink: 0;">
                ${comment.full_name.charAt(0)}
              </div>
              <div style="flex: 1;">
                <div style="font-weight: 600; font-size: 0.9rem;">${comment.full_name}</div>
                <div style="font-size: 0.85rem; color: #6b7280;">${new Date(comment.created_at).toLocaleString()}</div>
                <div style="margin-top: 6px; color: #374151;">${comment.content}</div>
                ${comment.files && comment.files.length > 0 ? `
                  <div style="margin-top: 8px; display: flex; flex-wrap: wrap; gap: 6px;">
                    ${comment.files.map(file => `
                      <a href="${file.file_url}" target="_blank" style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; background: white; border: 1px solid #d1d5db; border-radius: 4px; font-size: 0.85rem; color: #ec4899; text-decoration: none;">
                        📎 ${file.file_name}
                      </a>
                    `).join('')}
                  </div>
                ` : ''}
                <div style="margin-top: 8px; display: flex; gap: 8px;">
                  <button onclick="starComment(${comment.id}, ${updateId})" style="padding: 4px 8px; background: none; border: 1px solid #d1d5db; border-radius: 4px; cursor: pointer; font-size: 0.9rem;">
                    ⭐ Star
                  </button>
                </div>
              </div>
            </div>
          </div>
        `).join('');
      }
    })
    .catch(err => console.error('Error loading comments:', err));
  }

  // Submit a new comment
  function submitComment(button, updateId) {
    const form = button.closest('.comment-form');
    const textarea = form.querySelector('.comment-input');
    const fileInput = form.querySelector('.comment-file-input');
    const content = textarea.value.trim();
    
    if (!content) {
      alert('Please enter a comment');
      return;
    }

    const formData = new FormData();
    formData.append('content', content);
    
    // Add files if selected
    if (fileInput && fileInput.files && fileInput.files.length > 0) {
      for (let file of fileInput.files) {
        formData.append('files', file);
      }
    }

    fetch(`/api/projects/<%= project.id %>/updates/${updateId}/comments`, {
      method: 'POST',
      body: formData
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        textarea.value = '';
        if (fileInput) fileInput.value = '';
        form.querySelector('.attached-files').innerHTML = '';
        loadComments(updateId);
      } else {
        alert('Error: ' + (data.error || 'Failed to post comment'));
      }
    })
    .catch(err => {
      console.error('Error posting comment:', err);
      alert('Error posting comment');
    });
  }

  // Star a comment
  function starComment(commentId, updateId) {
    fetch(`/api/projects/<%= project.id %>/updates/${updateId}/comments/${commentId}/react`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ type: 'star' })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        loadComments(updateId);
      }
    })
    .catch(err => console.error('Error starring comment:', err));
  }

</script>

