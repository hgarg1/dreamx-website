</style>

<div class="comments-section" id="comments-section-<%= projectId %>">
  <!-- Comment Form -->
  <% if (canComment) { %>
  <div class="comment-form">
    <textarea 
      class="comment-input" 
      placeholder="Share your thoughts..."
      data-project-id="<%= projectId %>"
    ></textarea>
    <div class="comment-actions">
      <button 
        class="comment-submit-btn" 
        onclick="submitComment(<%= projectId %>)"
      >
        💬 Post Comment
      </button>
      <label class="comment-attach-btn">
        📎 Attach Files
        <input 
          type="file" 
          style="display: none;" 
          class="comment-file-input" 
          data-project-id="<%= projectId %>"
          accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.zip"
          multiple
          onchange="handleFileSelect(this, <%= projectId %>)"
        >
      </label>
    </div>
    <div class="attached-files-preview" id="attached-files-<%= projectId %>"></div>
  </div>
  <% } %>

  <!-- Comments List -->
  <div class="comments-list" id="comments-list-<%= projectId %>">
    <!-- Comments will be loaded here dynamically -->
  </div>
</div>

<script>
// File management for comments
const commentFiles = new Map();

function handleFileSelect(input, projectId) {
  const files = Array.from(input.files);
  if (!commentFiles.has(projectId)) {
    commentFiles.set(projectId, []);
  }
  commentFiles.get(projectId).push(...files);
  renderAttachedFiles(projectId);
}

function removeAttachedFile(projectId, index) {
  const files = commentFiles.get(projectId) || [];
  files.splice(index, 1);
  commentFiles.set(projectId, files);
  renderAttachedFiles(projectId);
}

function renderAttachedFiles(projectId) {
  const container = document.getElementById(`attached-files-${projectId}`);
  const files = commentFiles.get(projectId) || [];
  
  container.innerHTML = files.map((file, index) => `
    <div class="attached-file-item">
      <span class="attached-file-name" title="${escapeHtml(file.name)}">${escapeHtml(file.name)}</span>
      <button class="remove-file-btn" onclick="removeAttachedFile(${projectId}, ${index})">×</button>
    </div>
  `).join('');
}

function getFileIcon(mimeType) {
  if (mimeType.startsWith('image/')) return '🖼️';
  if (mimeType.startsWith('video/')) return '🎥';
  if (mimeType.startsWith('audio/')) return '🎵';
  if (mimeType.includes('pdf')) return '📄';
  if (mimeType.includes('word') || mimeType.includes('document')) return '📝';
  if (mimeType.includes('excel') || mimeType.includes('spreadsheet')) return '📊';
  if (mimeType.includes('zip') || mimeType.includes('compress')) return '📦';
  return '📎';
}

function canPreviewFile(mimeType) {
  return mimeType.startsWith('image/');
}

function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

function formatDate(dateString) {
  const date = new Date(dateString);
  const now = new Date();
  const diff = now - date;
  const seconds = Math.floor(diff / 1000);
  const minutes = Math.floor(seconds / 60);
  const hours = Math.floor(minutes / 60);
  const days = Math.floor(hours / 24);

  if (seconds < 60) return 'just now';
  if (minutes < 60) return `${minutes}m ago`;
  if (hours < 24) return `${hours}h ago`;
  if (days < 7) return `${days}d ago`;
  return date.toLocaleDateString();
}

function submitComment(projectId, parentId = null) {
  const section = document.getElementById(`comments-section-${projectId}`);
  const textarea = parentId 
    ? section.querySelector(`#reply-input-${parentId}`)
    : section.querySelector(`.comment-input[data-project-id="${projectId}"]`);
  
  const content = textarea.value.trim();
  
  if (!content && (!commentFiles.has(projectId) || commentFiles.get(projectId).length === 0)) {
    alert('Please enter a comment or attach a file');
    return;
  }

  const formData = new FormData();
  if (content) formData.append('content', content);
  if (parentId) formData.append('parentId', parentId);
  
  const files = commentFiles.get(projectId) || [];
  files.forEach(file => formData.append('files', file));

  const submitBtn = parentId
    ? section.querySelector(`#reply-submit-${parentId}`)
    : section.querySelector('.comment-submit-btn');
    
  submitBtn.disabled = true;
  submitBtn.textContent = '⏳ Posting...';

  fetch(`/api/projects/<%= projectId %>/comments`, {
    method: 'POST',
    body: formData
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      textarea.value = '';
      commentFiles.delete(projectId);
      renderAttachedFiles(projectId);
      
      if (parentId) {
        const replyForm = document.getElementById(`reply-form-${parentId}`);
        if (replyForm) replyForm.classList.remove('active');
      }
      
      loadComments(projectId);
    } else {
      alert('Error: ' + (data.error || 'Failed to post comment'));
    }
  })
  .catch(err => {
    console.error('Error posting comment:', err);
    alert('Error posting comment');
  })
  .finally(() => {
    submitBtn.disabled = false;
    submitBtn.textContent = parentId ? '💬 Reply' : '💬 Post Comment';
  });
}

function loadComments(projectId) {
  fetch(`/api/projects/<%= projectId %>/comments`)
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      renderComments(projectId, data.comments);
    }
  })
  .catch(err => console.error('Error loading comments:', err));
}

function renderComments(projectId, comments) {
  const container = document.getElementById(`comments-list-${projectId}`);
  
  if (!comments || comments.length === 0) {
    container.innerHTML = `
      <div style="text-align: center; padding: 32px; color: #9ca3af;">
        <p style="margin: 0;">No comments yet. Be the first to comment!</p>
      </div>
    `;
    return;
  }

  container.innerHTML = comments.map(comment => renderComment(comment, projectId)).join('');
}

function renderComment(comment, projectId) {
  const starCount = comment.reactions.find(r => r.reaction_type === 'star')?.count || 0;
  const hasStarred = comment.userReaction === 'star';
  
  const badges = [];
  if (comment.is_pinned) badges.push('<span class="comment-badge badge-pinned">📌 Pinned</span>');
  if (comment.is_hidden) badges.push('<span class="comment-badge badge-hidden">👁️ Hidden</span>');
  if (comment.role === 'admin' || comment.role === 'super_admin') {
    badges.push('<span class="comment-badge badge-admin">Admin</span>');
  }

  const files = comment.files || [];
  const filesHtml = files.length > 0 ? `
    <div class="comment-files">
      ${files.map(file => {
        if (canPreviewFile(file.file_type)) {
          return `
            <a href="${file.file_url}" target="_blank" class="comment-file-preview">
              <img src="${file.file_url}" alt="${escapeHtml(file.file_name)}">
            </a>
          `;
        } else {
          return `
            <a href="${file.file_url}" target="_blank" class="comment-file-link" download>
              <span class="file-icon">${getFileIcon(file.file_type)}</span>
              <span class="file-name">${escapeHtml(file.file_name)}</span>
            </a>
          `;
        }
      }).join('')}
    </div>
  ` : '';

  return `
    <div class="comment-item ${comment.is_pinned ? 'pinned' : ''} ${comment.is_hidden ? 'hidden' : ''}" id="comment-${comment.id}">
      <div class="comment-header">
        ${comment.profile_picture 
          ? `<img src="/uploads/${comment.profile_picture}" alt="${escapeHtml(comment.full_name)}" class="comment-avatar">`
          : `<div class="comment-avatar-placeholder">${comment.full_name.charAt(0).toUpperCase()}</div>`
        }
        
        <div class="comment-content-wrapper">
          <div class="comment-meta">
            <div class="comment-author-info">
              <span class="comment-author">${escapeHtml(comment.full_name)}</span>
              ${badges.join('')}
              <span class="comment-date">${formatDate(comment.created_at)}</span>
              ${comment.edited_at ? '<span class="comment-edited">(edited)</span>' : ''}
            </div>
            
            ${comment.permissions && (comment.permissions.canEdit || comment.permissions.canDelete || comment.permissions.canPin || comment.permissions.canHide) ? `
              <div style="position: relative;">
                <button class="comment-menu-btn" onclick="toggleCommentMenu(${comment.id})">⋯</button>
                <div class="comment-dropdown" id="comment-menu-${comment.id}">
                  ${comment.permissions.canEdit ? `
                    <button class="comment-dropdown-item" onclick="editComment(${comment.id}, ${projectId})">
                      ✏️ Edit
                    </button>
                  ` : ''}
                  ${comment.permissions.canPin ? `
                    <button class="comment-dropdown-item" onclick="togglePin(${comment.id}, ${projectId}, ${!comment.is_pinned})">
                      ${comment.is_pinned ? '📌 Unpin' : '📌 Pin'}
                    </button>
                  ` : ''}
                  ${comment.permissions.canHide ? `
                    <button class="comment-dropdown-item" onclick="toggleHide(${comment.id}, ${projectId}, ${!comment.is_hidden})">
                      ${comment.is_hidden ? '👁️ Unhide' : '🚫 Hide'}
                    </button>
                  ` : ''}
                  ${comment.permissions.canDelete ? `
                    <button class="comment-dropdown-item danger" onclick="deleteComment(${comment.id}, ${projectId})">
                      🗑️ Delete
                    </button>
                  ` : ''}
                </div>
              </div>
            ` : ''}
          </div>
          
          <div class="comment-text">${escapeHtml(comment.content)}</div>
          
          ${filesHtml}
          
          <div class="comment-footer">
            <button class="comment-action-btn ${hasStarred ? 'active' : ''}" onclick="toggleStar(${comment.id}, ${projectId})">
              ⭐ ${starCount > 0 ? starCount : ''} Star
            </button>
            ${comment.permissions && comment.permissions.canReply ? `
              <button class="comment-action-btn" onclick="toggleReplyForm(${comment.id})">
                💬 Reply ${comment.replyCount > 0 ? `(${comment.replyCount})` : ''}
              </button>
            ` : ''}
            ${comment.replyCount > 0 ? `
              <button class="comment-action-btn" onclick="loadReplies(${comment.id}, ${projectId})">
                👁️ View Replies
              </button>
            ` : ''}
          </div>
          
          <!-- Reply Form -->
          <div class="reply-form" id="reply-form-${comment.id}">
            <div class="comment-form" style="margin: 0;">
              <textarea 
                class="comment-input" 
                id="reply-input-${comment.id}"
                placeholder="Write a reply..."
                style="min-height: 60px;"
              ></textarea>
              <div class="comment-actions">
                <button class="comment-submit-btn" id="reply-submit-${comment.id}" onclick="submitComment(${projectId}, ${comment.id})">
                  💬 Reply
                </button>
              </div>
            </div>
          </div>
          
          <!-- Replies Section -->
          <div class="replies-section" id="replies-${comment.id}" style="display: none;"></div>
        </div>
      </div>
    </div>
  `;
}

function toggleCommentMenu(commentId) {
  const menu = document.getElementById(`comment-menu-${commentId}`);
  const allMenus = document.querySelectorAll('.comment-dropdown');
  allMenus.forEach(m => {
    if (m !== menu) m.classList.remove('active');
  });
  menu.classList.toggle('active');
}

function toggleReplyForm(commentId) {
  const form = document.getElementById(`reply-form-${commentId}`);
  form.classList.toggle('active');
  if (form.classList.contains('active')) {
    document.getElementById(`reply-input-${commentId}`).focus();
  }
}

function toggleStar(commentId, projectId) {
  fetch(`/api/projects/<%= projectId %>/comments/${commentId}/react`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ type: 'star' })
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      loadComments(projectId);
    }
  })
  .catch(err => console.error('Error starring comment:', err));
}

function editComment(commentId, projectId) {
  const commentEl = document.getElementById(`comment-${commentId}`);
  const textEl = commentEl.querySelector('.comment-text');
  const currentText = textEl.textContent;
  
  const newText = prompt('Edit comment:', currentText);
  if (newText && newText.trim() && newText !== currentText) {
    fetch(`/api/projects/<%= projectId %>/comments/${commentId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ content: newText.trim() })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        loadComments(projectId);
      } else {
        alert('Error: ' + (data.error || 'Failed to edit comment'));
      }
    })
    .catch(err => {
      console.error('Error editing comment:', err);
      alert('Error editing comment');
    });
  }
}

function deleteComment(commentId, projectId) {
  if (!confirm('Are you sure you want to delete this comment?')) return;
  
  fetch(`/api/projects/<%= projectId %>/comments/${commentId}`, {
    method: 'DELETE'
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      loadComments(projectId);
    } else {
      alert('Error: ' + (data.error || 'Failed to delete comment'));
    }
  })
  .catch(err => {
    console.error('Error deleting comment:', err);
    alert('Error deleting comment');
  });
}

function togglePin(commentId, projectId, isPinned) {
  fetch(`/api/projects/<%= projectId %>/comments/${commentId}/pin`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ isPinned })
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      loadComments(projectId);
    }
  })
  .catch(err => console.error('Error pinning comment:', err));
}

function toggleHide(commentId, projectId, isHidden) {
  fetch(`/api/projects/<%= projectId %>/comments/${commentId}/hide`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ isHidden })
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      loadComments(projectId);
    }
  })
  .catch(err => console.error('Error hiding comment:', err));
}

function loadReplies(commentId, projectId) {
  const repliesSection = document.getElementById(`replies-${commentId}`);
  
  if (repliesSection.style.display === 'block') {
    repliesSection.style.display = 'none';
    return;
  }
  
  fetch(`/api/projects/<%= projectId %>/comments/${commentId}/replies`)
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      repliesSection.innerHTML = data.replies.map(reply => renderComment(reply, projectId)).join('');
      repliesSection.style.display = 'block';
    }
  })
  .catch(err => console.error('Error loading replies:', err));
}

// Close dropdowns when clicking outside
document.addEventListener('click', (e) => {
  if (!e.target.closest('.comment-menu-btn') && !e.target.closest('.comment-dropdown')) {
    document.querySelectorAll('.comment-dropdown').forEach(m => m.classList.remove('active'));
  }
});
</script>
