<!-- Forgot Password SMS Recovery Modal -->
<div id="forgotPasswordSmsModal" class="modal-overlay" style="display: none;">
  <div class="modal-content forgot-password-modal">
    <!-- Close Button -->
    <button class="modal-close" id="forgotPasswordModalClose" type="button" aria-label="Close">×</button>
    
    <!-- Header -->
    <div class="modal-header">
      <div class="modal-icon">📲</div>
      <h2>Recover Password via SMS</h2>
      <p>Verify your identity with a text message</p>
    </div>
    
    <!-- Body -->
    <div class="modal-body">
      <!-- Phone Verification Step -->
      <div id="forgotPasswordPhoneStep" class="modal-step">
        <div class="step-indicator">
          <div class="step active">1</div>
          <div class="step-line"></div>
          <div class="step">2</div>
          <div class="step-line"></div>
          <div class="step">3</div>
          <div class="step-line"></div>
          <div class="step">4</div>
        </div>
        <form id="forgotPasswordPhoneForm">
          <div class="form-group">
            <label for="forgotPasswordPhoneInput">Phone Number</label>
            <input 
              type="tel" 
              id="forgotPasswordPhoneInput" 
              class="form-control" 
              placeholder="+1 (555) 000-0000"
              autocomplete="tel"
              pattern="[0-9\-\+\s\(\)]{10,}"
              required
            />
            <small>We'll send a verification code to this number</small>
          </div>
          
          <div id="forgotPasswordPhoneError" class="alert alert-danger" style="display: none;"></div>
          <div id="forgotPasswordPhoneRateLimit" class="alert alert-warning" style="display: none;"></div>
          
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="forgotPasswordPhoneCancel">Back to Email</button>
            <button type="submit" class="btn btn-primary" id="forgotPasswordPhoneSend">Send Code</button>
          </div>
        </form>
      </div>
      
      <!-- Code Verification Step -->
      <div id="forgotPasswordCodeStep" class="modal-step" style="display: none;">
        <div class="phone-display-mini">
          <p>Code sent to:</p>
          <p id="forgotPasswordPhoneDisplay" class="phone-number-display"></p>
        </div>
        
        <form id="forgotPasswordCodeForm">
          <div class="form-group">
            <label>Verification Code</label>
            <div class="code-input-row">
              <input type="text" class="code-digit-fps" id="codeF1" maxlength="1" inputmode="numeric" placeholder="0">
              <input type="text" class="code-digit-fps" id="codeF2" maxlength="1" inputmode="numeric" placeholder="0">
              <input type="text" class="code-digit-fps" id="codeF3" maxlength="1" inputmode="numeric" placeholder="0">
              <input type="text" class="code-digit-fps" id="codeF4" maxlength="1" inputmode="numeric" placeholder="0">
              <input type="text" class="code-digit-fps" id="codeF5" maxlength="1" inputmode="numeric" placeholder="0">
              <input type="text" class="code-digit-fps" id="codeF6" maxlength="1" inputmode="numeric" placeholder="0">
            </div>
            <small>Enter the code you received via SMS</small>
          </div>
          
          <div id="forgotPasswordCodeError" class="alert alert-danger" style="display: none;"></div>
          <div id="forgotPasswordCodeRateLimit" class="alert alert-warning" style="display: none;"></div>
          
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="forgotPasswordCodeBack">Back</button>
            <button type="submit" class="btn btn-primary" id="forgotPasswordCodeSubmit">Verify</button>
          </div>
          
          <div class="resend-wrapper">
            <p class="resend-text">Didn't receive a code?</p>
            <button type="button" class="btn-link" id="forgotPasswordCodeResend">Resend Code</button>
            <div id="forgotPasswordResendCountdown" class="countdown" style="display: none;"></div>
          </div>
        </form>
      </div>
      
      <!-- Password Reset Step -->
      <div id="forgotPasswordResetStep" class="modal-step" style="display: none;">
        <form id="forgotPasswordResetForm">
          <div class="form-group">
            <label for="newPassword">New Password</label>
            <input 
              type="password" 
              id="newPassword" 
              class="form-control" 
              placeholder="Enter new password"
              required
            />
            <small>Must be at least 12 characters with uppercase, lowercase, numbers, and symbols</small>
          </div>
          
          <div class="form-group">
            <label for="confirmPassword">Confirm Password</label>
            <input 
              type="password" 
              id="confirmPassword" 
              class="form-control" 
              placeholder="Confirm new password"
              required
            />
          </div>
          
          <div id="forgotPasswordResetError" class="alert alert-danger" style="display: none;"></div>
          
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="forgotPasswordResetCancel">Cancel</button>
            <button type="submit" class="btn btn-primary" id="forgotPasswordResetSubmit">Update Password</button>
          </div>
        </form>
      </div>
      
      <!-- Success Step -->
      <div id="forgotPasswordSuccessStep" class="modal-step" style="display: none;">
        <div class="success-icon">✅</div>
        <h3>Password Reset!</h3>
        <p>Your password has been updated successfully</p>
        <button type="button" class="btn btn-primary" id="forgotPasswordSuccessClose" style="width: 100%;">Login Again</button>
      </div>
    </div>
  </div>
</div>

<style>
  .forgot-password-modal {
    max-width: 480px;
  }

  /* Step Indicator */
  .step-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .step {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #e2e8f0;
    color: #64748b;
    font-weight: 600;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .step.active {
    background: #667eea;
    color: white;
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
  }

  .step-line {
    width: 20px;
    height: 2px;
    background: #e2e8f0;
    transition: background 0.3s ease;
  }

  .step-line.active {
    background: #667eea;
  }

  /* Form Group */
  .form-group {
    margin-bottom: 24px;
  }

  .form-group label {
    display: block;
    font-weight: 600;
    font-size: 14px;
    color: #1e293b;
    margin-bottom: 8px;
  }

  .form-group small {
    display: block;
    font-size: 13px;
    color: #64748b;
    margin-top: 6px;
  }

  /* Form Controls Enhancement */
  .form-control {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid #e2e8f0;
    border-radius: 8px;
    font-size: 16px;
    color: #1e293b;
    transition: all 0.3s ease;
    font-family: inherit;
  }

  .form-control:focus {
    outline: none;
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    background: #f8fafc;
  }

  /* Code Input Enhancement */
  .code-input-row {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .code-digit-fps {
    width: 56px;
    height: 56px;
    font-size: 24px;
    font-weight: 700;
    text-align: center;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    color: #1e293b;
    background: #f8fafc;
    transition: all 0.3s ease;
    font-family: 'Monaco', 'Menlo', monospace;
  }

  .code-digit-fps:focus {
    outline: none;
    border-color: #667eea;
    background: white;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
    transform: scale(1.08);
  }

  .code-digit-fps.filled {
    border-color: #667eea;
    background: #f0f4ff;
  }

  /* Button Enhancement */
  .btn {
    padding: 12px 24px;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
  }

  .btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }

  .btn-primary:hover:not(:disabled) {
    background: linear-gradient(135deg, #5568d3 0%, #6a4195 100%);
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(102, 126, 234, 0.35);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-secondary {
    background: #f1f5f9;
    color: #1e293b;
    border: 1px solid #e2e8f0;
  }

  .btn-secondary:hover {
    background: #e2e8f0;
    border-color: #cbd5e1;
  }

  .modal-footer {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px solid #e2e8f0;
  }

  .modal-footer .btn {
    flex: 1;
  }

  /* Phone Display */
  .phone-display-mini {
    background: linear-gradient(135deg, #f0f4ff 0%, #f8fafc 100%);
    padding: 20px;
    border-radius: 12px;
    text-align: center;
    margin-bottom: 28px;
    border: 1px solid #e2e8f0;
  }

  .phone-display-mini p {
    margin: 0;
    font-size: 12px;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
  }

  .phone-number-display {
    font-size: 18px;
    font-weight: 700;
    color: #667eea;
    margin-top: 8px;
    font-family: 'Monaco', 'Menlo', monospace;
  }

  /* Animations */
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .modal-step {
    animation: fadeIn 0.2s ease-out;
  }
</style>

<script>
  // Initialize forgot password SMS modal
  (function() {
    const modal = document.getElementById('forgotPasswordSmsModal');
    const closeBtn = document.getElementById('forgotPasswordModalClose');
    const cancelPhoneBtn = document.getElementById('forgotPasswordPhoneCancel');
    const codeBackBtn = document.getElementById('forgotPasswordCodeBack');
    const resetCancelBtn = document.getElementById('forgotPasswordResetCancel');
    const successCloseBtn = document.getElementById('forgotPasswordSuccessClose');
    
    const phoneStep = document.getElementById('forgotPasswordPhoneStep');
    const codeStep = document.getElementById('forgotPasswordCodeStep');
    const resetStep = document.getElementById('forgotPasswordResetStep');
    const successStep = document.getElementById('forgotPasswordSuccessStep');
    
    const phoneForm = document.getElementById('forgotPasswordPhoneForm');
    const codeForm = document.getElementById('forgotPasswordCodeForm');
    const resetForm = document.getElementById('forgotPasswordResetForm');
    const codeDigits = document.querySelectorAll('.code-digit-fps');
    
    let currentPhoneNumber = null;
    let currentVerificationToken = null;
    
    // Open modal function
    window.openForgotPasswordSmsModal = function() {
      modal.classList.add('is-open');
      resetModal();
      updateStepIndicator(1);
      document.getElementById('forgotPasswordPhoneInput').focus();
    };
    
    // Close modal function
    function closeModal() {
      modal.classList.remove('is-open');
      resetModal();
    }
    
    // Update step indicator
    function updateStepIndicator(stepNum) {
      const steps = modal.querySelectorAll('.step');
      const stepLines = modal.querySelectorAll('.step-line');
      
      steps.forEach((step, index) => {
        if (index < stepNum) {
          step.classList.add('active');
        } else {
          step.classList.remove('active');
        }
      });
      
      stepLines.forEach((line, index) => {
        if (index < stepNum - 1) {
          line.classList.add('active');
        } else {
          line.classList.remove('active');
        }
      });
    }
    
    // Reset modal to initial state
    function resetModal() {
      phoneStep.style.display = 'block';
      codeStep.style.display = 'none';
      resetStep.style.display = 'none';
      successStep.style.display = 'none';
      
      clearAllErrors();
      phoneForm.reset();
      codeForm.reset();
      resetForm.reset();
      currentPhoneNumber = null;
      currentVerificationToken = null;
    }
    
    function clearAllErrors() {
      document.getElementById('forgotPasswordPhoneError').style.display = 'none';
      document.getElementById('forgotPasswordPhoneRateLimit').style.display = 'none';
      document.getElementById('forgotPasswordCodeError').style.display = 'none';
      document.getElementById('forgotPasswordCodeRateLimit').style.display = 'none';
      document.getElementById('forgotPasswordResetError').style.display = 'none';
    }
    
    // Close button handlers with null checks
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (cancelPhoneBtn) cancelPhoneBtn.addEventListener('click', closeModal);
    if (successCloseBtn) successCloseBtn.addEventListener('click', () => {
      window.location.href = '/login';
    });
    if (codeBackBtn) codeBackBtn.addEventListener('click', () => {
      codeStep.style.display = 'none';
      phoneStep.style.display = 'block';
      clearAllErrors();
    });
    if (resetCancelBtn) resetCancelBtn.addEventListener('click', closeModal);
    
    // Close on backdrop click (only if clicking directly on overlay)
    modal.addEventListener('click', (e) => {
      if (e.target === modal && e.target.id === 'forgotPasswordSmsModal') closeModal();
    });
    
    // Code digit auto-advance with safety check
    if (codeDigits && codeDigits.length > 0) {
      codeDigits.forEach((input, index) => {
        input.addEventListener('input', (e) => {
          input.value = input.value.replace(/[^0-9]/g, '');
          input.classList.toggle('filled', input.value.length > 0);
          if (input.value.length === 1 && index < codeDigits.length - 1) {
            codeDigits[index + 1].focus();
          }
        });
        
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Backspace' && input.value === '' && index > 0) {
            codeDigits[index - 1].focus();
          }
        });
      
      input.addEventListener('paste', (e) => {
        e.preventDefault();
        const paste = (e.clipboardData || window.clipboardData).getData('text');
        const digits = paste.replace(/[^0-9]/g, '');
        digits.split('').forEach((digit, i) => {
          if (i < codeDigits.length) {
            codeDigits[i].value = digit;
            codeDigits[i].classList.toggle('filled', digit.length > 0);
          }
        });
        if (digits.length >= 6) codeDigits[5].focus();
      });
    });
    }
    
    // Phone form submission - request SMS code for forgot password
    phoneForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const phoneNumber = document.getElementById('forgotPasswordPhoneInput').value.trim();
      
      // Validate phone number
      if (!phoneNumber) {
        showError('forgotPasswordPhoneError', 'Please enter a phone number');
        return;
      }
      
      // Extract digits only for validation
      const digitsOnly = phoneNumber.replace(/\D/g, '');
      
      // Check for valid phone number length (10-15 digits for international)
      if (digitsOnly.length < 10 || digitsOnly.length > 15) {
        showError('forgotPasswordPhoneError', 'Please enter a valid phone number (10-15 digits)');
        return;
      }
      
      const sendBtn = document.getElementById('forgotPasswordPhoneSend');
      sendBtn.disabled = true;
      sendBtn.textContent = 'Sending...';
      clearAllErrors();
      
      try {
        // This would be a new endpoint: /forgot-password/request-sms
        const response = await fetch('/forgot-password/request-sms', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phoneNumber })
        });
        
        const data = await response.json();
        
        if (data.success) {
          currentPhoneNumber = data.phoneNumber;
          currentVerificationToken = data.token;
          document.getElementById('forgotPasswordPhoneDisplay').textContent = data.phoneNumber;
          phoneStep.style.display = 'none';
          codeStep.style.display = 'block';
          updateStepIndicator(2);
          codeDigits[0].focus();
        } else if (data.rateLimited) {
          const waitSeconds = Math.ceil(data.waitSeconds || 60);
          const remaining = data.remaining || 0;
          showRateLimit('forgotPasswordPhoneRateLimit', waitSeconds, remaining);
        } else {
          showError('forgotPasswordPhoneError', data.error || 'Failed to send code');
        }
      } catch (error) {
        showError('forgotPasswordPhoneError', 'Network error. Please try again.');
      } finally {
        sendBtn.disabled = false;
        sendBtn.textContent = 'Send Code';
      }
    });
    
    // Code form submission
    codeForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = Array.from(codeDigits).map(input => input.value).join('');
      
      if (code.length !== 6) {
        showError('forgotPasswordCodeError', 'Please enter all 6 digits');
        return;
      }
      
      const verifyBtn = document.getElementById('forgotPasswordCodeSubmit');
      verifyBtn.disabled = true;
      verifyBtn.textContent = 'Verifying...';
      clearAllErrors();
      
      try {
        const response = await fetch('/forgot-password/verify-sms', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code, token: currentVerificationToken })
        });
        
        const data = await response.json();
        
        if (data.success) {
          codeStep.style.display = 'none';
          resetStep.style.display = 'block';
          updateStepIndicator(3);
          document.getElementById('newPassword').focus();
        } else if (data.rateLimited) {
          const waitSeconds = Math.ceil(data.waitSeconds || 60);
          showError('forgotPasswordCodeRateLimit', `Too many attempts. Try again in ${waitSeconds} seconds.`);
        } else {
          showError('forgotPasswordCodeError', data.error || 'Verification failed');
        }
      } catch (error) {
        showError('forgotPasswordCodeError', 'Network error. Please try again.');
      } finally {
        verifyBtn.disabled = false;
        verifyBtn.textContent = 'Verify';
      }
    });
    
    // Resend code button
    document.getElementById('forgotPasswordCodeResend').addEventListener('click', async (e) => {
      e.preventDefault();
      const resendBtn = document.getElementById('forgotPasswordCodeResend');
      resendBtn.disabled = true;
      clearAllErrors();
      
      try {
        const response = await fetch('/forgot-password/resend-sms', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: currentVerificationToken })
        });
        
        const data = await response.json();
        
        if (data.success) {
          codeDigits.forEach(digit => digit.value = '');
          codeDigits[0].focus();
          startResendTimer();
        } else if (data.rateLimited) {
          const waitSeconds = Math.ceil(data.waitSeconds || 60);
          const remaining = data.remaining || 0;
          showRateLimit('forgotPasswordCodeRateLimit', waitSeconds, remaining);
        } else {
          showError('forgotPasswordCodeError', data.error || 'Failed to resend code');
          resendBtn.disabled = false;
        }
      } catch (error) {
        showError('forgotPasswordCodeError', 'Network error. Please try again.');
        resendBtn.disabled = false;
      }
    });
    
    // Reset form submission
    resetForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;
      
      if (newPassword !== confirmPassword) {
        showError('forgotPasswordResetError', 'Passwords do not match');
        return;
      }
      
      if (newPassword.length < 12) {
        showError('forgotPasswordResetError', 'Password must be at least 12 characters');
        return;
      }
      
      const resetBtn = document.getElementById('forgotPasswordResetSubmit');
      resetBtn.disabled = true;
      resetBtn.textContent = 'Updating...';
      clearAllErrors();
      
      try {
        const response = await fetch('/forgot-password/reset-via-sms', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            newPassword, 
            token: currentVerificationToken 
          })
        });
        
        const data = await response.json();
        
        if (data.success) {
          resetStep.style.display = 'none';
          successStep.style.display = 'block';
          updateStepIndicator(4);
          setTimeout(() => {
            window.location.href = '/login';
          }, 3000);
        } else {
          showError('forgotPasswordResetError', data.error || 'Failed to reset password');
        }
      } catch (error) {
        showError('forgotPasswordResetError', 'Network error. Please try again.');
      } finally {
        resetBtn.disabled = false;
        resetBtn.textContent = 'Update Password';
      }
    });
    
    function startResendTimer() {
      const resendBtn = document.getElementById('forgotPasswordCodeResend');
      const countdown = document.getElementById('forgotPasswordResendCountdown');
      let seconds = 60;
      
      countdown.style.display = 'block';
      countdown.textContent = `Resend available in ${seconds}s`;
      
      const timer = setInterval(() => {
        seconds--;
        countdown.textContent = `Resend available in ${seconds}s`;
        
        if (seconds <= 0) {
          clearInterval(timer);
          countdown.style.display = 'none';
          resendBtn.disabled = false;
        }
      }, 1000);
    }
    
    function showError(elementId, message) {
      const element = document.getElementById(elementId);
      element.textContent = message;
      element.style.display = 'block';
    }
    
    function showRateLimit(elementId, waitSeconds, remaining) {
      const element = document.getElementById(elementId);
      element.innerHTML = `
        <strong>⏱️ Rate limit exceeded</strong><br/>
        You've reached the SMS limit. Try again in <span id="limit-countdown-fps">${waitSeconds}</span>s
        (${remaining} attempts remaining)
      `;
      element.style.display = 'block';
      
      let seconds = waitSeconds;
      const countdownInterval = setInterval(() => {
        seconds--;
        const countEl = document.getElementById('limit-countdown-fps');
        if (countEl) countEl.textContent = seconds;
        if (seconds <= 0) {
          clearInterval(countdownInterval);
          element.style.display = 'none';
        }
      }, 1000);
    }
  })();
</script>
