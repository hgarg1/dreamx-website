<!-- Forgot Password SMS Recovery Modal -->
<div id="forgotPasswordSmsModal" class="modal-overlay" style="display: none;">
  <div class="modal-content forgot-password-modal">
    <div class="modal-sheen" aria-hidden="true"></div>

    <!-- Close Button -->
    <button class="modal-close" id="forgotPasswordModalClose" type="button" aria-label="Close">×</button>
    
    <!-- Header -->
    <div class="modal-header">
      <div class="modal-kicker">Mobile account recovery</div>
      <div class="modal-title-row">
        <div class="modal-icon">📲</div>
        <div>
          <h2>Reset your password in minutes</h2>
          <p>Verify ownership with a premium-grade SMS flow tuned for SSO accounts.</p>
        </div>
      </div>
      <div class="modal-pill-row" role="list">
        <span class="modal-pill" role="listitem">Realtime validation</span>
        <span class="modal-pill" role="listitem">Adaptive rate limits</span>
        <span class="modal-pill" role="listitem">Zero-copy auto-format</span>
      </div>
    </div>

    <div class="modal-tip-grid" aria-hidden="true">
      <article class="modal-tip-card">
        <strong>SSO friendly</strong>
        <p>Skip the old password hurdle when you sign in with Google, Microsoft, Apple, or X.</p>
      </article>
      <article class="modal-tip-card">
        <strong>Private by default</strong>
        <p>Numbers are normalized to E.164 and encrypted in transit—no plaintext storage.</p>
      </article>
    </div>
    
    <!-- Body -->
    <div class="modal-body">
      <!-- Phone Verification Step -->
      <div id="forgotPasswordPhoneStep" class="modal-step">
        <div class="step-indicator" role="list" aria-label="Password recovery progress">
          <div class="step-block" role="listitem">
            <div class="step active" aria-current="step">1</div>
            <span class="step-label">Phone</span>
          </div>
          <div class="step-line"></div>
          <div class="step-block" role="listitem">
            <div class="step">2</div>
            <span class="step-label">Code</span>
          </div>
          <div class="step-line"></div>
          <div class="step-block" role="listitem">
            <div class="step">3</div>
            <span class="step-label">Password</span>
          </div>
          <div class="step-line"></div>
          <div class="step-block" role="listitem">
            <div class="step">4</div>
            <span class="step-label">Done</span>
          </div>
        </div>

        <div class="modal-highlight">
          <div class="highlight-icon">✨</div>
          <div>
            <p class="highlight-title">Automatic formatting</p>
            <p class="highlight-copy">Paste any number style (+44, (555), 555-1234). We auto-format, remove letters, and keep you compliant worldwide.</p>
          </div>
        </div>

        <form id="forgotPasswordPhoneForm">
          <div class="form-group enhanced">
            <label for="forgotPasswordPhoneInput">Phone Number</label>
            <div class="input-shell">
              <span class="input-chip">SMS</span>
              <input 
                type="tel" 
                id="forgotPasswordPhoneInput" 
                class="form-control" 
                placeholder="+1 (555) 000-0000"
                autocomplete="tel"
                inputmode="tel"
                spellcheck="false"
                aria-describedby="phoneFormatHelper"
                required
              />
            </div>
            <small id="phoneFormatHelper">We auto-format to a secure E.164 layout. <span class="hint-accent" id="phoneRegionLabel">Awaiting input…</span></small>
          </div>
          
          <div id="forgotPasswordPhoneError" class="alert alert-danger" role="alert" style="display: none;"></div>
          <div id="forgotPasswordPhoneRateLimit" class="alert alert-warning" role="status" style="display: none;"></div>
          
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="forgotPasswordPhoneCancel">Back to Email</button>
            <button type="submit" class="btn btn-primary" id="forgotPasswordPhoneSend">Send Code</button>
          </div>
        </form>
      </div>
      
      <!-- Code Verification Step -->
      <div id="forgotPasswordCodeStep" class="modal-step" style="display: none;">
        <div class="phone-display-mini">
          <p>Code sent to:</p>
          <p id="forgotPasswordPhoneDisplay" class="phone-number-display"></p>
        </div>
        
        <form id="forgotPasswordCodeForm">
          <div class="form-group">
            <label>Verification Code</label>
            <div class="code-input-row">
              <input type="text" class="code-digit-fps" id="codeF1" maxlength="1" inputmode="numeric" placeholder="0">
              <input type="text" class="code-digit-fps" id="codeF2" maxlength="1" inputmode="numeric" placeholder="0">
              <input type="text" class="code-digit-fps" id="codeF3" maxlength="1" inputmode="numeric" placeholder="0">
              <input type="text" class="code-digit-fps" id="codeF4" maxlength="1" inputmode="numeric" placeholder="0">
              <input type="text" class="code-digit-fps" id="codeF5" maxlength="1" inputmode="numeric" placeholder="0">
              <input type="text" class="code-digit-fps" id="codeF6" maxlength="1" inputmode="numeric" placeholder="0">
            </div>
            <small>Enter the code you received via SMS</small>
          </div>
          
          <div id="forgotPasswordCodeError" class="alert alert-danger" role="alert" style="display: none;"></div>
          <div id="forgotPasswordCodeRateLimit" class="alert alert-warning" role="status" style="display: none;"></div>
          
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="forgotPasswordCodeBack">Back</button>
            <button type="submit" class="btn btn-primary" id="forgotPasswordCodeSubmit">Verify</button>
          </div>
          
          <div class="resend-wrapper">
            <p class="resend-text">Didn't receive a code?</p>
            <button type="button" class="btn-link" id="forgotPasswordCodeResend">Resend Code</button>
            <div id="forgotPasswordResendCountdown" class="countdown" style="display: none;"></div>
          </div>
        </form>
      </div>
      
      <!-- Password Reset Step -->
      <div id="forgotPasswordResetStep" class="modal-step" style="display: none;">
        <form id="forgotPasswordResetForm">
          <div class="form-group enhanced">
            <label for="newPassword">New Password</label>
            <input 
              type="password" 
              id="newPassword" 
              class="form-control" 
              placeholder="Enter new password"
              required
            />
            <small>Must be at least 12 characters with uppercase, lowercase, numbers, and symbols</small>
          </div>
          
          <div class="form-group enhanced">
            <label for="confirmPassword">Confirm Password</label>
            <input 
              type="password" 
              id="confirmPassword" 
              class="form-control" 
              placeholder="Confirm new password"
              required
            />
          </div>
          
          <div id="forgotPasswordResetError" class="alert alert-danger" role="alert" style="display: none;"></div>
          
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="forgotPasswordResetCancel">Cancel</button>
            <button type="submit" class="btn btn-primary" id="forgotPasswordResetSubmit">Update Password</button>
          </div>
        </form>
      </div>
      
      <!-- Success Step -->
      <div id="forgotPasswordSuccessStep" class="modal-step" style="display: none;">
        <div class="success-card">
          <div class="success-icon">✅</div>
          <h3>Password reset complete</h3>
          <p>Your password has been updated and all other sessions were signed out automatically.</p>
          <button type="button" class="btn btn-primary" id="forgotPasswordSuccessClose" style="width: 100%;">Back to sign in</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
