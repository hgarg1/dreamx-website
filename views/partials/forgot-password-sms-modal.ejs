<script>
  // Initialize forgot password SMS modal
  (function() {
    const modal = document.getElementById('forgotPasswordSmsModal');
    const closeBtn = document.getElementById('forgotPasswordModalClose');
    const cancelPhoneBtn = document.getElementById('forgotPasswordPhoneCancel');
    const codeBackBtn = document.getElementById('forgotPasswordCodeBack');
    const resetCancelBtn = document.getElementById('forgotPasswordResetCancel');
    const successCloseBtn = document.getElementById('forgotPasswordSuccessClose');
    
    const phoneStep = document.getElementById('forgotPasswordPhoneStep');
    const codeStep = document.getElementById('forgotPasswordCodeStep');
    const resetStep = document.getElementById('forgotPasswordResetStep');
    const successStep = document.getElementById('forgotPasswordSuccessStep');
    
    const phoneForm = document.getElementById('forgotPasswordPhoneForm');
    const codeForm = document.getElementById('forgotPasswordCodeForm');
    const resetForm = document.getElementById('forgotPasswordResetForm');
    const codeDigits = document.querySelectorAll('.code-digit-fps');
    const phoneInput = document.getElementById('forgotPasswordPhoneInput');
    const phoneRegionLabel = document.getElementById('phoneRegionLabel');
    
    let currentPhoneNumber = null;
    let currentVerificationToken = null;
    
    // Open modal function
    window.openForgotPasswordSmsModal = function() {
      modal.classList.add('is-open');
      resetModal();
      updateStepIndicator(1);
      document.getElementById('forgotPasswordPhoneInput').focus();
    };
    
    // Close modal function
    function closeModal() {
      modal.classList.remove('is-open');
      resetModal();
    }
    
    // Update step indicator
    function updateStepIndicator(stepNum) {
      const steps = modal.querySelectorAll('.step');
      const stepLines = modal.querySelectorAll('.step-line');
      
      steps.forEach((step, index) => {
        if (index < stepNum) {
          step.classList.add('active');
        } else {
          step.classList.remove('active');
        }
      });
      
      stepLines.forEach((line, index) => {
        if (index < stepNum - 1) {
          line.classList.add('active');
        } else {
          line.classList.remove('active');
        }
      });
    }
    
    // Reset modal to initial state
    function resetModal() {
      phoneStep.style.display = 'block';
      codeStep.style.display = 'none';
      resetStep.style.display = 'none';
      successStep.style.display = 'none';
      
      clearAllErrors();
      phoneForm.reset();
      codeForm.reset();
      resetForm.reset();
      currentPhoneNumber = null;
      currentVerificationToken = null;
      if (phoneRegionLabel) {
        phoneRegionLabel.textContent = 'Awaiting input…';
      }
      if (phoneInput) phoneInput.value = '';
    }
    
    function clearAllErrors() {
      document.getElementById('forgotPasswordPhoneError').style.display = 'none';
      document.getElementById('forgotPasswordPhoneRateLimit').style.display = 'none';
      document.getElementById('forgotPasswordCodeError').style.display = 'none';
      document.getElementById('forgotPasswordCodeRateLimit').style.display = 'none';
      document.getElementById('forgotPasswordResetError').style.display = 'none';
    }

    function normalizePhone(value) {
      const digits = (value || '').replace(/\D/g, '').slice(0, 15);
      if (!digits) {
        return { digits: '', country: '', national: '', e164: '', formatted: '' };
      }
      let country = '';
      let national = digits;
      if (digits.length === 11 && digits.startsWith('1')) {
        country = '1';
        national = digits.slice(1);
      } else if (digits.length > 10) {
        country = digits.slice(0, digits.length - 10);
        national = digits.slice(-10);
      } else {
        country = '1';
      }
      const formatted = formatPhoneDisplay(country, national);
      const e164 = country ? `+${country}${national}` : national;
      return { digits, country, national, e164, formatted };
    }

    function formatPhoneDisplay(country, national) {
      let display = '';
      if (country) display += `+${country} `;
      if (!national) return display.trim();
      if (national.length <= 3) return `${display}${national}`.trim();
      if (national.length <= 6) {
        return `${display}(${national.slice(0, 3)}) ${national.slice(3)}`.trim();
      }
      const tail = national.slice(6);
      const base = `${display}(${national.slice(0, 3)}) ${national.slice(3, 6)}`;
      return tail ? `${base}-${tail}` : base;
    }

    function describeRegion(country) {
      if (!country) return 'Awaiting input…';
      if (country === '1') return 'United States / Canada (+1)';
      return `Country code +${country}`;
    }

    function updatePhoneRegionDisplay(normalized) {
      if (!phoneRegionLabel) return;
      phoneRegionLabel.textContent = normalized && normalized.digits
        ? describeRegion(normalized.country)
        : 'Awaiting input…';
    }

    function prettyFormatPhone(value) {
      if (!value) return '';
      const normalized = normalizePhone(value);
      return normalized.formatted || value;
    }

    function attachPhoneFormatter() {
      if (!phoneInput) return;
      phoneInput.addEventListener('input', () => {
        const normalized = normalizePhone(phoneInput.value);
        phoneInput.value = normalized.formatted;
        updatePhoneRegionDisplay(normalized);
      });
      phoneInput.addEventListener('blur', () => {
        const normalized = normalizePhone(phoneInput.value);
        phoneInput.value = normalized.formatted;
        updatePhoneRegionDisplay(normalized);
      });
    }
    attachPhoneFormatter();
    
    // Close button handlers with null checks
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (cancelPhoneBtn) cancelPhoneBtn.addEventListener('click', closeModal);
    if (successCloseBtn) successCloseBtn.addEventListener('click', () => {
      window.location.href = '/login';
    });
    if (codeBackBtn) codeBackBtn.addEventListener('click', () => {
      codeStep.style.display = 'none';
      phoneStep.style.display = 'block';
      clearAllErrors();
    });
    if (resetCancelBtn) resetCancelBtn.addEventListener('click', closeModal);
    
    // Close on backdrop click (only if clicking directly on overlay)
    modal.addEventListener('click', (e) => {
      if (e.target === modal && e.target.id === 'forgotPasswordSmsModal') closeModal();
    });
    
    // Code digit auto-advance with safety check
    if (codeDigits && codeDigits.length > 0) {
      codeDigits.forEach((input, index) => {
        input.addEventListener('input', (e) => {
          input.value = input.value.replace(/[^0-9]/g, '');
          input.classList.toggle('filled', input.value.length > 0);
          if (input.value.length === 1 && index < codeDigits.length - 1) {
            codeDigits[index + 1].focus();
          }
        });
        
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Backspace' && input.value === '' && index > 0) {
            codeDigits[index - 1].focus();
          }
        });
      
      input.addEventListener('paste', (e) => {
        e.preventDefault();
        const paste = (e.clipboardData || window.clipboardData).getData('text');
        const digits = paste.replace(/[^0-9]/g, '');
        digits.split('').forEach((digit, i) => {
          if (i < codeDigits.length) {
            codeDigits[i].value = digit;
            codeDigits[i].classList.toggle('filled', digit.length > 0);
          }
        });
        if (digits.length >= 6) codeDigits[5].focus();
      });
    });
    }
    
    // Phone form submission - request SMS code for forgot password
    phoneForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const rawValue = document.getElementById('forgotPasswordPhoneInput').value.trim();
      const normalized = normalizePhone(rawValue);
      
      if (!normalized.digits) {
        showError('forgotPasswordPhoneError', 'Please enter a phone number');
        return;
      }
      
      if (normalized.digits.length < 10 || normalized.digits.length > 15) {
        showError('forgotPasswordPhoneError', 'Please enter a valid phone number (10-15 digits)');
        return;
      }
      
      const sendBtn = document.getElementById('forgotPasswordPhoneSend');
      sendBtn.disabled = true;
      sendBtn.textContent = 'Sending...';
      clearAllErrors();
      
      try {
        // This would be a new endpoint: /forgot-password/request-sms
        const response = await fetch('/forgot-password/request-sms', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phoneNumber: normalized.e164 })
        });
        
        const data = await response.json();
        
        if (data.success) {
          currentPhoneNumber = data.phoneNumber || normalized.e164;
          currentVerificationToken = data.token;
          const displayValue = prettyFormatPhone(data.phoneNumber || normalized.e164);
          document.getElementById('forgotPasswordPhoneDisplay').textContent = displayValue;
          phoneStep.style.display = 'none';
          codeStep.style.display = 'block';
          updateStepIndicator(2);
          codeDigits[0].focus();
          updatePhoneRegionDisplay(normalized);
        } else if (data.rateLimited) {
          const waitSeconds = Math.ceil(data.waitSeconds || 60);
          const remaining = data.remaining || 0;
          showRateLimit('forgotPasswordPhoneRateLimit', waitSeconds, remaining);
        } else {
          showError('forgotPasswordPhoneError', data.error || 'Failed to send code');
        }
      } catch (error) {
        showError('forgotPasswordPhoneError', 'Network error. Please try again.');
      } finally {
        sendBtn.disabled = false;
        sendBtn.textContent = 'Send Code';
      }
    });
    
    // Code form submission
    codeForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = Array.from(codeDigits).map(input => input.value).join('');
      
      if (code.length !== 6) {
        showError('forgotPasswordCodeError', 'Please enter all 6 digits');
        return;
      }
      
      const verifyBtn = document.getElementById('forgotPasswordCodeSubmit');
      verifyBtn.disabled = true;
      verifyBtn.textContent = 'Verifying...';
      clearAllErrors();
      
      try {
        const response = await fetch('/forgot-password/verify-sms', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code, token: currentVerificationToken })
        });
        
          const data = await response.json();
        
        if (data.success) {
          codeStep.style.display = 'none';
          resetStep.style.display = 'block';
          updateStepIndicator(3);
          document.getElementById('newPassword').focus();
        } else if (data.rateLimited) {
          const waitSeconds = Math.ceil(data.waitSeconds || 60);
          showError('forgotPasswordCodeRateLimit', `Too many attempts. Try again in ${waitSeconds} seconds.`);
        } else {
          showError('forgotPasswordCodeError', data.error || 'Verification failed');
        }
      } catch (error) {
        showError('forgotPasswordCodeError', 'Network error. Please try again.');
      } finally {
        verifyBtn.disabled = false;
        verifyBtn.textContent = 'Verify';
      }
    });
    
    // Resend code button
    document.getElementById('forgotPasswordCodeResend').addEventListener('click', async (e) => {
      e.preventDefault();
      const resendBtn = document.getElementById('forgotPasswordCodeResend');
      resendBtn.disabled = true;
      clearAllErrors();
      
      try {
        const response = await fetch('/forgot-password/resend-sms', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: currentVerificationToken })
        });
        
        const data = await response.json();
        
        if (data.success) {
          codeDigits.forEach(digit => digit.value = '');
          codeDigits[0].focus();
          startResendTimer();
        } else if (data.rateLimited) {
          const waitSeconds = Math.ceil(data.waitSeconds || 60);
          const remaining = data.remaining || 0;
          showRateLimit('forgotPasswordCodeRateLimit', waitSeconds, remaining);
        } else {
          showError('forgotPasswordCodeError', data.error || 'Failed to resend code');
          resendBtn.disabled = false;
        }
      } catch (error) {
        showError('forgotPasswordCodeError', 'Network error. Please try again.');
        resendBtn.disabled = false;
      }
    });
    
    // Reset form submission
    resetForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;
      
      if (newPassword !== confirmPassword) {
        showError('forgotPasswordResetError', 'Passwords do not match');
        return;
      }
      
      if (newPassword.length < 12) {
        showError('forgotPasswordResetError', 'Password must be at least 12 characters');
        return;
      }
      
      const resetBtn = document.getElementById('forgotPasswordResetSubmit');
      resetBtn.disabled = true;
      resetBtn.textContent = 'Updating...';
      clearAllErrors();
      
      try {
        const response = await fetch('/forgot-password/reset-via-sms', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ 
            newPassword, 
            token: currentVerificationToken 
          })
        });
        
        const data = await response.json();
        
        if (data.success) {
          resetStep.style.display = 'none';
          successStep.style.display = 'block';
          updateStepIndicator(4);
          setTimeout(() => {
            window.location.href = '/login';
          }, 3000);
        } else {
          showError('forgotPasswordResetError', data.error || 'Failed to reset password');
        }
      } catch (error) {
        showError('forgotPasswordResetError', 'Network error. Please try again.');
      } finally {
        resetBtn.disabled = false;
        resetBtn.textContent = 'Update Password';
      }
    });
    
    function startResendTimer() {
      const resendBtn = document.getElementById('forgotPasswordCodeResend');
      const countdown = document.getElementById('forgotPasswordResendCountdown');
      let seconds = 60;
      
      countdown.style.display = 'block';
      countdown.textContent = `Resend available in ${seconds}s`;
      
      const timer = setInterval(() => {
        seconds--;
        countdown.textContent = `Resend available in ${seconds}s`;
        
        if (seconds <= 0) {
          clearInterval(timer);
          countdown.style.display = 'none';
          resendBtn.disabled = false;
        }
      }, 1000);
    }
    
    function showError(elementId, message) {
      const element = document.getElementById(elementId);
      element.textContent = message;
      element.style.display = 'block';
    }
    
    function showRateLimit(elementId, waitSeconds, remaining) {
      const element = document.getElementById(elementId);
      element.innerHTML = `
        <strong>⏱️ Rate limit exceeded</strong><br/>
        You've reached the SMS limit. Try again in <span id="limit-countdown-fps">${waitSeconds}</span>s
        (${remaining} attempts remaining)
      `;
      element.style.display = 'block';
      
      let seconds = waitSeconds;
      const countdownInterval = setInterval(() => {
        seconds--;
        const countEl = document.getElementById('limit-countdown-fps');
        if (countEl) countEl.textContent = seconds;
        if (seconds <= 0) {
          clearInterval(countdownInterval);
          element.style.display = 'none';
        }
      }, 1000);
    }
  })();
</script>
