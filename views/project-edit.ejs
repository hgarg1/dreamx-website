  async function addUpdate() {
    const title = document.getElementById('updateTitle').value.trim();
    const content = document.getElementById('updateContent').value.trim();
    const isStatus = document.getElementById('isStatusUpdate').checked;

    if (!content) {
      alert('Please enter update content');
      return;
    }

    try {
      const response = await fetch(`/api/projects/${projectId}/updates`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ 
          title: title || 'Project Update',
          contentType: 'text',
          textContent: content,
          statusUpdate: isStatus 
        })
      });
      const data = await response.json();
      if (data.success) {
        document.getElementById('updateTitle').value = '';
        document.getElementById('updateContent').value = '';
        document.getElementById('isStatusUpdate').checked = false;
        await loadProjectData();
      } else {
        alert('Error: ' + (data.error || 'Failed to post update'));
      }
    } catch (err) {
      console.error('Error:', err);
      alert('Error posting update');
    }
  }

  async function deleteUpdate(id) {
