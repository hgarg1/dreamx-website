    <button class="hr-tab" data-tab="review">🔍 Under Review (<%= reviewApps %>)</button>
    <button class="hr-tab" data-tab="accepted">✅ Accepted (<%= acceptedApps %>)</button>
    <button class="hr-tab" data-tab="rejected">❌ Rejected (<%= rejectedApps %>)</button>
  </div>

  <div class="hr-tab-content active" data-content="all">
    <div class="application-grid" id="allApplications">
      <% (careers || []).forEach(c => { %>
        <div class="application-card" 
             data-id="<%= c.id %>"
             data-status="<%= c.status || 'new' %>"
             data-name="<%= c.name.toLowerCase() %>"
             data-email="<%= c.email.toLowerCase() %>"
