    <div class="hr-tab-content" data-content="<%= tab %>">
      <div class="application-grid">
        <% 
          const statusMatch = tab === 'review' ? 'under_review' : tab;
          const filtered = careers.filter(c => c.status === statusMatch); 
        %>
        <% filtered.forEach(c => { %>
          <div class="application-card">
