            </div>
            <div class="quick-actions">
              <button class="btn-view" onclick='viewApplication(<%= c.id %>, {id: <%= c.id %>, name: "<%= c.name.replace(/"/g, "&quot;") %>", position: "<%= c.position.replace(/"/g, "&quot;") %>", email: "<%= c.email %>", phone: "<%= c.phone || "" %>", status: "<%= c.status || "new" %>", created_at: "<%= c.created_at %>", cover_letter: "<%= (c.cover_letter || "").replace(/"/g, "&quot;").replace(/\n/g, " ") %>", resume_file: "<%= c.resume_file || "" %>", portfolio_file: "<%= c.portfolio_file || "" %>"})'>👁️</button>
              <% if (c.resume_file) { %><a href="<%= c.resume_file %>" target="_blank" class="btn-resume">📄</a><% } %>
              <% if (c.portfolio_file) { %><a href="<%= c.portfolio_file %>" target="_blank" class="btn-portfolio">🎨</a><% } %>
              <button class="btn-email" onclick="emailApplicant('<%= c.email %>', '<%= c.name.replace(/'/g, "\\'") %>')">✉️</button>
              <button class="btn-review" onclick="updateStatus(<%= c.id %>, 'under_review')">🔍</button>
              <button class="btn-accept" onclick="updateStatus(<%= c.id %>, 'accepted')">✅</button>
              <button class="btn-reject" onclick="updateStatus(<%= c.id %>, 'rejected')">❌</button>
            </div>
          </div>
        <% }) %>
        <% if (!filtered.length) { %>
          <div class="empty-state">
            <div class="empty-state-icon">📋</div>
            <h3>No Applications in This Category</h3>
            <p>Applications with status "<%= tab.replace('_', ' ') %>" will appear here</p>
          </div>
        <% } %>
      </div>
    </div>
  <% }) %>
</div>

