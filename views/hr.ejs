<%- include('partials/footer') %>

<script>
if (typeof showSuccess !== 'function') window.showSuccess = (msg) => alert(msg);
if (typeof showError !== 'function') window.showError = (msg) => alert(msg);
if (typeof showConfirm !== 'function') window.showConfirm = (msg, cb) => { if (confirm(msg)) cb(); };

const hrRoleRankings = { hr: 1, super_hr: 2, global_hr: 3 };
const hrRoleLabels = { hr: 'HR', super_hr: 'Super HR', global_hr: 'Global HR' };
const myHrRole = '<%= authUser.role %>';
const isGlobalHr = myHrRole === 'global_hr';
const hrPermissionDefinitions = <%- JSON.stringify(hrPermissionDefinitions || []).replace(/</g, '\\u003c') %>;
const defaultHrScopes = <%- JSON.stringify(defaultHrScopes || []).replace(/</g, '\\u003c') %>;
const initialHrTeam = <%- JSON.stringify(hrTeam || []).replace(/</g, '\\u003c') %>;
let hrWizardStage = 1;
let hrWizardScopes = [...(defaultHrScopes || [])];
let hrWizardPermissions = new Set(['hr_applications', 'hr_pipeline', 'hr_jobs', 'hr_messages']);
let hrTeamState = initialHrTeam.map(m => ({ ...m, admin_scopes: m.admin_scopes || [], hr_permissions: m.hr_permissions || [], scope_locked: !!m.scope_locked }));

const hrWizardStatusEl = () => document.getElementById('hrWizardStatus');
const canCreateHrAccounts = (hrRoleRankings[myHrRole] || 0) >= 2;
const toastSuccess = (msg) => typeof showSuccess === 'function' ? showSuccess(msg) : alert(msg);
const toastError = (msg) => typeof showError === 'function' ? showError(msg) : alert(msg);
const escapeHtml = (val) => String(val || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

function setHrWizardStage(step) {
  hrWizardStage = Math.min(Math.max(step, 1), 3);
  document.querySelectorAll('[data-hr-body]').forEach(el => {
    el.classList.toggle('active', Number(el.dataset.hrBody) === hrWizardStage);
  });
  document.querySelectorAll('[data-hr-step]').forEach(el => {
    el.classList.toggle('active', Number(el.dataset.hrStep) === hrWizardStage);
  });
  document.getElementById('hrLaunchBtn').style.display = hrWizardStage === 3 ? 'inline-flex' : 'none';
  const nextBtn = document.querySelector('[onclick="hrWizardNext()"]');
  if (nextBtn) nextBtn.style.display = hrWizardStage === 3 ? 'none' : 'inline-flex';
  updateHrReview();
}

function hrWizardNext() {
  if (hrWizardStage === 1) {
    const fullName = document.getElementById('hrFullName').value.trim();
    const email = document.getElementById('hrEmail').value.trim();
    const password = document.getElementById('hrPassword').value.trim();
    if (!fullName || !email || !password) {
      hrWizardStatusEl().textContent = 'Add name, email, and a launch password to continue.';
      return;
    }
  }
  setHrWizardStage(hrWizardStage + 1);
  hrWizardStatusEl().textContent = canCreateHrAccounts ? '' : 'Only Super HR and Global HR can launch new teammates.';
}

function hrWizardPrev() {
  setHrWizardStage(hrWizardStage - 1);
}

function renderHrScopeChips() {
  const wrap = document.getElementById('hrScopeChips');
  if (!wrap) return;
  wrap.innerHTML = '';
  hrWizardScopes.forEach(scope => {
    const chip = document.createElement('div');
    chip.className = 'hr-scope-chip';
    chip.innerHTML = `${scope} <button aria-label="Remove scope" onclick="removeScopeChip('${scope.replace(/'/g, "\\'")}')">×</button>`;
    wrap.appendChild(chip);
  });
}

function addScopeChipFromInput() {
  const input = document.getElementById('hrScopeInput');
  const val = (input.value || '').trim();
  if (!val) return;
  if (!hrWizardScopes.includes(val)) hrWizardScopes.push(val);
  input.value = '';
  renderHrScopeChips();
  updateHrReview();
}

function addPresetScope(scope) {
  if (!scope) return;
  if (!hrWizardScopes.includes(scope)) {
    hrWizardScopes.push(scope);
    renderHrScopeChips();
    updateHrReview();
  }
}

function removeScopeChip(scope) {
  hrWizardScopes = hrWizardScopes.filter(s => s !== scope);
  renderHrScopeChips();
  updateHrReview();
}

function renderHrPermissionChecklist() {
  const wrap = document.getElementById('hrPermissionChecklist');
  if (!wrap) return;
  wrap.innerHTML = '';
  (hrPermissionDefinitions || []).forEach(def => {
    const chip = document.createElement('div');
    chip.className = 'hr-scope-chip';
    chip.style.cursor = 'pointer';
    chip.dataset.key = def.key;
    chip.onclick = () => toggleHrPermission(def.key);
    chip.innerHTML = `${def.label} <span style="display:block; color:#6b7280; font-weight:600; font-size:12px;">${def.desc}</span>`;
    if (hrWizardPermissions.has(def.key)) chip.classList.add('active');
    wrap.appendChild(chip);
  });
}

function toggleHrPermission(key) {
  if (!key) return;
  if (hrWizardPermissions.has(key)) hrWizardPermissions.delete(key); else hrWizardPermissions.add(key);
  renderHrPermissionChecklist();
  updateHrReview();
}

function updateHrReview() {
  const name = document.getElementById('hrFullName').value || 'New HR Teammate';
  const email = document.getElementById('hrEmail').value || 'email@dreamx.local';
  const role = (document.querySelector('input[name="hrRole"]:checked') || { value: 'hr' }).value;
  document.getElementById('hrReviewName').textContent = name;
  document.getElementById('hrReviewEmail').textContent = email;
  const roleBadge = document.getElementById('hrReviewRole');
  roleBadge.textContent = hrRoleLabels[role] || role;
  roleBadge.className = `role-pill ${role === 'super_hr' ? 'super-hr' : (role === 'global_hr' ? 'global-hr' : '')}`;
  const reviewScopes = document.getElementById('hrReviewScopes');
  reviewScopes.innerHTML = '';
  if (!hrWizardScopes.length) {
    const ghost = document.createElement('div');
    ghost.style.color = '#6b7280';
    ghost.style.fontWeight = '700';
    ghost.textContent = 'No scopes yet — add pods, regions, or programs.';
    reviewScopes.appendChild(ghost);
  } else {
    hrWizardScopes.forEach(scope => {
      const chip = document.createElement('div');
      chip.className = 'hr-scope-chip';
      chip.textContent = scope;
      reviewScopes.appendChild(chip);
    });
  }
  const permWrap = document.getElementById('hrReviewPermissions');
  if (permWrap) {
    permWrap.innerHTML = '';
    const list = Array.from(hrWizardPermissions);
    if (!list.length) {
      const ghost = document.createElement('div');
      ghost.style.color = '#6b7280';
      ghost.style.fontWeight = '700';
      ghost.textContent = 'No HR permissions selected yet.';
      permWrap.appendChild(ghost);
    } else {
      list.forEach(key => {
        const def = (hrPermissionDefinitions || []).find(d => d.key === key);
        const chip = document.createElement('div');
        chip.className = 'hr-scope-chip';
        chip.textContent = def ? def.label : key;
        permWrap.appendChild(chip);
      });
    }
  }
}

async function submitHrWizard() {
  const fullName = document.getElementById('hrFullName').value.trim();
  const email = document.getElementById('hrEmail').value.trim();
  const password = document.getElementById('hrPassword').value.trim();
  const role = (document.querySelector('input[name="hrRole"]:checked') || { value: 'hr' }).value;

  if (!canCreateHrAccounts) {
    hrWizardStatusEl().textContent = 'Only Super HR or Global HR can launch new teammates.';
    return;
  }
  if (!fullName || !email || !password) {
    hrWizardStatusEl().textContent = 'Please complete all fields before launching the account.';
    return;
  }

  hrWizardStatusEl().textContent = 'Creating account…';
  try {
    const res = await fetch('/api/hr/accounts', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ fullName, email, password, role, scopes: hrWizardScopes, hrPermissions: Array.from(hrWizardPermissions) })
    });
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error(data.error || 'Unable to create account');
    hrTeamState.unshift({ ...data.user, admin_scopes: data.user.admin_scopes || [], hr_permissions: data.user.hr_permissions || [], scope_locked: !!data.user.scope_locked });
    renderHrTeam();
    hrWizardStatusEl().textContent = 'Account created and visible in admin dashboard.';
    toastSuccess('HR account created');
    hrWizardScopes = [...(defaultHrScopes || [])];
    hrWizardPermissions = new Set(['hr_applications', 'hr_pipeline', 'hr_jobs', 'hr_messages']);
    document.getElementById('hrFullName').value = '';
    document.getElementById('hrEmail').value = '';
    document.getElementById('hrPassword').value = '';
    document.querySelector('input[name="hrRole"][value="hr"]').checked = true;
    renderHrScopeChips();
    renderHrPermissionChecklist();
    setHrWizardStage(1);
  } catch (err) {
    console.error(err);
    hrWizardStatusEl().textContent = err.message;
    toastError(err.message);
  }
}

function canEditMember(member) {
  const actorRank = hrRoleRankings[myHrRole] || 0;
  const targetRank = hrRoleRankings[member.role] || 0;
  return actorRank > targetRank && actorRank >= 2;
}

function renderHrTeam() {
  const list = document.getElementById('hrTeamList');
  const badge = document.getElementById('hrTeamCountBadge');
  if (!list) return;
  list.innerHTML = '';
  if (badge) badge.textContent = `Current HR accounts: ${hrTeamState.length}`;
  if (!hrTeamState.length) {
    list.innerHTML = '<div class="empty-state" style="padding:20px;"><div class="empty-state-icon">🧭</div><h3>No HR teammates yet</h3><p>Launch a new HR account to populate the org snapshot.</p></div>';
    return;
  }
  hrTeamState.forEach((member, idx) => {
    const row = document.createElement('div');
    row.className = 'hr-team-row';
    if (idx === 0) row.classList.add('highlight');
    const roleClass = member.role === 'global_hr' ? 'global-hr' : (member.role === 'super_hr' ? 'super-hr' : '');
    const scopes = member.admin_scopes || [];
    const editable = canEditMember(member);
    const locked = !!member.scope_locked;
    row.innerHTML = `
      <div class="row-head">
        <div class="name">${escapeHtml(member.full_name || member.email)}</div>
        <div class="role-pill ${roleClass}">${escapeHtml(hrRoleLabels[member.role] || member.role)}</div>
      </div>
      <div class="meta">${escapeHtml(member.email)} · Joined ${new Date(member.created_at || Date.now()).toLocaleDateString()}</div>
      <div class="hr-scope-cloud">${scopes.length ? scopes.map(s => `<div class="hr-scope-chip">${escapeHtml(s)}</div>`).join('') : '<span style="color:#6b7280; font-weight:700;">No scopes yet</span>'}</div>
      <div style="margin:6px 0; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">${locked ? '<span class="hr-role-chip" style="background:#0f172a; color:white;">Scope edits locked</span>' : ''}${editable && isGlobalHr ? `<button class="hr-btn hr-btn-secondary" type="button" onclick="toggleScopeLock(${member.id}, ${locked ? 'false' : 'true'})">${locked ? 'Unlock scopes' : 'Lock scopes'}</button>` : ''}</div>
      ${editable && !(locked && !isGlobalHr) ? `<div class="hr-scope-input"><input data-scope-input="${member.id}" type="text" placeholder="Add scope for ${escapeHtml(member.full_name || 'this HR')}"><button class="hr-btn hr-btn-primary" type="button" onclick="addScopeToMember(${member.id})">Add scope</button></div>` : '<div style="margin-top:6px; color:#9ca3af; font-weight:600;">' + (locked && !isGlobalHr ? 'Scopes are locked by Global HR.' : 'Scopes managed by a higher tier HR.') + '</div>'}
      <div style="margin-top:12px;">
        <div style="font-weight:800; color:#111827; margin-bottom:6px;">HR Role</div>
        <div class="hr-scope-cloud">${(member.hr_permissions || []).length ? member.hr_permissions.map(p => `<div class=\"hr-scope-chip\">${escapeHtml((hrPermissionDefinitions.find(d => d.key === p) || {}).label || p)}</div>`).join('') : '<span style=\"color:#6b7280; font-weight:700;\">No permissions assigned</span>'}</div>
        ${editable ? `<div class=\"hr-scope-cloud\" style=\"margin-top:8px; gap:8px;\">${hrPermissionDefinitions.map(def => {
            const checked = (member.hr_permissions || []).includes(def.key);
            return `<label class=\\"job-chip\\" style=\\"display:flex; align-items:center; gap:6px;\\"><input type=\\"checkbox\\" data-hr-perm=\\"${member.id}__${def.key}\\" ${checked ? 'checked' : ''} onchange=\\"updateMemberPermissions(${member.id})\\"> ${escapeHtml(def.label)}</label>`;
        }).join('')} </div>` : ''}
      </div>
    `;
    list.appendChild(row);
  });
}

async function addScopeToMember(id) {
  const input = document.querySelector(`[data-scope-input="${id}"]`);
  if (!input) return;
  const val = (input.value || '').trim();
  if (!val) return;
  const member = hrTeamState.find(m => m.id === id);
  if (!member || !canEditMember(member)) return;
  if (member.scope_locked && !isGlobalHr) {
    toastError('Scopes are locked by Global HR');
    return;
  }
  const nextScopes = Array.from(new Set([...(member.admin_scopes || []), val]));
  try {
    const res = await fetch(`/api/hr/accounts/${id}/scopes`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ scopes: nextScopes, lock: member.scope_locked })
    });
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error(data.error || 'Unable to update scopes');
    member.admin_scopes = data.scopes || [];
    member.scope_locked = data.locked ?? member.scope_locked;
    input.value = '';
    renderHrTeam();
    toastSuccess('Scopes updated');
  } catch (err) {
    console.error(err);
    toastError(err.message);
  }
}

async function toggleScopeLock(id, lock) {
  const member = hrTeamState.find(m => m.id === id);
  if (!member || !canEditMember(member) || !isGlobalHr) return;
  try {
    const res = await fetch(`/api/hr/accounts/${id}/scopes`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ scopes: member.admin_scopes || [], lock })
    });
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error(data.error || 'Unable to update lock');
    member.scope_locked = data.locked ?? lock;
    renderHrTeam();
    toastSuccess(lock ? 'Scopes locked' : 'Scopes unlocked');
  } catch (err) {
    console.error(err);
    toastError(err.message);
  }
}

async function updateMemberPermissions(id) {
  const member = hrTeamState.find(m => m.id === id);
  if (!member || !canEditMember(member)) return;
  const checkboxes = Array.from(document.querySelectorAll(`[data-hr-perm^="${id}__"]`));
  const nextPerms = checkboxes.filter(cb => cb.checked).map(cb => cb.dataset.hrPerm.split('__')[1]);
  try {
    const res = await fetch(`/api/hr/accounts/${id}/permissions`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ hrPermissions: nextPerms })
    });
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error(data.error || 'Unable to update permissions');
    member.hr_permissions = data.hrPermissions || [];
    renderHrTeam();
    toastSuccess('HR permissions updated');
  } catch (err) {
    console.error(err);
    toastError(err.message);
  }
}

async function refreshHrTeam() {
  try {
    const res = await fetch('/api/hr/team');
    const data = await res.json();
    if (res.ok && data.success) {
      hrTeamState = (data.team || []).map(m => ({ ...m, admin_scopes: m.admin_scopes || [], hr_permissions: m.hr_permissions || [], scope_locked: !!m.scope_locked }));
      renderHrTeam();
    }
  } catch (e) { console.warn('HR team refresh failed', e); }
}

