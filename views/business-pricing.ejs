</style>

<script>
// Tiers data sanitized for client-side usage
const tiersData = JSON.parse('<%= JSON.stringify(tiers).replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/</g, "\\u003c").replace(/>/g, "\\u003e") %>');
let isEditMode = false;
let currentEditTierId = null;

// Toggle tier dropdown menu
function toggleTierMenu(tierId) {
    // Close all other menus
    document.querySelectorAll('.tier-dropdown').forEach(menu => {
        if (menu.id !== `menu-${tierId}`) {
            menu.classList.remove('active');
        }
    });
    
    const menu = document.getElementById(`menu-${tierId}`);
    menu.classList.toggle('active');
}

// Close menus when clicking outside
document.addEventListener('click', (e) => {
    if (!e.target.closest('.tier-actions-menu')) {
        document.querySelectorAll('.tier-dropdown').forEach(menu => {
            menu.classList.remove('active');
        });
    }
});

// Open Add Tier Modal
function openAddTierModal() {
    isEditMode = false;
    currentEditTierId = null;
    document.getElementById('modalTitle').textContent = 'Add New Tier';
    document.getElementById('tierForm').reset();
    document.getElementById('tierId').disabled = false;
    document.getElementById('featuresContainer').innerHTML = '';
    addFeatureInput(); // Add one empty feature input
    document.getElementById('tierIsActive').checked = true;
    document.getElementById('tierModal').classList.add('active');
}

// Edit Tier
function editTier(tierId) {
    const tier = tiersData.find(t => t.tier_id === tierId);
    if (!tier) return;
    
    isEditMode = true;
    currentEditTierId = tierId;
    document.getElementById('modalTitle').textContent = 'Edit Tier';
    document.getElementById('editTierId').value = tierId;
    document.getElementById('tierId').value = tierId;
    document.getElementById('tierId').disabled = true;
    document.getElementById('tierName').value = tier.name;
    document.getElementById('tierPrice').value = tier.price;
    document.getElementById('tierPriceDisplay').value = tier.price_display;
    document.getElementById('tierTagline').value = tier.tagline || '';
    document.getElementById('tierDisplayOrder').value = tier.display_order || 0;
    document.getElementById('tierIsHighlighted').checked = tier.is_highlighted;
    document.getElementById('tierIsActive').checked = tier.is_active;
    document.getElementById('tierNote').value = tier.note || '';
    
    // Populate features
    const container = document.getElementById('featuresContainer');
    container.innerHTML = '';
    if (tier.features && tier.features.length > 0) {
        tier.features.forEach(feature => addFeatureInput(feature));
    } else {
        addFeatureInput();
    }
    
    document.getElementById('tierModal').classList.add('active');
}

// Close modal
function closeTierModal() {
    document.getElementById('tierModal').classList.remove('active');
}

// Add feature input
function addFeatureInput(value = '') {
    const container = document.getElementById('featuresContainer');
    const row = document.createElement('div');
    row.className = 'feature-input-row';
    row.innerHTML = `
        <input type="text" class="feature-input" value="${escapeHtml(value)}" placeholder="Enter a feature...">
        <button type="button" class="remove-feature-btn" onclick="this.parentElement.remove()">×</button>
    `;
    container.appendChild(row);
}

// Collect features from form
function collectFeatures() {
    const inputs = document.querySelectorAll('.feature-input');
    const features = [];
    inputs.forEach(input => {
        const value = input.value.trim();
        if (value) features.push(value);
    });
    return features;
}

// Handle form submission
document.getElementById('tierForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const features = collectFeatures();
    if (features.length === 0) {
        alert('Please add at least one feature');
        return;
    }
    
    const formData = {
        tierId: document.getElementById('tierId').value,
        name: document.getElementById('tierName').value,
        price: parseFloat(document.getElementById('tierPrice').value),
        priceDisplay: document.getElementById('tierPriceDisplay').value,
        tagline: document.getElementById('tierTagline').value,
        features: features,
        displayOrder: parseInt(document.getElementById('tierDisplayOrder').value) || 0,
        isHighlighted: document.getElementById('tierIsHighlighted').checked,
        isActive: document.getElementById('tierIsActive').checked,
        note: document.getElementById('tierNote').value
    };
    
    try {
        const url = isEditMode 
            ? `/api/business/pricing/${currentEditTierId}`
            : '/api/business/pricing';
        
        const res = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
        });
        
        const data = await res.json();
        
        if (res.ok && data.success) {
            closeTierModal();
            window.location.reload();
        } else {
            alert(data.error || 'Failed to save tier');
        }
    } catch (error) {
        console.error('Save tier error:', error);
        alert('Error saving tier');
    }
});

// Toggle tier status
async function toggleTierStatus(tierId, currentStatus) {
    if (!confirm(`Are you sure you want to ${currentStatus ? 'deactivate' : 'activate'} this tier?`)) {
        return;
    }
    
    try {
        const res = await fetch(`/api/business/pricing/${tierId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ isActive: !currentStatus })
        });
        
        if (res.ok) {
            window.location.reload();
        } else {
            alert('Failed to update tier status');
        }
    } catch (error) {
        alert('Error updating tier');
    }
}

// Toggle highlight
async function toggleHighlight(tierId, currentHighlight) {
    try {
        const res = await fetch(`/api/business/pricing/${tierId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ isHighlighted: !currentHighlight })
        });
        
        if (res.ok) {
            window.location.reload();
        } else {
            alert('Failed to update tier');
        }
    } catch (error) {
        alert('Error updating tier');
    }
}

// Delete tier
async function deleteTier(tierId) {
    if (!confirm(`Are you sure you want to delete this tier? This cannot be undone.`)) {
        return;
    }
    
    try {
        const res = await fetch(`/api/business/pricing/${tierId}`, {
            method: 'DELETE'
        });
        
        if (res.ok) {
            window.location.reload();
        } else {
            alert('Failed to delete tier');
        }
    } catch (error) {
        alert('Error deleting tier');
    }
}

// Escape HTML
function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// Close modal on Escape
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
        closeTierModal();
    }
});
</script>

