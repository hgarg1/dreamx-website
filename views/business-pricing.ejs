<%- include('partials/header') %>

<section class="business-page">
    <div class="page-header">
        <div class="page-header-content">
            <div class="breadcrumb">
                <a href="/business">Dashboard</a>
                <span class="separator">→</span>
                <span class="current">Pricing Management</span>
            </div>
            <div class="header-row">
                <div>
                    <h1 class="page-title">
                        <span class="title-icon">💰</span>
                        Pricing Management
                    </h1>
                    <p class="page-subtitle">Manage subscription tiers, pricing, and features for all account types.</p>
                </div>
                <button onclick="openAddTierModal()" class="add-btn">
                    <span class="btn-icon">➕</span> Add New Tier
                </button>
            </div>
        </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="pricing-container">
        <div class="pricing-info-banner">
            <div class="info-icon">ℹ️</div>
            <div class="info-text">
                <strong>Important:</strong> Changes to pricing tiers will be reflected immediately on the public pricing page and billing pages. 
                Existing subscribers will retain their current rates until their subscription renews.
            </div>
        </div>

        <div class="tiers-grid">
            <% if (tiers && tiers.length > 0) { %>
                <% tiers.forEach(function(tier) { %>
                <div class="tier-card <%= !tier.is_active ? 'inactive' : '' %> <%= tier.is_highlighted ? 'highlighted' : '' %>">
                    <div class="tier-header">
                        <div class="tier-status">
                            <% if (!tier.is_active) { %>
                            <span class="status-badge inactive">Inactive</span>
                            <% } %>
                            <% if (tier.is_highlighted) { %>
                            <span class="status-badge featured">⭐ Featured</span>
                            <% } %>
                        </div>
                        <div class="tier-actions-menu">
                            <button class="tier-menu-btn" onclick="toggleTierMenu('<%= tier.tier_id %>')">⋮</button>
                            <div class="tier-dropdown" id="menu-<%= tier.tier_id %>">
                                <button onclick="editTier('<%= tier.tier_id %>')">✏️ Edit</button>
                                <button onclick="toggleTierStatus('<%= tier.tier_id %>', <%= tier.is_active %>)">
                                    <%= tier.is_active ? '🔒 Deactivate' : '✅ Activate' %>
                                </button>
                                <button onclick="toggleHighlight('<%= tier.tier_id %>', <%= tier.is_highlighted %>)">
                                    <%= tier.is_highlighted ? '⭐ Remove Feature' : '⭐ Feature Tier' %>
                                </button>
                                <button class="danger" onclick="deleteTier('<%= tier.tier_id %>')">🗑️ Delete</button>
                            </div>
                        </div>
                    </div>
                    
                    <div class="tier-main">
                        <h3 class="tier-name"><%= tier.name %></h3>
                        <div class="tier-price"><%= tier.price_display %></div>
                        <p class="tier-tagline"><%= tier.tagline %></p>
                    </div>
                    
                    <div class="tier-features">
                        <h4>Features (<%= tier.features.length %>)</h4>
                        <ul>
                            <% tier.features.slice(0, 4).forEach(function(feature) { %>
                            <li><%= feature %></li>
                            <% }); %>
                            <% if (tier.features.length > 4) { %>
                            <li class="more-features">+<%= tier.features.length - 4 %> more features...</li>
                            <% } %>
                        </ul>
                    </div>
                    
                    <% if (tier.note) { %>
                    <div class="tier-note"><%= tier.note %></div>
                    <% } %>
                    
                    <div class="tier-meta">
                        <span class="meta-item">ID: <code><%= tier.tier_id %></code></span>
                        <span class="meta-item">Order: <%= tier.display_order %></span>
                    </div>
                    
                    <button onclick="editTier('<%= tier.tier_id %>')" class="edit-btn">Edit Tier</button>
                </div>
                <% }); %>
            <% } else { %>
            <div class="empty-state">
                <div class="empty-icon">💰</div>
                <h3>No Pricing Tiers</h3>
                <p>Create your first pricing tier to get started.</p>
                <button onclick="openAddTierModal()" class="add-first-btn">+ Add First Tier</button>
            </div>
            <% } %>
        </div>
    </div>
</section>

<!-- Add/Edit Tier Modal -->
<div id="tierModal" class="modal">
    <div class="modal-overlay" onclick="closeTierModal()"></div>
    <div class="modal-content large">
        <div class="modal-header">
            <h2 id="modalTitle">Add New Tier</h2>
            <button onclick="closeTierModal()" class="modal-close">&times;</button>
        </div>
        <form id="tierForm" class="modal-form">
            <input type="hidden" id="editTierId" name="originalTierId">
            
            <div class="form-row">
                <div class="form-group">
                    <label>Tier ID <span class="required">*</span></label>
                    <input type="text" id="tierId" name="tierId" required placeholder="e.g., pro-seller" pattern="[a-z0-9-]+" title="Lowercase letters, numbers, and hyphens only">
                    <span class="form-help">Unique identifier. Cannot be changed later.</span>
                </div>
                <div class="form-group">
                    <label>Display Name <span class="required">*</span></label>
                    <input type="text" id="tierName" name="name" required placeholder="e.g., Pro Seller">
                </div>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label>Price (USD) <span class="required">*</span></label>
                    <input type="number" id="tierPrice" name="price" required min="0" step="0.01" placeholder="9.99">
                </div>
                <div class="form-group">
                    <label>Price Display <span class="required">*</span></label>
                    <input type="text" id="tierPriceDisplay" name="priceDisplay" required placeholder="$9.99/mo">
                    <span class="form-help">How the price appears on the page</span>
                </div>
            </div>
            
            <div class="form-group">
                <label>Tagline</label>
                <input type="text" id="tierTagline" name="tagline" placeholder="A short description of this tier">
            </div>
            
            <div class="form-group">
                <label>Features <span class="required">*</span></label>
                <div id="featuresContainer" class="features-editor">
                    <!-- Features will be added here dynamically -->
                </div>
                <button type="button" onclick="addFeatureInput()" class="add-feature-btn">+ Add Feature</button>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label>Display Order</label>
                    <input type="number" id="tierDisplayOrder" name="displayOrder" min="0" placeholder="1">
                    <span class="form-help">Lower numbers appear first</span>
                </div>
                <div class="form-group checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="tierIsHighlighted" name="isHighlighted">
                        <span class="checkbox-custom"></span>
                        Feature this tier (highlight on pricing page)
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" id="tierIsActive" name="isActive" checked>
                        <span class="checkbox-custom"></span>
                        Active (visible on pricing page)
                    </label>
                </div>
            </div>
            
            <div class="form-group">
                <label>Note (optional)</label>
                <input type="text" id="tierNote" name="note" placeholder="Additional information displayed below features">
            </div>
            
            <div class="modal-actions">
                <button type="button" onclick="closeTierModal()" class="cancel-btn">Cancel</button>
                <button type="submit" class="submit-btn" id="submitTierBtn">Save Tier</button>
            </div>
        </form>
    </div>
</div>

<style>
