<%- include('../partials/header') %>

<style>
    .rbac-page { max-width: 1400px; margin: 0 auto; padding: 20px; }
    .rbac-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 15px; }
    .rbac-header h1 { color: #333; margin: 0; }
    .rbac-nav { display: flex; gap: 10px; flex-wrap: wrap; }
    .rbac-nav a { padding: 8px 16px; background: #f5f5f5; border-radius: 6px; color: #333; text-decoration: none; font-size: 14px; transition: all 0.2s; }
    .rbac-nav a:hover, .rbac-nav a.active { background: #6366f1; color: white; }
    .panel { background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-bottom: 20px; }
    .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid #eee; }
    .panel-header h2 { margin: 0; font-size: 18px; color: #333; }
    .search-bar { display: flex; gap: 10px; margin-bottom: 20px; }
    .search-bar input { flex: 1; padding: 10px 15px; border: 1px solid #ddd; border-radius: 8px; font-size: 14px; }
    .search-bar button { padding: 10px 20px; background: #6366f1; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; }
    .search-bar button:hover { background: #4f46e5; }
    .btn { padding: 8px 16px; border-radius: 6px; font-size: 14px; cursor: pointer; border: none; text-decoration: none; display: inline-block; }
    .btn-primary { background: #6366f1; color: white; }
    .btn-primary:hover { background: #4f46e5; }
    .btn-secondary { background: #e5e7eb; color: #333; }
    .btn-danger { background: #ef4444; color: white; }
    .roles-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
    .role-card { background: #f9fafb; border-radius: 12px; padding: 20px; transition: all 0.2s; }
    .role-card:hover { background: #f3f4f6; }
    .role-card h3 { margin: 0 0 10px 0; font-size: 16px; color: #333; display: flex; align-items: center; gap: 8px; }
    .role-card h3 .badge { font-size: 10px; padding: 2px 6px; background: #6366f1; color: white; border-radius: 4px; }
    .role-card .description { color: #666; font-size: 14px; margin-bottom: 15px; }
    .role-card .meta { display: flex; gap: 15px; font-size: 13px; color: #888; margin-bottom: 15px; }
    .role-card .permissions-count { display: flex; align-items: center; gap: 5px; }
    .role-card .actions { display: flex; gap: 8px; }
    .role-tree-container { padding: 20px; background: #f9fafb; border-radius: 8px; font-family: monospace; }
    .role-tree-node { padding: 8px 12px; margin: 4px 0; background: white; border-radius: 6px; display: inline-block; }
    .role-tree-node.system { background: #e8f4ff; color: #0066cc; }
    .role-tree-children { margin-left: 30px; border-left: 2px solid #ddd; padding-left: 15px; }
    .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; }
    .modal.active { display: flex; align-items: center; justify-content: center; }
    .modal-content { background: white; padding: 30px; border-radius: 16px; max-width: 500px; width: 100%; max-height: 80vh; overflow-y: auto; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .modal-header h2 { margin: 0; }
    .modal-close { background: none; border: none; font-size: 24px; cursor: pointer; color: #666; }
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; margin-bottom: 5px; font-weight: 500; font-size: 14px; }
    .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px; }
    .checkbox-group { display: flex; flex-wrap: wrap; gap: 10px; }
    .checkbox-item { display: flex; align-items: center; gap: 6px; padding: 6px 10px; background: #f5f5f5; border-radius: 4px; font-size: 13px; }
    .checkbox-item input { margin: 0; }
    .filters { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
    .filters label { display: flex; align-items: center; gap: 5px; font-size: 13px; color: #666; }
    .empty-state { text-align: center; padding: 40px; color: #888; }
    .empty-state .icon { font-size: 48px; margin-bottom: 15px; }
</style>
  
  <main class="rbac-page">
    <div class="rbac-header">
      <h1>👥 Role Management</h1>
      <nav class="rbac-nav">
        <a href="/rbac/dashboard">Dashboard</a>
        <a href="/rbac/roles" class="active">Roles</a>
        <a href="/rbac/permissions">Permissions</a>
        <a href="/rbac/users">Users</a>
        <a href="/rbac/overrides">Overrides</a>
        <a href="/rbac/audit">Audit Logs</a>
      </nav>
    </div>
    
    <div class="panel">
      <div class="panel-header">
        <h2>All Roles (<%= roles.length %>)</h2>
        <% if (canManage) { %>
        <button class="btn btn-primary" onclick="openModal('createRole')">+ Create Role</button>
        <% } %>
      </div>
      
      <form method="get" class="search-bar">
        <input type="text" name="search" placeholder="Search roles..." value="<%= filters.search || '' %>">
        <button type="submit">Search</button>
      </form>
      
      <div class="filters">
        <label>
          <input type="checkbox" name="includeDisabled" <%= filters.includeDisabled ? 'checked' : '' %> onchange="this.form.submit()">
          Show disabled
        </label>
        <label>
          <input type="checkbox" name="includeDeleted" <%= filters.includeDeleted ? 'checked' : '' %> onchange="this.form.submit()">
          Show deleted
        </label>
      </div>
      
      <% if (roles && roles.length > 0) { %>
      <div class="roles-grid">
        <% roles.forEach(role => { %>
        <div class="role-card">
          <h3>
            <%= role.display_name || role.name %>
            <% if (role.is_system_role) { %><span class="badge">System</span><% } %>
            <% if (!role.is_enabled) { %><span class="badge" style="background:#888">Disabled</span><% } %>
          </h3>
          <div class="description"><%= role.description || 'No description' %></div>
          <div class="meta">
            <span>Priority: <%= role.priority %></span>
            <% if (role.parent_role_name) { %>
            <span>Inherits: <%= role.parent_role_name %></span>
            <% } %>
          </div>
          <div class="actions">
            <a href="/rbac/roles/<%= role.id %>" class="btn btn-secondary">View Details</a>
            <% if (canManage && !role.is_system_role) { %>
            <button class="btn btn-secondary" onclick="editRole(<%= role.id %>)">Edit</button>
            <% } %>
          </div>
        </div>
        <% }) %>
      </div>
      <% } else { %>
      <div class="empty-state">
        <div class="icon">👥</div>
        <p>No roles found</p>
      </div>
      <% } %>
    </div>
    
    <!-- Role Hierarchy Visualization -->
    <div class="panel">
      <div class="panel-header">
        <h2>🌳 Role Hierarchy</h2>
      </div>
      <div class="role-tree-container">
        <% function renderTree(nodes, depth = 0) { %>
          <% nodes.forEach(node => { %>
            <div style="margin-left: <%= depth * 30 %>px;">
              <span class="role-tree-node <%= node.is_system_role ? 'system' : '' %>">
                <%= depth > 0 ? '└── ' : '' %><%= node.display_name || node.name %>
                <span style="opacity: 0.6; font-size: 11px;">(P<%= node.priority %>)</span>
              </span>
              <% if (node.children && node.children.length > 0) { %>
                <% renderTree(node.children, depth + 1) %>
              <% } %>
            </div>
          <% }) %>
        <% } %>
        <% renderTree(roleTree) %>
      </div>
    </div>
  </main>
  
  <!-- Create Role Modal -->
  <div id="createRoleModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Create New Role</h2>
        <button class="modal-close" onclick="closeModal('createRole')">&times;</button>
      </div>
      <form action="/api/rbac/roles" method="POST" id="createRoleForm">
        <div class="form-group">
          <label>Role Name *</label>
          <input type="text" name="name" required placeholder="e.g., content_moderator">
        </div>
        <div class="form-group">
          <label>Display Name</label>
          <input type="text" name="displayName" placeholder="e.g., Content Moderator">
        </div>
        <div class="form-group">
          <label>Description</label>
          <textarea name="description" rows="3" placeholder="Describe this role's purpose..."></textarea>
        </div>
        <div class="form-group">
          <label>Priority</label>
          <input type="number" name="priority" value="10" min="0" max="100">
        </div>
        <div class="form-group">
          <label>Parent Role (Inherits Permissions)</label>
          <select name="parentRoleId">
            <option value="">None</option>
            <% roles.filter(r => r.is_enabled).forEach(r => { %>
            <option value="<%= r.id %>"><%= r.display_name || r.name %></option>
            <% }) %>
          </select>
        </div>
        <div style="display: flex; gap: 10px; margin-top: 20px;">
          <button type="submit" class="btn btn-primary">Create Role</button>
          <button type="button" class="btn btn-secondary" onclick="closeModal('createRole')">Cancel</button>
        </div>
      </form>
    </div>
  </div>
  
  <%- include('../partials/footer') %>
  
  <script>
    function openModal(id) {
      document.getElementById(id + 'Modal').classList.add('active');
    }
    function closeModal(id) {
      document.getElementById(id + 'Modal').classList.remove('active');
    }
    
    document.getElementById('createRoleForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      const formData = new FormData(this);
      const data = Object.fromEntries(formData.entries());
      
      try {
        const res = await fetch('/api/rbac/roles', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success || result.id) {
          window.location.reload();
        } else {
          alert(result.error || 'Failed to create role');
        }
      } catch (err) {
        alert('Error creating role');
      }
    });
    
    function editRole(roleId) {
      window.location.href = '/rbac/roles/' + roleId + '#edit';
    }
  </script>
</body>
</html>

