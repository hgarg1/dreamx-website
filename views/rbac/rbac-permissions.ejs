<%- include('../partials/header') %>

<style>
    .rbac-page { max-width: 1400px; margin: 0 auto; padding: 20px; }
    .rbac-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 15px; }
    .rbac-header h1 { color: #333; margin: 0; }
    .rbac-nav { display: flex; gap: 10px; flex-wrap: wrap; }
    .rbac-nav a { padding: 8px 16px; background: #f5f5f5; border-radius: 6px; color: #333; text-decoration: none; font-size: 14px; }
    .rbac-nav a:hover, .rbac-nav a.active { background: #6366f1; color: white; }
    .panel { background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-bottom: 20px; }
    .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid #eee; }
    .panel-header h2 { margin: 0; font-size: 18px; color: #333; }
    .sidebar-layout { display: grid; grid-template-columns: 250px 1fr; gap: 20px; }
    @media (max-width: 900px) { .sidebar-layout { grid-template-columns: 1fr; } }
    .sidebar { background: white; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); height: fit-content; }
    .sidebar h3 { margin: 0 0 15px 0; font-size: 14px; color: #666; text-transform: uppercase; }
    .sidebar ul { list-style: none; padding: 0; margin: 0; }
    .sidebar li a { display: block; padding: 10px 12px; color: #333; text-decoration: none; border-radius: 6px; margin-bottom: 5px; }
    .sidebar li a:hover, .sidebar li a.active { background: #f3f4f6; }
    .sidebar li a .count { float: right; background: #e5e7eb; padding: 2px 8px; border-radius: 10px; font-size: 12px; }
    .search-bar { display: flex; gap: 10px; margin-bottom: 20px; }
    .search-bar input { flex: 1; padding: 10px 15px; border: 1px solid #ddd; border-radius: 8px; }
    .search-bar button { padding: 10px 20px; background: #6366f1; color: white; border: none; border-radius: 8px; cursor: pointer; }
    .permissions-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 15px; }
    .permission-card { background: #f9fafb; border-radius: 8px; padding: 15px; transition: all 0.2s; }
    .permission-card:hover { background: #f3f4f6; }
    .permission-card h4 { margin: 0 0 5px 0; font-size: 14px; font-family: monospace; color: #333; }
    .permission-card .display-name { font-size: 13px; color: #666; margin-bottom: 10px; }
    .permission-card .meta { display: flex; gap: 10px; font-size: 12px; color: #888; }
    .permission-card .meta span { display: flex; align-items: center; gap: 4px; }
    .badge { display: inline-block; padding: 2px 6px; border-radius: 4px; font-size: 10px; }
    .badge-module { background: #e8f4ff; color: #0066cc; }
    .badge-resource { background: #fef3c7; color: #d97706; }
    .badge-action { background: #d1fae5; color: #059669; }
    .btn { padding: 6px 12px; border-radius: 6px; font-size: 13px; cursor: pointer; border: none; text-decoration: none; }
    .btn-primary { background: #6366f1; color: white; }
    .btn-secondary { background: #e5e7eb; color: #333; }
    .empty-state { text-align: center; padding: 40px; color: #888; }
    .filters { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
    .filters label { display: flex; align-items: center; gap: 5px; font-size: 13px; }
  </style>
  
  <main class="rbac-page">
    <div class="rbac-header">
      <h1>🔑 Permission Management</h1>
      <nav class="rbac-nav">
        <a href="/rbac/dashboard">Dashboard</a>
        <a href="/rbac/roles">Roles</a>
        <a href="/rbac/permissions" class="active">Permissions</a>
        <a href="/rbac/users">Users</a>
        <a href="/rbac/compare">Compare</a>
        <a href="/rbac/cleanup">Cleanup</a>
        <a href="/rbac/overrides">Overrides</a>
        <a href="/rbac/audit">Audit Logs</a>
      </nav>
    </div>
    
    <div class="sidebar-layout">
      <!-- Groups Sidebar -->
      <div class="sidebar">
        <h3>Permission Groups</h3>
        <ul>
          <li><a href="/rbac/permissions" class="<%= !filters.groupId ? 'active' : '' %>">All Permissions <span class="count"><%= permissions.length %></span></a></li>
          <% groups.forEach(group => { %>
          <li>
            <a href="/rbac/permissions?groupId=<%= group.id %>" class="<%= filters.groupId == group.id ? 'active' : '' %>">
              <%= group.display_name || group.name %>
              <span class="count"><%= group.permission_count || 0 %></span>
            </a>
          </li>
          <% }) %>
        </ul>
        
        <h3 style="margin-top: 20px;">Modules</h3>
        <ul>
          <% modules.forEach(mod => { %>
          <li>
            <a href="/rbac/permissions?module=<%= encodeURIComponent(mod) %>" class="<%= filters.module === mod ? 'active' : '' %>">
              <%= mod %>
            </a>
          </li>
          <% }) %>
        </ul>
      </div>
      
      <!-- Permissions Content -->
      <div>
        <div class="panel">
          <div class="panel-header">
            <h2>Permissions (<%= permissions.length %>)</h2>
            <% if (canManage) { %>
            <button class="btn btn-primary" onclick="openCreateModal()">+ Create Permission</button>
            <% } %>
          </div>
          
          <form method="get" class="search-bar">
            <input type="hidden" name="groupId" value="<%= filters.groupId || '' %>">
            <input type="hidden" name="module" value="<%= filters.module || '' %>">
            <input type="text" name="search" placeholder="Search permissions..." value="<%= filters.search || '' %>">
            <button type="submit">Search</button>
          </form>
          
          <div class="filters">
            <label>
              <input type="checkbox" name="includeDisabled" <%= filters.includeDisabled ? 'checked' : '' %> onchange="this.form.submit()">
              Show disabled
            </label>
          </div>
          
          <% if (permissions && permissions.length > 0) { %>
          <div class="permissions-grid">
            <% permissions.forEach(perm => { %>
            <div class="permission-card">
              <h4><%= perm.name %></h4>
              <div class="display-name"><%= perm.display_name || 'No display name' %></div>
              <div class="meta">
                <% if (perm.module) { %>
                <span><span class="badge badge-module"><%= perm.module %></span></span>
                <% } %>
                <% if (perm.resource) { %>
                <span><span class="badge badge-resource"><%= perm.resource %></span></span>
                <% } %>
                <% if (perm.action) { %>
                <span><span class="badge badge-action"><%= perm.action %></span></span>
                <% } %>
              </div>
            </div>
            <% }) %>
          </div>
          <% } else { %>
          <div class="empty-state">
            <p>No permissions found</p>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>
  
  <!-- Create Permission Modal -->
  <div id="createPermissionModal" class="modal-overlay">
    <div class="modal-content">
      <div class="modal-header">
        <h2>🔑 Create New Permission</h2>
        <button class="modal-close" onclick="closeCreateModal()">&times;</button>
      </div>
      <form id="createPermissionForm">
        <div class="form-group">
          <label for="permName">Permission Name *</label>
          <input type="text" id="permName" name="name" required placeholder="e.g., posts.create" pattern="[a-z0-9._]+" title="Lowercase letters, numbers, dots and underscores only">
          <small>Unique identifier (lowercase, dots for namespacing)</small>
        </div>
        <div class="form-group">
          <label for="permDisplayName">Display Name</label>
          <input type="text" id="permDisplayName" name="displayName" placeholder="e.g., Create Posts">
        </div>
        <div class="form-group">
          <label for="permDescription">Description</label>
          <textarea id="permDescription" name="description" rows="2" placeholder="Describe what this permission allows..."></textarea>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="permModule">Module</label>
            <input type="text" id="permModule" name="module" placeholder="e.g., content" list="modulesList">
            <datalist id="modulesList">
              <% modules.forEach(mod => { %>
              <option value="<%= mod %>">
              <% }) %>
            </datalist>
          </div>
          <div class="form-group">
            <label for="permResource">Resource</label>
            <input type="text" id="permResource" name="resource" placeholder="e.g., posts">
          </div>
          <div class="form-group">
            <label for="permAction">Action</label>
            <select id="permAction" name="action">
              <option value="">Select action...</option>
              <option value="create">create</option>
              <option value="read">read</option>
              <option value="update">update</option>
              <option value="delete">delete</option>
              <option value="manage">manage</option>
              <option value="view">view</option>
              <option value="edit">edit</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="permGroup">Permission Group</label>
          <select id="permGroup" name="groupId">
            <option value="">No group</option>
            <% groups.forEach(group => { %>
            <option value="<%= group.id %>"><%= group.display_name || group.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" onclick="closeCreateModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Permission</button>
        </div>
      </form>
      <div id="createResult" class="result-message" style="display: none;"></div>
    </div>
  </div>
  
  <style>
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      z-index: 10000;
      align-items: center;
      justify-content: center;
    }
    .modal-overlay.active {
      display: flex;
    }
    .modal-content {
      background: white;
      border-radius: 16px;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);
      max-width: 550px;
      width: 95%;
      max-height: 90vh;
      overflow-y: auto;
      animation: modalSlideIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes modalSlideIn {
      from { opacity: 0; transform: scale(0.9) translateY(-20px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 24px;
      border-bottom: 1px solid #e5e7eb;
      background: linear-gradient(135deg, #6366f1, #a855f7);
      color: white;
      border-radius: 16px 16px 0 0;
    }
    .modal-header h2 { margin: 0; font-size: 1.25rem; }
    .modal-close {
      background: rgba(255,255,255,0.2);
      border: none;
      font-size: 24px;
      cursor: pointer;
      color: white;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .modal-close:hover { background: rgba(255,255,255,0.3); }
    #createPermissionForm { padding: 24px; }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; margin-bottom: 6px; font-weight: 500; color: #374151; font-size: 14px; }
    .form-group input, .form-group select, .form-group textarea {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 14px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
      outline: none;
      border-color: #6366f1;
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }
    .form-group small { display: block; margin-top: 4px; color: #6b7280; font-size: 12px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
    @media (max-width: 600px) { .form-row { grid-template-columns: 1fr; } }
    .modal-actions {
      display: flex;
      gap: 12px;
      justify-content: flex-end;
      padding-top: 16px;
      border-top: 1px solid #e5e7eb;
      margin-top: 8px;
    }
    .result-message {
      margin: 16px 24px 24px;
      padding: 12px 16px;
      border-radius: 8px;
      font-size: 14px;
    }
    .result-message.success { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
    .result-message.error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
  </style>
  
  <%- include('../partials/footer') %>
  
  <script>
    function openCreateModal() {
      document.getElementById('createPermissionModal').classList.add('active');
      document.getElementById('permName').focus();
    }
    
    function closeCreateModal() {
      document.getElementById('createPermissionModal').classList.remove('active');
      document.getElementById('createPermissionForm').reset();
      document.getElementById('createResult').style.display = 'none';
    }
    
    // Close modal when clicking outside
    document.getElementById('createPermissionModal').addEventListener('click', function(e) {
      if (e.target === this) {
        closeCreateModal();
      }
    });
    
    // Close modal with ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeCreateModal();
      }
    });
    
    // Handle form submission
    document.getElementById('createPermissionForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const formData = new FormData(this);
      const data = {};
      formData.forEach((value, key) => {
        if (value) data[key] = value;
      });
      
      const resultEl = document.getElementById('createResult');
      resultEl.style.display = 'none';
      
      try {
        const res = await fetch('/api/rbac/permissions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        
        const result = await res.json();
        
        if (result.success || result.permission) {
          resultEl.className = 'result-message success';
          resultEl.textContent = '✅ Permission created successfully!';
          resultEl.style.display = 'block';
          setTimeout(() => {
            window.location.reload();
          }, 1000);
        } else {
          resultEl.className = 'result-message error';
          resultEl.textContent = '❌ ' + (result.error || 'Failed to create permission');
          resultEl.style.display = 'block';
        }
      } catch (err) {
        resultEl.className = 'result-message error';
        resultEl.textContent = '❌ Network error: ' + err.message;
        resultEl.style.display = 'block';
      }
    });
  </script>
</body>
</html>

