<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin">
    <%- include('partials/header') %>
    <main class="admin-dashboard-container">
        <header class="admin-dashboard-header">
            <h1>Platform Overview</h1>
            <p>Operational snapshot and moderation queue.</p>
        </header>

        <!-- Metrics Grid -->
        <section class="admin-metrics-grid">
            <div class="admin-metric-card">
                <h3>Total Users</h3>
                <p class="metric-value"><%= metrics.totalUsers %></p>
                <span class="metric-sub">All registered accounts</span>
            </div>
            <div class="admin-metric-card">
                <h3>Active Today</h3>
                <p class="metric-value"><%= metrics.activeToday %></p>
                <span class="metric-sub">Unique logins</span>
            </div>
            <div class="admin-metric-card">
                <h3>Services Listed</h3>
                <p class="metric-value"><%= metrics.servicesListed %></p>
                <span class="metric-sub">Public offerings</span>
            </div>
            <div class="admin-metric-card">
                <h3>Sessions Booked</h3>
                <p class="metric-value"><%= metrics.sessionsBooked %></p>
                <span class="metric-sub">Lifetime total</span>
            </div>
        </section>

        <div class="admin-two-column">
            <!-- Recent Signups -->
            <section class="admin-panel">
                <div class="panel-head">
                    <h2>Recent Signups</h2>
                    <button class="mini-btn">Export</button>
                </div>
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentSignups.forEach(u => { %>
                            <tr>
                                <td><%= u.name %></td>
                                <td><%= u.email %></td>
                                <td><%= u.date %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </section>

            <!-- Flagged Content -->
            <section class="admin-panel">
                <div class="panel-head">
                    <h2>Flagged Content</h2>
                    <button class="mini-btn danger">Bulk Review</button>
                </div>
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Reason</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% flaggedContent.forEach(f => { %>
                            <tr>
                                <td><%= f.user %></td>
                                <td><%= f.reason %></td>
                                <td><%= f.date %></td>
                                <td><span class="status-chip <%= f.status.toLowerCase() %>"><%= f.status %></span></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </section>
        </div>

        <!-- Admin Actions -->
        <section class="admin-actions">
            <h2>Quick Actions</h2>
            <div class="actions-grid">
                <button class="action-btn coming-soon-btn" 
                    data-message="Send Broadcast Message functionality is coming soon. You'll be able to send platform-wide announcements.">
                    Send Broadcast Message
                </button>
                <button class="action-btn coming-soon-btn" 
                    data-message="Force Password Reset functionality is coming soon. You'll be able to require users to reset their passwords.">
                    Force Password Reset
                </button>
                <button class="action-btn coming-soon-btn" 
                    data-message="Maintenance Mode functionality is coming soon. You'll be able to enable/disable platform maintenance.">
                    Enable Maintenance Mode
                </button>
                <button class="action-btn danger coming-soon-btn" 
                    data-message="User Suspension functionality is coming soon. You'll be able to temporarily suspend user accounts.">
                    Suspend User
                </button>
            </div>
            <form class="broadcast-form" id="broadcastForm">
                <label>Broadcast Announcement</label>
                <textarea placeholder="Write announcement..." rows="4"></textarea>
                <button class="submit-announce" type="submit">Queue Announcement</button>
            </form>
        </section>
    </main>

    <!-- Coming Soon Modal -->
    <div id="comingSoonModal" class="coming-soon-modal-overlay">
        <div class="coming-soon-modal">
            <div class="coming-soon-modal-header">
                <span class="coming-soon-icon">🚧</span>
                <h3>Coming Soon!</h3>
            </div>
            <div class="coming-soon-modal-body">
                <p id="comingSoonMessage">This feature is currently under development and will be available soon.</p>
            </div>
            <div class="coming-soon-modal-footer">
                <button class="btn-got-it" onclick="closeComingSoonModal()">Got it!</button>
            </div>
        </div>
    </div>
    
    <style>
        .coming-soon-modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(4px);
            z-index: 10000;
            align-items: center;
            justify-content: center;
        }
        .coming-soon-modal-overlay.active {
            display: flex;
        }
        .coming-soon-modal {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            border: 2px solid rgba(99, 102, 241, 0.3);
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
            max-width: 400px;
            width: 90%;
            text-align: center;
            animation: modalSlideIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            overflow: hidden;
        }
        @keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: scale(0.9) translateY(-20px);
            }
            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }
        .coming-soon-modal-header {
            background: linear-gradient(135deg, #6366f1, #a855f7);
            padding: 24px;
            color: white;
        }
        .coming-soon-icon {
            font-size: 48px;
            display: block;
            margin-bottom: 8px;
        }
        .coming-soon-modal-header h3 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 700;
        }
        .coming-soon-modal-body {
            padding: 24px;
        }
        .coming-soon-modal-body p {
            margin: 0;
            color: rgba(255, 255, 255, 0.8);
            font-size: 1rem;
            line-height: 1.6;
        }
        .coming-soon-modal-footer {
            padding: 16px 24px 24px;
        }
        .btn-got-it {
            width: 100%;
            padding: 12px 24px;
            font-size: 1rem;
            font-weight: 600;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            color: white;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn-got-it:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4);
        }
    </style>
    
    <script>
        function showComingSoon(message) {
            const modal = document.getElementById('comingSoonModal');
            const messageEl = document.getElementById('comingSoonMessage');
            messageEl.textContent = message || 'This feature is currently under development and will be available soon.';
            modal.classList.add('active');
        }
        
        function closeComingSoonModal() {
            const modal = document.getElementById('comingSoonModal');
            modal.classList.remove('active');
        }
        
        // Event delegation for coming soon buttons
        document.querySelectorAll('.coming-soon-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                showComingSoon(this.dataset.message);
            });
        });
        
        // Handle broadcast form submission
        document.getElementById('broadcastForm').addEventListener('submit', function(e) {
            e.preventDefault();
            showComingSoon('Broadcast announcements are coming soon. Stay tuned!');
        });
        
        // Close modal when clicking outside
        document.getElementById('comingSoonModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeComingSoonModal();
            }
        });
        
        // Close modal with ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeComingSoonModal();
            }
        });
    </script>

    <%- include('partials/footer') %>
</body>
</html>