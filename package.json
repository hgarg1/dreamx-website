{
  "name": "dreamx-website",
  "version": "1.0.0",
  "description": "Dream X - The Social Network for Productive People",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "build": "npm install --build-from-source",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "db:migrate:chat": "node scripts/db/migrate-chat-attachments.js",
    "db:clear-reels": "node scripts/cleanup/clear-all-reels.js",
    "cleanup:uploads": "node scripts/maintenance/cleanup-uploads.js",
    "storage:upload": "node scripts/storage/upload-to-blob.js"
  },
  "keywords": [
    "dreamx",
    "social-network",
    "productivity",
    "hobbies"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bubblewrap/cli": "^1.24.1",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^10.0.0",
    "@tauri-apps/cli": "^2.9.4",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "connect-sqlite3": "^0.9.0",
    "dotenv": "^17.2.3",
    "mssql": "^11.0.1",
    "@azure/storage-blob": "^12.22.0",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-robots-txt": "^1.0.0",
    "express-session": "^1.18.2",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^166.0.0",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
