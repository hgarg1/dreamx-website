    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.10",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-google-oauth20": "^2.0.0",
    "passport-microsoft": "^2.1.0",
    "sitemap": "^8.0.2",
    "socket.io": "^4.8.1",
    "square": "^43.2.0",
    "stripe": "^19.3.1",
    "web-push": "^3.6.6"
